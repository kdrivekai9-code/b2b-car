PORT=3000
NODE_ENV=development

# Supabase 프로젝트 설정 > Database > Connection string (URI, "Session pooler" 또는 direct connection) 값을 사용하세요.
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# openssl rand -base64 32 등으로 생성한 임의의 긴 문자열을 사용하세요. 운영 환경에서는 필수입니다.
SESSION_SECRET=change-me-to-a-long-random-string

# Next.js 전환 Stage 1 플래그(화면별로 하나씩). 기본값 false = 해당 경로 요청이
# src/proxy.js에서 기존 Express 화면(/api/index)으로 그대로 리라이트된다. true로 켜면
# src/app/** 아래의 React 페이지가 응답한다. 운영에서는 스테이징 검증 전까지 절대
# true로 두지 않는다.
NEXT_STAGE1_DASHBOARD_ENABLED=false
NEXT_STAGE1_ORDERS_ENABLED=false
NEXT_STAGE1_INQUIRIES_ENABLED=false
