PORT=3000
NODE_ENV=development

# Supabase 프로젝트 설정 > Database > Connection string (URI) > **"Transaction pooler"**(포트
# 6543)를 사용하세요 — "Session pooler"(5432)는 쓰지 마세요. Vercel 서버리스는 부하가 몰리면
# 짧은 시간에 여러 함수 인스턴스가 동시에 뜨는데, Session pooler는 클라이언트당 커넥션을
# 계속 붙잡고 있어 pool_size(보통 15) 한도를 금방 넘긴다 — 실측으로 10개 동시 브라우저
# 세션에서 "EMAXCONNSESSION: max clients reached in session mode" 에러를 재현했다(2026-08-02).
# Transaction pooler는 커넥션을 트랜잭션 단위로 멀티플렉싱해서 같은 한도로 훨씬 많은 동시
# 요청을 버틴다 — 이 앱은 세션 단위 기능(LISTEN/NOTIFY, 명시적 다단계 트랜잭션, 세션 레벨
# SET 등)을 안 쓰므로 전환에 문제없음을 확인했다.
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:6543/postgres

# openssl rand -base64 32 등으로 생성한 임의의 긴 문자열을 사용하세요. 운영 환경에서는 필수입니다.
SESSION_SECRET=change-me-to-a-long-random-string

# Next.js 전환 Stage 1 플래그(화면별로 하나씩). 기본값 false = 해당 경로 요청이
# src/proxy.js에서 기존 Express 화면(/api/index)으로 그대로 리라이트된다. true로 켜면
# src/app/** 아래의 React 페이지가 응답한다. 운영에서는 스테이징 검증 전까지 절대
# true로 두지 않는다.
NEXT_STAGE1_DASHBOARD_ENABLED=false
NEXT_STAGE1_ORDERS_ENABLED=false
NEXT_STAGE1_INQUIRIES_ENABLED=false
# /chat/sessions는 이 플래그를 켜도 ?view=list일 때만 React로 간다 — 기본(카드뷰)은
# 실시간 채팅/삭제/오더등록이 얽혀있어 항상 기존 Express 화면 그대로 유지된다.
NEXT_STAGE1_CHAT_SESSIONS_ENABLED=false

# Next.js Stage 2 플래그 — 오더 생성 폼(/orders/new)만 대상, "수정" 폼은 애초에 없어서
# 범위에서 제외했다(상세페이지의 상태/기사배정/요금 3개 관리자 미니폼과는 무관).
NEXT_STAGE2_ORDER_FORM_ENABLED=false

# Next.js Stage 3 플래그 — 상담 카드뷰(/chat/sessions, view 없음 또는 ?view=card)만 대상.
# 상세페이지(session_detail.ejs)와 카드뷰의 임베드 오더등록("접수 마무리") 폼은 이번
# 슬라이스에서 제외했다 — 자세한 내용은 docs/ai-stage-3-checklist.md 참고.
NEXT_STAGE3_CHAT_CARDS_ENABLED=false
# 상담 상세페이지(/chat/sessions/:id) — 슬라이스 2. 카드뷰(위)와 독립적인 플래그로, 카드뷰의
# "상세 페이지 열기" 링크가 이 화면으로 연결된다.
NEXT_STAGE3_CHAT_DETAIL_ENABLED=false
# 카드뷰의 "접수 마무리" 탭(임베드 오더등록 폼, draft_json 자동상속) — 카드뷰 자체 플래그와
# 독립적이라 카드뷰는 켜둔 채로 이 탭만 따로 껐다 켤 수 있다.
NEXT_STAGE3_CHAT_INTAKE_ENABLED=false

# Kakao 지도/주소 API. JS_KEY는 오더 등록 화면에서 브라우저에 그대로 노출되는 값이고
# (Kakao Developers 콘솔에서 도메인 제한을 걸어 씀), REST_API_KEY는 서버 전용
# (/kakao/search, /kakao/directions에서만 사용, 절대 브라우저에 노출하지 않음).
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
# 위 KAKAO_JS_KEY와 동일한 값. Next.js는 NEXT_PUBLIC_ 접두사가 붙은 변수만 클라이언트
# 번들에 포함시키므로 별도로 필요하다 — 노출 수준은 기존과 동일(원래도 공개 값).
# KAKAO_REST_API_KEY는 절대 NEXT_PUBLIC_ 버전을 만들지 않는다(서버 전용, 유출 금지).
NEXT_PUBLIC_KAKAO_JS_KEY=
