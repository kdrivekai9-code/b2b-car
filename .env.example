PORT=3000
NODE_ENV=development

# Supabase 프로젝트 설정 > Database > Connection string (URI) > **"Transaction pooler"**(포트
# 6543)를 사용하세요 — "Session pooler"(5432)는 쓰지 마세요. Vercel 서버리스는 부하가 몰리면
# 짧은 시간에 여러 함수 인스턴스가 동시에 뜨는데, Session pooler는 클라이언트당 커넥션을
# 계속 붙잡고 있어 pool_size(보통 15) 한도를 금방 넘긴다 — 실측으로 10개 동시 브라우저
# 세션에서 "EMAXCONNSESSION: max clients reached in session mode" 에러를 재현했다(2026-08-02).
# Transaction pooler는 커넥션을 트랜잭션 단위로 멀티플렉싱해서 같은 한도로 훨씬 많은 동시
# 요청을 버틴다 — 이 앱은 세션 단위 기능(LISTEN/NOTIFY, 명시적 다단계 트랜잭션, 세션 레벨
# SET 등)을 안 쓰므로 전환에 문제없음을 확인했다.
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:6543/postgres

# openssl rand -base64 32 등으로 생성한 임의의 긴 문자열을 사용하세요. 운영 환경에서는 필수입니다.
SESSION_SECRET=change-me-to-a-long-random-string

# Next.js 전환 Stage 1 플래그(화면별로 하나씩). 기본값 false = 해당 경로 요청이
# src/proxy.js에서 기존 Express 화면(/api/index)으로 그대로 리라이트된다. true로 켜면
# src/app/** 아래의 React 페이지가 응답한다. 운영에서는 스테이징 검증 전까지 절대
# true로 두지 않는다.
NEXT_STAGE1_DASHBOARD_ENABLED=false
NEXT_STAGE1_ORDERS_ENABLED=false
NEXT_STAGE1_INQUIRIES_ENABLED=false
# /chat/sessions는 이 플래그를 켜도 ?view=list일 때만 React로 간다 — 기본(카드뷰)은
# 실시간 채팅/삭제/오더등록이 얽혀있어 항상 기존 Express 화면 그대로 유지된다.
NEXT_STAGE1_CHAT_SESSIONS_ENABLED=false

# Next.js Stage 2 플래그 — 오더 생성 폼(/orders/new)만 대상. "수정" 화면은 그 이후
# 별도 기능(NEXT_ORDER_DETAIL_EDIT_ENABLED, 아래)으로 추가됐다.
NEXT_STAGE2_ORDER_FORM_ENABLED=false

# Next.js Stage 3 플래그 — 상담 카드뷰(/chat/sessions, view 없음 또는 ?view=card)만 대상.
# 상세페이지(session_detail.ejs)와 카드뷰의 임베드 오더등록("접수 마무리") 폼은 이번
# 슬라이스에서 제외했다 — 자세한 내용은 docs/ai-stage-3-checklist.md 참고.
NEXT_STAGE3_CHAT_CARDS_ENABLED=false
# 상담 상세페이지(/chat/sessions/:id) — 슬라이스 2. 카드뷰(위)와 독립적인 플래그로, 카드뷰의
# "상세 페이지 열기" 링크가 이 화면으로 연결된다.
NEXT_STAGE3_CHAT_DETAIL_ENABLED=false
# 카드뷰의 "접수 마무리" 탭(임베드 오더등록 폼, draft_json 자동상속) — 카드뷰 자체 플래그와
# 독립적이라 카드뷰는 켜둔 채로 이 탭만 따로 껐다 켤 수 있다.
NEXT_STAGE3_CHAT_INTAKE_ENABLED=false

# Stage 1-3 워크오더 완료 이후 추가된 별도 기능 — 오더 상세페이지(/orders/:id)를
# 기존 접수폼(OrderForm.js, /orders/new와 동일 컴포넌트)의 수정 가능 화면으로 전환.
# client 역할은 계속 읽기전용, admin/branch_manager만 실제로 수정 가능. 꺼두면
# views/orders/detail.ejs(요금 미니폼 포함, 완전히 그대로 유지됨)로 즉시 롤백된다.
NEXT_ORDER_DETAIL_EDIT_ENABLED=false

# Kakao 지도/주소 API. JS_KEY는 오더 등록 화면에서 브라우저에 그대로 노출되는 값이고
# (Kakao Developers 콘솔에서 도메인 제한을 걸어 씀), REST_API_KEY는 서버 전용
# (/kakao/search, /kakao/directions에서만 사용, 절대 브라우저에 노출하지 않음).
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
# 위 KAKAO_JS_KEY와 동일한 값. Next.js는 NEXT_PUBLIC_ 접두사가 붙은 변수만 클라이언트
# 번들에 포함시키므로 별도로 필요하다 — 노출 수준은 기존과 동일(원래도 공개 값).
# KAKAO_REST_API_KEY는 절대 NEXT_PUBLIC_ 버전을 만들지 않는다(서버 전용, 유출 금지).
NEXT_PUBLIC_KAKAO_JS_KEY=

# 콜마너 외부연동(대리운전/탁송 배차사) — 실제 값은 콜마너 안내메일 참고.
# 테스트: alpha-api.cd1.kr:8443 / 운영: 수도권 api.cd1.kr:8443, 지방권 api.cd2.kr:8443
CALLMANER_BASE_URL=https://alpha-api.cd1.kr:8443
# 콜마너 암/복호화 키 — 콜마너에서 발급받아 넣는다(절대 소스에 하드코딩하지 않는다).
# 규약: Blowfish/ECB/NoPadding + 0x00 zero padding -> Base64 -> URL 인코딩, 파라미터 p.
# 요청 키와 응답 키가 다르다(서버 기준 decode_key / encode_key).
# 두 값이 모두 있으면 운영 규약대로 암호 모드로 동작하고, 없으면 평문 모드(?t=)로 동작한다.
CALLMANER_REQUEST_KEY=
CALLMANER_RESPONSE_KEY=
# 키가 있어도 평문(?t=)으로 강제하려면 plain으로 둔다(장애 시 즉시 되돌리기 위한 스위치).
# CALLMANER_ENCODING=plain
# Vercel Cron이 /callmaner/sync 호출 시 Authorization: Bearer <값>을 자동으로 붙여준다
# (Vercel 프로젝트 설정에도 동일한 값을 CRON_SECRET으로 등록해야 함). openssl rand -base64 32 등으로 생성.
CRON_SECRET=

# 콜마너 MCP 서버(배차 주문 조회/등록/수정/취소 도구) — 챗봇이 tools/call로 사용한다.
# 운영: https://mcp-n-rest-api.xmobiai.com (스웨거 /docs, 도구 카탈로그 /__ui/api/mcp-tools)
MCP_DISPATCH_BASE_URL=https://mcp-n-rest-api.xmobiai.com
# MCP 서버 발급 API 키(X-API-Key). 비어 있으면 챗봇의 배차 주문 도우미가 꺼진 상태로 동작한다
# (기존처럼 상담원 연결로 폴백). 절대 소스/커밋에 넣지 않는다.
MCP_DISPATCH_API_KEY=
# 지사에 mcp_rep_no가 없을 때 쓰는 기본 대표번호(지사 설정이 우선).
# 테스트 지사코드 B100의 대표번호는 01036462043(콜마너 지사정보 기준).
MCP_DISPATCH_DEFAULT_REP_NO=
# 배차 지연 판정/요금 인상 기준(기본 5분, 5,000원)
MCP_DISPATCH_DELAY_MINUTES=5
MCP_DISPATCH_FARE_RAISE_AMOUNT=5000
# 예약시간이 이만큼 이상 남은 접수건은 배차지연으로 보지 않는다(분)
MCP_DISPATCH_SCHEDULED_LEAD_MINUTES=10
# 콜마너 단건 상태동기화 대상 범위(1분 폴링이라 과도한 호출을 막는다)
# 1분마다 상태를 확인할 오더 수의 상한. 넘겨도 빠지는 오더는 없다 —
# "가장 오래 확인 안 된 순"으로 돌기 때문에 다음 회차에 맨 앞으로 온다.
CALLMANER_SYNC_ORDER_LIMIT=500
CALLMANER_SYNC_LOOKBACK_DAYS=3
# 동시 호출 수. 상한을 올릴 때 이것도 같이 올려야 걸리는 시간이 줄어든다
# (시간 = 건수 ÷ 동시성 × 응답시간).
CALLMANER_SYNC_CONCURRENCY=10
# 한 회차 제한 시간(ms). 넘기면 남은 오더는 다음 회차로 미룬다 — 콜마너가 느려져도
# 1분 주기 크론이 겹치지 않게 하는 장치다(건수 상한만으로는 속도 변화를 못 막는다).
CALLMANER_SYNC_TIME_BUDGET_MS=45000

# 카카오 상담톡(ConsulTalk 중계서버) 연동 — "카카오 상담톡 연동 계획서" 참고.
CONSULTALK_BASE_URL=https://consultalk-alpha.callmaner.com
# 발신 API 경로 버전(/api/<버전>/send/...). 2026-08-07 실측 기준 alpha 서버는 v1만 응답하고
# v3는 404다(라이브 스펙 openapi.json에도 v1만 있음). v3가 열리면 이 값만 v3로 바꾸면 된다.
CONSULTALK_API_VERSION=v1
# 발신 헤더 X-Platform-Type 값. 카카오 상담톡은 kakao_counsel_talk.
CONSULTALK_PLATFORM_TYPE=kakao_counsel_talk
# 중계서버 → b2b-car 수신 웹훅(/kakao-consult/*) 공유 시크릿. callmaner 쪽에 이 값을 전달해
# 요청 헤더 X-Webhook-Secret으로 실어달라고 요청해야 한다(계획서 8.1 — 실제 웹훅 인증 방식은
# 아직 미확인. 확인 전까지 이 값을 비워두면 검증 없이 통과한다 — 운영 배포 전 반드시 채울 것).
KAKAO_CONSULT_WEBHOOK_SECRET=

# ── 기사 푸시 (콜마너 Firebase FCM) ─────────────────────────────────────────
# 방식 B "권한 위임"(사용자 확정 2026-08-30): 콜마너는 앱만 고치고, 발송은 우리가 한다.
# 콜마너 Firebase 프로젝트에서 발급받은 **Cloud Messaging 발송 권한만** 가진 서비스계정이다.
# firebase-admin은 쓰지 않는다 — 서비스계정 JWT → 액세스 토큰 → HTTP v1 호출이 전부이고,
# 그 흐름은 lib/vertexAi.js에 이미 있다(lib/driverPush.js가 같은 패턴을 쓴다).
#
# 셋 다 없으면 푸시를 조용히 건너뛴다 — 알림이 안 가는 것보다 그 때문에 메시지 저장이
# 막히는 쪽이 나쁘다.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# 개행은 \n으로 이스케이프해서 한 줄로 넣는다(GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY와 같은 규칙).
FCM_PRIVATE_KEY=
