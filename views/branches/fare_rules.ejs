<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= branch.name %> · 탁송 요금</h1>
    <p class="page-sub">거리 기반 자동요금 계산 규칙입니다. 계산식: 기본요금 + (거리 − 기준거리) × (할증요금 ÷ 할증단위)</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/branches">지사 목록으로</a>
    <button class="btn" type="submit" form="fareForm">저장</button>
  </div>
</div>
<%- include('../partials/branch_tabs', { branch: branch, active: 'fare' }) %>
<% if (typeof error !== 'undefined' && error) { %><div class="alert error"><%= error %></div><% } %>

<div class="card">
  <div class="section-title">📋 다른 지사 요금표 복사</div>
  <form method="POST" action="/branches/<%= branch.id %>/fare-rules/copy" onsubmit="return confirm('선택한 지사의 요금표로 현재 지사 설정을 덮어쓸까요?');">
    <div class="row">
      <div class="field">
        <label>원본 지사 선택</label>
        <select name="source_branch_id" required>
          <option value="">선택하세요</option>
          <% branches.forEach(function (b) { if (b.id !== branch.id) { %>
            <option value="<%= b.id %>"><%= b.name %></option>
          <% } }) %>
        </select>
      </div>
      <div class="field" style="display:flex;align-items:flex-end;">
        <button class="btn secondary" type="submit">이 지사로 요금표 복사</button>
      </div>
    </div>
    <p class="page-sub" style="margin-top:8px;">구간요금 규칙과 부가 요금/노출 설정이 함께 복사됩니다.</p>
  </form>
</div>

<form id="fareForm" method="POST" action="/branches/<%= branch.id %>/fare-rules">
  <div class="card">
    <div class="section-title">📏 거리 구간별 요금 규칙</div>
    <div class="table-wrap">
    <table id="fareTiersTable" data-branch-id="<%= branch.id %>" data-representative="1">
      <thead>
        <tr>
          <th>구간</th><th>기준거리(km)</th><th>기본요금(원)</th><th>할증단위(km)</th><th>할증요금(원)</th>
          <th>최대거리(km)</th><th>최대요금(원)</th><th>반올림단위</th><th>반올림방식</th><th>대표요금제</th><th></th>
        </tr>
      </thead>
      <tbody id="fareTiersBody">
        <% tiers.forEach(function(t, i){ %>
          <tr>
            <td class="tier-label">구간요금<%= i + 1 %></td>
            <td><input type="number" name="base_distance_km" value="<%= t.base_distance_km %>" min="0" step="0.1"></td>
            <td><input type="number" name="base_fare" value="<%= t.base_fare %>" min="0" step="1000"></td>
            <td><input type="number" name="surcharge_unit_km" value="<%= t.surcharge_unit_km %>" min="0.1" step="0.1"></td>
            <td><input type="number" name="surcharge_fare" value="<%= t.surcharge_fare %>" min="0" step="100"></td>
            <td><input type="number" name="max_distance_km" value="<%= t.max_distance_km || '' %>" min="0" step="0.1"></td>
            <td><input type="number" name="max_fare" value="<%= t.max_fare || '' %>" min="0" step="1000"></td>
            <td><input type="number" name="round_unit" value="<%= t.round_unit %>" min="1" step="1"></td>
            <td>
              <select name="round_method">
                <option value="up" <%= t.round_method === 'up' ? 'selected' : '' %>>올림</option>
                <option value="round" <%= t.round_method === 'round' ? 'selected' : '' %>>반올림</option>
                <option value="down" <%= t.round_method === 'down' ? 'selected' : '' %>>내림</option>
              </select>
            </td>
            <td style="text-align:center;"><input type="checkbox" name="tier_representative" value="<%= i %>" class="tier-representative-toggle" data-tier-id="<%= t.id %>" <%= t.is_representative ? 'checked' : '' %>></td>
            <td><button type="button" class="btn small secondary remove-tier-btn">삭제</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <button type="button" class="btn small secondary" id="addTierBtn" style="margin-top:10px;">+ 구간 추가</button>
  </div>

  <div class="card">
    <div class="section-title">➕ 부가 요금 / 노출 설정 <span class="hint">(대기·취소요금은 탁송 전용)</span></div>
    <div class="row">
      <div class="field"><label>왕복 비율(%, 편도 대비)</label><input type="number" name="round_trip_ratio" value="<%= extra.round_trip_ratio || 180 %>" min="0"></div>
      <div class="field"><label>대기 기준시간(분) · 탁송</label><input type="number" name="wait_threshold_min" value="<%= extra.wait_threshold_min || 15 %>" min="0"></div>
      <div class="field"><label>대기요금(원) · 탁송</label><input type="number" name="wait_fee" value="<%= extra.wait_fee || 0 %>" min="0"></div>
    </div>
    <div class="row">
      <%# 취소요금은 1,000원 단위로 받는다(사용자 확정) — 법인 화면(views/groups/fare_rules.ejs)도 같다. %>
      <div class="field"><label>배차 전 취소요금(원) · 탁송</label><input type="number" name="cancel_before_fee" value="<%= extra.cancel_before_fee || 0 %>" min="0" step="1000"></div>
      <div class="field"><label>배차 후 취소요금(원) · 탁송</label><input type="number" name="cancel_after_fee" value="<%= extra.cancel_after_fee || 0 %>" min="0" step="1000"></div>
    </div>
    <div class="row">
      <div class="field"><label class="checkline"><input type="checkbox" name="fare_table_enabled" value="1" <%= extra.fare_table_enabled ? 'checked' : '' %>> 이 요금표 사용 (미사용 시 요금을 수동으로 입력)</label></div>
      <div class="field"><label class="checkline"><input type="checkbox" name="fare_visible_to_client" value="1" <%= extra.fare_visible_to_client !== 0 ? 'checked' : '' %>> 고객사(딜러)에게 요금 노출</label></div>
      <div class="field"><label class="checkline"><input type="checkbox" name="fare_editable_by_client" value="1" <%= extra.fare_editable_by_client ? 'checked' : '' %>> 고객사(딜러)의 금액 수정 허용</label></div>
    </div>
  </div>

  <%- include('../partials/order_type_trip_fees') %>

  <%- include('../partials/fare_surcharge_settings') %>
</form>

<% if (typeof saved !== 'undefined' && saved) { %>
  <div class="toast" id="fareSavedToast">저장되었습니다.</div>
<% } %>
<% if (typeof copied !== 'undefined' && copied) { %>
  <div class="toast" id="fareCopiedToast"><%= copiedFrom ? (copiedFrom + ' 지사의 요금표를 복사했습니다.') : '요금표를 복사했습니다.' %></div>
<% } %>
<script src="/js/fare-rules.js"></script>
<%- include('../partials/footer') %>
