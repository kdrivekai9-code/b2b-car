<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= title %></h1>
    <p class="page-sub">지사 기본 정보를 입력하세요.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/branches">취소</a>
    <button class="btn" type="submit" form="branchForm">저장</button>
  </div>
</div>
<% if (mode === 'edit') { %><%- include('../partials/branch_tabs', { branch: branch, active: 'basic' }) %><% } %>
<div class="card">
  <form id="branchForm" method="POST" action="<%= mode === 'create' ? '/branches' : '/branches/' + branch.id %>">
    <div class="section-title">🏢 기본 정보</div>
    <div class="row">
      <div class="field"><label>지사명 *</label><input type="text" name="name" value="<%= branch.name || '' %>" required></div>
      <div class="field"><label>지사코드 *</label><input type="text" name="code" value="<%= branch.code || '' %>" required></div>
    </div>
    <div class="row">
      <div class="field"><label>대표번호</label><input type="text" name="main_phone" value="<%= branch.main_phone || '' %>"></div>
      <div class="field"><label>담당자</label><input type="text" name="contact_name" value="<%= branch.contact_name || '' %>"></div>
      <div class="field"><label>담당자 연락처</label><input type="text" name="contact_phone" placeholder="010-0000-0000" value="<%= branch.contact_phone || '' %>"></div>
    </div>
    <div class="row">
      <div class="field full"><label>주소</label><input type="text" name="address" value="<%= branch.address || '' %>"></div>
    </div>

    <%# 청구서에 그대로 찍히는 값이다 — 비어 있으면 받는 쪽이 어디로 입금할지 알 수 없어
        따로 물어야 한다. 세 칸으로 나눈 이유는 은행만 바꿀 때 전체를 다시 쓰지 않게 하고,
        예금주가 빠진 채 저장되는 것을 눈으로 알아채기 위해서다. %>
    <div class="section-title" style="font-size:14px;margin-top:16px;">💳 입금계좌 <span class="page-sub">(정산서·청구서에 표시)</span></div>
    <div class="row">
      <div class="field"><label>은행</label><input type="text" name="bank_name" placeholder="예: 국민은행" value="<%= branch.bank_name || '' %>"></div>
      <div class="field"><label>계좌번호</label><input type="text" name="bank_account" placeholder="예: 123456-01-234567" value="<%= branch.bank_account || '' %>"></div>
      <div class="field"><label>예금주</label><input type="text" name="bank_holder" placeholder="예: (주)씨엠엔피" value="<%= branch.bank_holder || '' %>"></div>
    </div>
    <% if (mode === 'edit') { %>
    <div class="row">
      <div class="field">
        <label>상태</label>
        <select name="status">
          <option value="active" <%= branch.status === 'active' ? 'selected' : '' %>>활성</option>
          <option value="inactive" <%= branch.status === 'inactive' ? 'selected' : '' %>>비활성</option>
        </select>
      </div>
    </div>
    <% } %>
  </form>
</div>

<% if (mode === 'edit') { %>
<div class="card">
  <div class="page-head-row" style="margin-bottom:8px;">
    <div class="section-title" style="margin:0;">🔑 계정정보</div>
    <a class="btn small secondary" href="/users/new">+ 사용자 등록</a>
  </div>
  <p class="page-sub" style="margin-top:0;">이 지사 소속으로 사용자 관리에 등록된 계정입니다. 비밀번호는 보안상 표시되지 않으며, 관리자만 수정할 수 있습니다.</p>
  <div class="table-wrap">
  <table>
    <thead><tr><th>이름</th><th>아이디</th><th>비밀번호</th><th>역할</th><th>상태</th><th>관리</th></tr></thead>
    <tbody>
      <% const branchRoleLabel = {admin:'관리자', branch_manager:'지사장', client:'클라이언트'}; %>
      <% if (!accountUsers || accountUsers.length === 0) { %><tr><td colspan="6" class="empty">등록된 계정이 없습니다.</td></tr><% } %>
      <% (accountUsers || []).forEach(function(u){ %>
        <tr>
          <td><%= u.name %></td>
          <td><%= u.login_id %></td>
          <td>••••••••</td>
          <td><%= branchRoleLabel[u.role] || u.role %></td>
          <td><span class="badge <%= u.status === 'active' ? 'green' : 'gray' %>"><%= u.status === 'active' ? '활성' : '비활성' %></span></td>
          <td><a class="btn small secondary" href="/users/<%= u.id %>/edit">수정</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<% } %>
<%- include('../partials/footer') %>
