<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= branch.name %> · 프리미엄(대리) 요금</h1>
    <p class="page-sub">법인대리(프리미엄)는 <b>편도 서비스</b>라 탁송과 같은 거리 기준입니다. 이용 시간 기준인 <b>일일기사</b>와는 다른 표입니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/branches">지사 목록으로</a>
    <button class="btn" type="submit" form="premiumOnewayFareForm">저장</button>
  </div>
</div>
<%- include('../partials/branch_tabs', { branch: branch, active: 'premium_oneway_fare' }) %>

<div class="card">
  <div class="section-title">📌 이 요금이 쓰이는 곳</div>
  <p class="page-sub" style="margin:0;">
    오더구분이 <b>프리미엄대리</b>인 오더의 요금을 이 표로 계산합니다(거리 기준). 요금 문의 답변도 이 표를 씁니다.
  </p>
  <p class="page-sub" style="margin:0;">
    <b>등록하지 않으면 자동계산을 하지 않습니다</b> — 탁송 요금표로 대신 계산하면 계약과 다른 금액이 조용히 청구되기 때문입니다.
    그때 오더 등록 화면은 수동 입력으로 바뀌고, 챗봇 요금 문의는 "등록되어 있지 않습니다"로 안내한 뒤 상담원 연결을 제안합니다.
  </p>
  <p class="page-sub" style="margin-bottom:0;">
    현재 등록된 구간: <b><%= tiers.length %>개</b>
    <% if (!tiers.length) { %><span class="badge amber">미등록</span><% } %>
    · 법인별로 다른 요금이면 <b>법인관리 → 프리미엄(대리) 요금</b>에 등록하세요(법인 표가 있으면 그것이 먼저 적용됩니다).
  </p>
</div>

<form id="premiumOnewayFareForm" method="POST" action="/branches/<%= branch.id %>/premium-oneway-fare-rules">
  <div class="card">
    <div class="section-title">📏 거리 구간별 요금</div>
    <p class="page-sub">계산식: 기본요금 + (거리 − 기준거리) × (할증요금 ÷ 할증단위)</p>
    <div class="table-wrap">
    <table id="fareTiersTable" data-note="1">
      <thead>
        <tr>
          <th>구간</th><th>기준거리(km)</th><th>기본요금(원)</th><th>할증단위(km)</th><th>할증요금(원)</th>
          <th>최대거리(km)</th><th>최대요금(원)</th><th>반올림단위</th><th>반올림방식</th><th>비고</th><th></th>
        </tr>
      </thead>
      <tbody id="fareTiersBody">
        <% tiers.forEach(function(t, i){ %>
          <tr>
            <td class="tier-label">구간요금<%= i + 1 %></td>
            <td><input type="number" name="base_distance_km" value="<%= t.base_distance_km %>" min="0" step="0.1"></td>
            <td><input type="number" name="base_fare" value="<%= t.base_fare %>" min="0" step="1000"></td>
            <td><input type="number" name="surcharge_unit_km" value="<%= t.surcharge_unit_km %>" min="0.1" step="0.1"></td>
            <td><input type="number" name="surcharge_fare" value="<%= t.surcharge_fare %>" min="0" step="100"></td>
            <td><input type="number" name="max_distance_km" value="<%= t.max_distance_km || '' %>" min="0" step="0.1"></td>
            <td><input type="number" name="max_fare" value="<%= t.max_fare || '' %>" min="0" step="1000"></td>
            <td><input type="number" name="round_unit" value="<%= t.round_unit %>" min="1" step="1"></td>
            <td>
              <select name="round_method">
                <option value="up" <%= t.round_method === 'up' ? 'selected' : '' %>>올림</option>
                <option value="round" <%= t.round_method === 'round' ? 'selected' : '' %>>반올림</option>
                <option value="down" <%= t.round_method === 'down' ? 'selected' : '' %>>내림</option>
              </select>
            </td>
            <td><input type="text" name="note" value="<%= t.note || '' %>"></td>
            <td><button type="button" class="btn small secondary remove-tier-btn">삭제</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <button type="button" class="btn small secondary" id="addTierBtn" style="margin-top:10px;">+ 구간 추가</button>
  </div>
</form>

<% if (saved) { %><div class="toast">저장되었습니다.</div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<script src="/js/fare-rules.js"></script>
<%- include('../partials/footer') %>
