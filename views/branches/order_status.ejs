<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= branch.name %> · 오더 상태 설정</h1>
    <p class="page-sub">이 지사에서 고객사에게 노출할 상태와, 백오피스 전용(고객 비노출) 상태를 설정하세요.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/branches">지사 목록으로</a>
    <button class="btn" type="submit" form="statusForm">저장</button>
  </div>
</div>
<%- include('../partials/branch_tabs', { branch: branch, active: 'status' }) %>

<div class="card">
  <form id="statusForm" method="POST" action="/branches/<%= branch.id %>/order-status">
    <div class="table-wrap">
    <table>
      <thead><tr><th>상태</th><th>고객사 노출</th><th>백오피스 전용</th></tr></thead>
      <tbody>
        <% statuses.forEach(function(s){ %>
          <tr>
            <td><span class="badge <%= statusColor(s.status_code) %>"><%= s.status_code %></span></td>
            <td><input type="checkbox" name="customer_visible" value="<%= s.status_code %>" <%= s.is_customer_visible ? 'checked' : '' %>></td>
            <td><input type="checkbox" name="backoffice_only" value="<%= s.status_code %>" <%= s.is_backoffice_only ? 'checked' : '' %>></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
