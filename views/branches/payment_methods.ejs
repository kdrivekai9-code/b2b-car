<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= branch.name %> · 결제방식 설정</h1>
    <p class="page-sub">이 지사 오더 등록 화면에 노출할 결제수단과 기본값을 선택하세요. 하나도 선택하지 않으면 전체 결제수단이 노출됩니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/branches">지사 목록으로</a>
    <button class="btn" type="submit" form="pmForm">저장</button>
  </div>
</div>
<%- include('../partials/branch_tabs', { branch: branch, active: 'payment' }) %>
<div class="card">
  <form id="pmForm" method="POST" action="/branches/<%= branch.id %>/payment-methods">
    <div class="section-title">💳 노출할 결제수단</div>
    <% allMethods.forEach(function(pm){ %>
      <div class="checkline" style="font-size:13px;margin-bottom:8px;">
        <input type="checkbox" name="payment_method_ids" value="<%= pm.id %>" id="pm_<%= pm.id %>" <%= enabledMap[pm.id] !== undefined ? 'checked' : '' %>>
        <label for="pm_<%= pm.id %>" style="font-weight:400;"><%= pm.name %></label>
        &nbsp;&nbsp;
        <label class="checkline" style="display:inline-flex;">
          <input type="radio" name="default_payment_method_id" value="<%= pm.id %>" <%= enabledMap[pm.id] === 1 ? 'checked' : '' %>> 기본값
        </label>
      </div>
    <% }) %>
  </form>
</div>
<%- include('../partials/footer') %>
