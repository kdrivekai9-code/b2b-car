<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= branch.name %> · 프리미엄 요금표</h1>
    <p class="page-sub">프리미엄/일일기사 오더에 적용되는 시간 구간 기반 요금표입니다. 기본요금 + (초과시간 × 시간당 추가요금) 방식으로 계산됩니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/branches">지사 목록으로</a>
    <button class="btn" type="submit" form="premiumFareForm">저장</button>
  </div>
</div>
<%- include('../partials/branch_tabs', { branch: branch, active: 'premium_fare', branches: branches }) %>

<% if (saved) { %>
  <div class="success-msg" style="margin-bottom:12px;">✓ 저장되었습니다.</div>
<% } %>

<form id="premiumFareForm" method="POST" action="/branches/<%= branch.id %>/premium-fare-rules">
  <div class="card">
    <div class="section-title">⏱ 시간 구간별 요금 규칙</div>
    <p class="page-sub">구간 기준시간(base_hours) 이상이고 다음 구간 미만일 때 해당 구간 기본요금을 적용합니다.</p>
    <div class="table-wrap">
      <table id="premiumFareTiersTable">
        <thead>
          <tr>
            <th>구간</th>
            <th>기준시간(h)</th>
            <th>기본요금(원)</th>
            <th>시간당 추가요금(원)</th>
            <th>비고</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="premiumFareTiersBody">
          <% tiers.forEach(function(t, i){ %>
            <tr>
              <td class="tier-label">구간 <%= i + 1 %></td>
              <td><input type="number" name="base_hours" value="<%= t.base_hours %>" min="0" step="0.5" required></td>
              <td><input type="number" name="fare_amount" value="<%= t.fare_amount %>" min="0" step="1000"></td>
              <td><input type="number" name="extra_per_hour" value="<%= t.extra_per_hour %>" min="0" step="1000" placeholder="0이면 정액"></td>
              <td><input type="text" name="note" value="<%= t.note || '' %>" placeholder="예: 4시간 이내"></td>
              <td><button type="button" class="btn small secondary remove-premium-tier-btn">삭제</button></td>
            </tr>
          <% }) %>
          <% if (tiers.length === 0) { %>
            <tr>
              <td class="tier-label">구간 1</td>
              <td><input type="number" name="base_hours" value="0" min="0" step="0.5" required></td>
              <td><input type="number" name="fare_amount" value="0" min="0" step="1000"></td>
              <td><input type="number" name="extra_per_hour" value="0" min="0" step="1000" placeholder="0이면 정액"></td>
              <td><input type="text" name="note" value="" placeholder="예: 4시간 이내"></td>
              <td><button type="button" class="btn small secondary remove-premium-tier-btn">삭제</button></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <button type="button" class="btn small secondary" id="addPremiumTierBtn" style="margin-top:10px;">+ 구간 추가</button>
  </div>
</form>

<script>
  (function () {
    var tbody = document.getElementById('premiumFareTiersBody');
    var addBtn = document.getElementById('addPremiumTierBtn');
    var tierCount = tbody ? tbody.querySelectorAll('tr').length : 1;

    function reLabel() {
      tbody.querySelectorAll('tr').forEach(function (row, i) {
        var label = row.querySelector('.tier-label');
        if (label) label.textContent = '구간 ' + (i + 1);
      });
    }

    if (addBtn && tbody) {
      addBtn.addEventListener('click', function () {
        tierCount += 1;
        var tr = document.createElement('tr');
        tr.innerHTML = '<td class="tier-label">구간 ' + tierCount + '</td>' +
          '<td><input type="number" name="base_hours" value="0" min="0" step="0.5" required></td>' +
          '<td><input type="number" name="fare_amount" value="0" min="0" step="1000"></td>' +
          '<td><input type="number" name="extra_per_hour" value="0" min="0" step="1000" placeholder="0이면 정액"></td>' +
          '<td><input type="text" name="note" value="" placeholder="예: 4시간 이내"></td>' +
          '<td><button type="button" class="btn small secondary remove-premium-tier-btn">삭제</button></td>';
        tbody.appendChild(tr);
        bindRemove(tr.querySelector('.remove-premium-tier-btn'));
      });
    }

    function bindRemove(btn) {
      btn.addEventListener('click', function () {
        btn.closest('tr').remove();
        reLabel();
      });
    }

    if (tbody) {
      tbody.querySelectorAll('.remove-premium-tier-btn').forEach(bindRemove);
    }
  })();
</script>
<%- include('../partials/footer') %>
