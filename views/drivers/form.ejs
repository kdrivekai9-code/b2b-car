<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= title %></h1>
    <p class="page-sub">기사 기본 정보를 입력하세요.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/drivers">취소</a>
    <button class="btn" type="submit" form="driverForm">저장</button>
  </div>
</div>
<div class="card">
  <form id="driverForm" method="POST" action="<%= mode === 'create' ? '/drivers' : '/drivers/' + driver.id %>">
    <div class="row">
      <div class="field">
        <label>소속 지사 *</label>
        <select name="branch_id" required>
          <option value="">선택하세요</option>
          <% branches.forEach(function(b){ %>
            <option value="<%= b.id %>" <%= String(driver.branch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field"><label>이름 *</label><input type="text" name="name" value="<%= driver.name || '' %>" required></div>
    </div>
    <div class="row">
      <div class="field"><label>연락처</label><input type="text" name="phone" value="<%= driver.phone || '' %>" placeholder="010-0000-0000"></div>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
