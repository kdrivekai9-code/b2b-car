<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= title %></h1>
    <p class="page-sub">사용자 계정 정보를 입력하세요.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/users">취소</a>
    <button class="btn" type="submit" form="userForm">저장</button>
  </div>
</div>
<div class="card">
  <form id="userForm" method="POST" action="<%= mode === 'create' ? '/users' : '/users/' + user.id %>">
    <% if (typeof returnTo !== 'undefined' && returnTo) { %>
      <input type="hidden" name="return_to" value="<%= returnTo %>">
    <% } %>
    <div class="section-title">🧑‍💼 계정 정보</div>
    <div class="row">
      <div class="field">
        <label>아이디</label>
        <% if (mode === 'create') { %>
          <input type="text" name="login_id" placeholder="비워두면 자동으로 만들어집니다">
        <% } else { %>
          <input type="text" value="<%= user.login_id %>" disabled>
        <% } %>
      </div>
      <div class="field"><label>이름 *</label><input type="text" name="name" value="<%= user.name || '' %>" required></div>
    </div>
    <div class="row">
      <div class="field"><label>연락처</label><input type="text" name="phone" value="<%= user.phone || '' %>"></div>
      <div class="field">
        <label>비밀번호</label>
        <input type="password" name="password" placeholder="<%= mode === 'edit' ? '변경하지 않으려면 비워두세요' : '비워두면 임시 비밀번호(1234)로 설정됩니다' %>">
      </div>
    </div>
    <div class="section-title">🔑 권한 정보</div>
    <div class="row">
      <div class="field">
        <label>권한(역할) *</label>
        <select name="role" id="role" required onchange="toggleClientFields()">
          <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>관리자(센터)</option>
          <option value="branch_manager" <%= user.role === 'branch_manager' ? 'selected' : '' %>>지사장(모니터링 전용)</option>
          <option value="client" <%= user.role === 'client' ? 'selected' : '' %>>클라이언트(고객사)</option>
        </select>
      </div>
      <div class="field">
        <label>지사</label>
        <select name="branch_id">
          <option value="">선택 안 함</option>
          <% branches.forEach(function(b){ %>
            <option value="<%= b.id %>" <%= String(user.branch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="row" id="clientFields">
      <%# 법인 고객 계정은 소속 법인이 없으면 그 계정의 오더가 법인 정산서에 잡히지 않는다
          — 청구가 조용히 빠진다. 서버도 같은 검증을 한다(routes/users.js clientGroupError).
          required는 아래 toggleClientFields가 이 줄을 보일 때만 붙인다 — display:none인 칸에
          required가 남아 있으면 브라우저가 포커스를 못 줘 저장이 조용히 막힌다. %>
      <div class="field">
        <label>소속 법인 *</label>
        <select name="group_id" id="group_id">
          <option value="">선택하세요</option>
          <% groups.forEach(function(g){ %>
            <option value="<%= g.id %>" <%= String(user.group_id) === String(g.id) ? 'selected' : '' %>><%= g.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label>권한 등급</label>
        <select name="grade">
          <option value="leader" <%= user.grade === 'leader' ? 'selected' : '' %>>법인 담당(리더)</option>
          <option value="member" <%= user.grade === 'member' ? 'selected' : '' %>>법인 담당(일반)</option>
        </select>
      </div>
    </div>
    <% if (mode === 'edit') { %>
    <div class="row">
      <div class="field">
        <label>상태</label>
        <select name="status">
          <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>활성</option>
          <option value="inactive" <%= user.status === 'inactive' ? 'selected' : '' %>>비활성</option>
        </select>
      </div>
    </div>
    <% } %>
  </form>
</div>
<script>
function toggleClientFields(){
  var role = document.getElementById('role').value;
  var isClient = role === 'client';
  document.getElementById('clientFields').style.display = isClient ? 'flex' : 'none';
  // 숨길 때는 required를 떼야 한다 — 안 떼면 브라우저가 안 보이는 칸을 지적하려다
  // 포커스를 못 줘서, 아무 안내도 없이 저장이 안 되는 상태가 된다.
  document.getElementById('group_id').required = isClient;
}
document.addEventListener('DOMContentLoaded', toggleClientFields);
</script>
<%- include('../partials/footer') %>
