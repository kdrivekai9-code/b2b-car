<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">접속기록</h1>
    <p class="page-sub">사용자 로그인과 시스템 수행업무 기록을 최근 1,000건까지 조회합니다.</p>
  </div>
  <span class="page-heading-meta">총 <%= logs.length %>건</span>
</div>


<% if (error) { %><div class="error-msg"><%= error %></div><% } %>
<% if (notice) { %><div class="success-msg"><%= notice %></div><% } %>

<%# AI 사용량 제한 — 로그인 차단 기록을 보는 자리와 "얼마나 허용할지" 정하는 자리를 같이 둔다. %>
<div class="card">
  <div class="section-title">🤖 AI 사용량 제한</div>
  <p class="page-sub">
    챗봇이 Gemini를 부르는 요청(접수 분류·도우미 등)의 계정당 허용량입니다.
    IP가 아니라 <strong>로그인 계정</strong>으로 셉니다 — 한 사무실에서 여러 명이 써도 서로의 한도를 깎지 않습니다.
    <strong>0으로 두면 제한하지 않습니다.</strong>
  </p>
  <form method="POST" action="/access-logs/ai-rate-limit">
    <div class="row">
      <div class="field">
        <label for="aiPerMinute">분당 한도(계정당)</label>
        <input id="aiPerMinute" type="number" name="per_minute" value="<%= aiRateLimit.perMinute %>" min="0" step="1" required>
        <span class="hint">기본 <%= aiRateLimit.defaultPerMinute %></span>
      </div>
      <div class="field">
        <label for="aiPerHour">시간당 한도(계정당)</label>
        <input id="aiPerHour" type="number" name="per_hour" value="<%= aiRateLimit.perHour %>" min="0" step="1" required>
        <span class="hint">기본 <%= aiRateLimit.defaultPerHour %></span>
      </div>
      <div class="field" style="display:flex;align-items:flex-end;">
        <button class="btn" type="submit">저장</button>
      </div>
    </div>
    <p class="page-sub" style="margin-bottom:0;">
      고객이 한 문장을 보내면 이 계열 요청이 2~3번 일어납니다(분류 → 접수턴 → 도우미).
      바꾼 값은 최대 <%= aiRateLimit.cacheSeconds %>초 뒤부터 적용됩니다.
    </p>
  </form>
</div>

<form class="filters card" method="GET" action="/access-logs">
  <div class="field"><label for="logAccount">계정</label><input id="logAccount" name="account" value="<%= filters.account %>" placeholder="로그인 아이디"></div>
  <div class="field">
    <label for="logEventType">기록 유형</label>
    <select id="logEventType" name="event_type">
      <option value="">전체</option>
      <% [['LOGIN_SUCCESS','로그인 성공'],['LOGIN_FAILURE','로그인 실패'],['LOGIN_BLOCKED','중복 로그인(기존 세션 로그아웃)'],['LOGIN_RATE_LIMITED','무차별 대입 차단'],['LOGOUT','로그아웃'],['ACCESS','업무 수행']].forEach(function(item){ %>
        <option value="<%= item[0] %>" <%= filters.event_type === item[0] ? 'selected' : '' %>><%= item[1] %></option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label for="logFrom">시작일</label><input id="logFrom" type="date" name="from" value="<%= filters.from %>"></div>
  <div class="field"><label for="logTo">종료일</label><input id="logTo" type="date" name="to" value="<%= filters.to %>"></div>
  <div class="field"><button class="btn" type="submit">조회</button></div>
  <div class="field"><a class="btn secondary" href="/access-logs">초기화</a></div>
</form>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead><tr><th>접속일시</th><th>계정</th><th>IP</th><th>유형</th><th>수행업무</th><th>정보주체 정보</th><th>결과</th></tr></thead>
      <tbody>
        <% if (logs.length === 0) { %><tr><td colspan="7" class="empty">조건에 맞는 접속기록이 없습니다.</td></tr><% } %>
        <% logs.forEach(function(log){ %>
          <tr>
            <td><%= log.accessed_at %></td>
            <td><b><%= log.account %></b></td>
            <td><%= log.ip_address %></td>
            <td><%= log.event_type %></td>
            <td><%= log.work_detail %></td>
            <td><%= log.subject_info || '-' %></td>
            <td><span class="badge <%= log.success ? 'green' : 'red' %>"><%= log.success ? '성공' : '실패' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>