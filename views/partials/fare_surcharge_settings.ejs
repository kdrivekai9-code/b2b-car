<%# 탁송 특화 할증 + 부대비용(실비) 설정.
    지사(views/branches/fare_rules.ejs)와 법인(views/groups/fare_rules.ejs)이 같은 부품을 쓴다 —
    한쪽에만 항목을 늘리면 그 화면으로 저장할 때 다른 쪽 설정이 조용히 지워진다. %>
<% const feeAttrs = `min="0" max="${surchargeMax}" step="1000" placeholder="0"` %>
<% const feeHint = `0이면 안 받음 · 받으려면 ${surchargeMin.toLocaleString('ko-KR')}~${surchargeMax.toLocaleString('ko-KR')}원` %>

<div class="card">
  <div class="section-title">🚗 탁송 특화 할증</div>
  <p class="page-sub" style="margin-top:-4px;">
    거리 구간요금에 <b>더해지는</b> 정액입니다. 각 항목 <b>0</b>이면 그 할증을 받지 않습니다.
    금액은 <%= surchargeMin.toLocaleString('ko-KR') %>~<%= surchargeMax.toLocaleString('ko-KR') %>원 사이로 입력하세요.
  </p>

  <div class="section-title" style="font-size:14px;margin-top:14px;">차량 제원 — 차종 등록 정보로 자동 판정</div>
  <div class="row">
    <div class="field">
      <label>수입차 할증(원)</label>
      <input type="number" name="imported_car_fee" value="<%= extra.imported_car_fee || 0 %>" <%- feeAttrs %>>
      <p class="page-sub">차종의 브랜드가 <b>수입</b>으로 등록된 경우. <%= feeHint %></p>
    </div>
    <div class="field">
      <label>대형/화물 할증 — 기본 금액(원)</label>
      <input type="number" name="large_car_fee" value="<%= extra.large_car_fee || 0 %>" <%- feeAttrs %>>
      <p class="page-sub">RV(카니발·스타리아)·대형 세단·1톤 화물 등. 아래 차종별 금액이 없을 때 쓰입니다. <%= feeHint %></p>
    </div>
    <div class="field">
      <label>전기차 할증(원)</label>
      <input type="number" name="ev_fee" value="<%= extra.ev_fee || 0 %>" <%- feeAttrs %>>
      <p class="page-sub">차종이 <b>전기차</b>로 등록된 경우. <%= feeHint %></p>
    </div>
  </div>
  <p class="page-sub">
    세 항목은 <a href="/vehicle-models">차종 관리</a>에 등록된 판정값(수입/대형·화물/전기)으로 자동 적용됩니다.
    자동 판정이 틀린 차종은 그 화면에서 고치면 이후 접수부터 반영됩니다.
  </p>

  <%# 처음에는 "저장된 행"만 그리고 차종은 [+ 추가]를 눌러야 select 안에서 보이게 만들었는데,
      저장된 행이 없는 상태(=처음 여는 화면)에서 표가 통째로 비어 보였다. 관리자가 보고 싶은
      것은 "등록된 대형 차종 목록"이므로 차종을 한 줄씩 모두 깔고 금액만 채우게 한다. %>
  <div class="section-title" style="font-size:14px;margin-top:18px;">대형/화물 — 차종별 금액</div>
  <p class="page-sub" style="margin-top:-4px;">
    차종마다 부담이 달라(RV 카니발 vs 1톤 화물 탑차) 금액을 따로 정할 수 있습니다.
    <b>비워두면</b> 위 기본 금액을 쓰고, <b>0</b>을 넣으면 그 차종만 대형 할증을 받지 않습니다.
  </p>
  <% if (!(largeCarModels || []).length) { %>
    <%# 여기서 할 일은 "차종 관리로 건너가는 것" 하나뿐이다. 문장 속 링크로 두면 눌러야 할
        것이 글자에 묻혀 다음 행동이 보이지 않는다 — 버튼으로 꺼낸다(사용자 지시).
        대형이 아닌 차종은 일부러 목록에서 뺀다 — 금액을 걸어도 판정이 false라 영영 적용되지
        않는데, 화면에 있으면 설정했다고 착각한다. %>
    <p class="page-sub" style="margin-bottom:8px;">
      <b>대형/화물</b>로 등록된 차종이 아직 없습니다.
      차종을 등록하고 <b>대형/화물</b>에 체크하면 여기에 나옵니다.
    </p>
    <a class="btn secondary" href="/vehicle-models" target="_blank" rel="noopener">🚘 차종 관리 열기</a>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th style="width:60%;">차종</th><th style="width:40%;">할증 금액(원)</th></tr></thead>
        <tbody>
          <% const feeByModel = {}; (largeCarFees || []).forEach(function (r) { feeByModel[String(r.vehicle_model_id)] = r.fee; }) %>
          <% largeCarModels.forEach(function (m) { %>
            <% const saved = feeByModel[String(m.id)] %>
            <tr>
              <td>
                <input type="hidden" name="large_model_id" value="<%= m.id %>">
                <%= m.name %>
              </td>
              <td>
                <%# 값이 없으면 빈 칸이어야 한다 — 0을 넣어두면 "안 받음"으로 저장돼 뜻이 뒤집힌다. %>
                <input type="number" name="large_model_fee" value="<%= saved === undefined ? '' : saved %>"
                       min="0" max="<%= surchargeMax %>" step="1000" placeholder="기본 금액 사용">
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%# 목록이 있을 때도 같은 버튼을 둔다 — 차종을 더하거나 판정을 고치러 가는 길이
        비어 있을 때만 보이면, 정작 자주 쓰는 쪽에서 길이 사라진다. %>
    <p class="page-sub" style="margin-bottom:8px;">
      <b>대형/화물</b>로 등록한 차종이 모두 나옵니다 (현재 <%= largeCarModels.length %>건).
    </p>
    <a class="btn secondary" href="/vehicle-models" target="_blank" rel="noopener">🚘 차종 관리 열기</a>
  <% } %>

  <div class="section-title" style="font-size:14px;margin-top:18px;">환경 / 지역</div>
  <div class="row">
    <div class="field">
      <label>야간/조조 할증(원)</label>
      <input type="number" name="night_fee" value="<%= extra.night_fee || 0 %>" <%- feeAttrs %>>
      <p class="page-sub">예약·출발 시각이 아래 시간대에 들면 붙습니다. <%= feeHint %></p>
    </div>
    <div class="field">
      <label>야간 시간대</label>
      <div style="display:flex;gap:6px;align-items:center;">
        <input type="time" name="night_start_hm" value="<%= extra.night_start_hm || '22:00' %>">
        <span>~</span>
        <input type="time" name="night_end_hm" value="<%= extra.night_end_hm || '01:00' %>">
      </div>
      <p class="page-sub">자정을 넘겨도 됩니다(예: 22:00~01:00).</p>
    </div>
    <div class="field">
      <label>조조 시간대</label>
      <div style="display:flex;gap:6px;align-items:center;">
        <input type="time" name="early_start_hm" value="<%= extra.early_start_hm || '06:00' %>">
        <span>~</span>
        <input type="time" name="early_end_hm" value="<%= extra.early_end_hm || '09:00' %>">
      </div>
      <p class="page-sub">두 시간대 중 하나에만 들어도 한 번 붙습니다.</p>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label>오지 지역 할증(원)</label>
      <input type="number" name="remote_area_fee" value="<%= extra.remote_area_fee || 0 %>" <%- feeAttrs %>>
      <p class="page-sub">출발지나 도착지가 오지일 때. 양쪽 다여도 한 번만 붙습니다. <%= feeHint %></p>
    </div>
    <div class="field">
      <label>오지 판정 범위</label>
      <select name="remote_area_scope">
        <option value="ri" <%= (extra.remote_area_scope || 'ri') === 'ri' ? 'selected' : '' %>>리 만</option>
        <option value="ri_eup_myeon" <%= extra.remote_area_scope === 'ri_eup_myeon' ? 'selected' : '' %>>리 · 읍 · 면</option>
      </select>
      <p class="page-sub">행정지명이 이 글자로 끝나면 오지로 봅니다. 도로명(로/길)과 행정동(동)은 해당하지 않습니다.</p>
    </div>
  </div>

  <div class="section-title" style="font-size:14px;margin-top:18px;">목적지 장소 할증</div>
  <p class="page-sub" style="margin-top:-4px;">
    <b>목적지 주소</b>에 아래 낱말이 들어가면 그 금액을 더합니다(예: <b>유원지</b>).
    여러 개가 걸리면 <b>가장 비싼 것 하나만</b> 붙습니다.
  </p>
  <div class="table-wrap">
    <table class="table" id="placeSurchargeTable">
      <thead><tr><th style="width:55%;">포함 장소(낱말)</th><th style="width:30%;">할증 금액(원)</th><th style="width:15%;"></th></tr></thead>
      <tbody>
        <% (placeRules || []).forEach(function (p) { %>
          <tr>
            <td><input type="text" name="place_keyword" value="<%= p.keyword %>" placeholder="예: 유원지"></td>
            <td><input type="number" name="place_fee" value="<%= p.fee || 0 %>" <%- feeAttrs %>></td>
            <td><button type="button" class="btn small secondary remove-row-btn">삭제</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <button type="button" class="btn small secondary add-row-btn" data-target="placeSurchargeTable" style="margin-top:8px;">+ 장소 추가</button>
</div>

<div class="card">
  <div class="section-title">🧾 부대비용 및 실비 정산</div>
  <p class="page-sub" style="margin-top:-4px;">
    <b>포함</b>이면 기본 탁송료에 들어 있어 <b>따로 청구할 수 없습니다</b>.
    제외는 청구 시점으로 갈립니다 — <b>월정산</b>은 월 정산서에 모아 청구하고,
    <b>개별정산</b>은 건별로 따로 청구합니다. 정산내역에서 두 가지를 나눠 보여줍니다.
  </p>
  <div class="row">
    <% (extraCostItems || []).forEach(function (item) { %>
      <div class="field">
        <label><%= item.label %></label>
        <%# 값을 새 컬럼(*_mode)에 저장한다. 옛 컬럼(*_included)은 그대로 두고 읽기 폴백으로만
            쓴다 — 값을 옮기는 마이그레이션은 되돌리기 어렵다(lib/fareSurcharge.js extraCostMode). %>
        <select name="<%= item.modeKey %>">
          <% (extraCostModes || []).forEach(function (m) { %>
            <option value="<%= m.value %>" <%= item.mode === m.value ? 'selected' : '' %>><%= m.label %></option>
          <% }) %>
        </select>
        <p class="page-sub">정산 항목명: <b>기타정산(<%= item.chargeType %>)</b></p>
      </div>
    <% }) %>
  </div>

  <div class="section-title" style="font-size:14px;margin-top:18px;">특수 구간(민자 교량 등)</div>
  <p class="page-sub" style="margin-top:-4px;">
    등록한 이름이 경로에 나오면 <b>특수 구간 통행료를 “제외”로 둔 경우에 한해</b>
    실비 항목이 자동으로 잡힙니다. 금액은 기본값이며 실제 영수증 금액으로 고칠 수 있습니다.
  </p>
  <%# 이름 프리셋 — 판정이 **부분일치**라 표기가 조금만 달라도 안 걸린다.
      실측: 카카오는 "영종대교휴게소"처럼 뒤에 말을 붙여 주므로 등록명이 "영종대교"여야 걸리고
      "영종 대교"처럼 띄면 안 걸린다. 목록에서 고르면 그 오차가 사라진다.
      금액은 프리셋에 넣지 않는다 — 확인하지 못한 값을 기본값으로 심으면 그대로 청구된다. %>
  <datalist id="specialTollPresets">
    <% (specialTollPresets || []).forEach(function (g) { %>
      <% g.names.forEach(function (n) { %><option value="<%= n %>"><%= g.group %></option><% }) %>
    <% }) %>
  </datalist>
  <p class="page-sub">
    이름 칸을 누르면 <b>자주 쓰는 구간 목록</b>이 뜹니다(<%= (specialTollPresets || []).reduce(function (a, g) { return a + g.names.length; }, 0) %>곳).
    판정은 <b>이름이 들어 있는지</b>로 하므로 목록에서 고르면 표기 차이로 빗나가지 않습니다.
    <b>금액은 계약·영수증 기준으로 직접 넣어주세요</b> — 통행료는 차종·시간대에 따라 달라 미리 채워두지 않았습니다.
  </p>
  <div class="table-wrap">
    <table class="table" id="specialTollTable">
      <thead><tr><th style="width:55%;">구간·교량명</th><th style="width:30%;">기본 통행료(원)</th><th style="width:15%;"></th></tr></thead>
      <tbody>
        <% (tollRules || []).forEach(function (t) { %>
          <tr>
            <td><input type="text" name="toll_name" value="<%= t.name %>" list="specialTollPresets" placeholder="예: 인천대교"></td>
            <td><input type="number" name="toll_fee" value="<%= t.fee || 0 %>" min="0" step="100" placeholder="0"></td>
            <td><button type="button" class="btn small secondary remove-row-btn">삭제</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <button type="button" class="btn small secondary add-row-btn" data-target="specialTollTable" style="margin-top:8px;">+ 구간 추가</button>
</div>

<script>
// 행 추가/삭제. 마지막 행을 복제하지 않고 빈 행을 만든다 — 복제하면 앞 행의 값이 같이 딸려와
// 관리자가 지우는 것을 잊으면 의도치 않은 할증이 하나 더 저장된다.
(function () {
  var TEMPLATES = {
    placeSurchargeTable:
      '<td><input type="text" name="place_keyword" placeholder="예: 유원지"></td>'
      + '<td><input type="number" name="place_fee" value="0" min="0" max="<%= surchargeMax %>" step="1000"></td>'
      + '<td><button type="button" class="btn small secondary remove-row-btn">삭제</button></td>',
    specialTollTable:
      '<td><input type="text" name="toll_name" list="specialTollPresets" placeholder="예: 인천대교"></td>'
      + '<td><input type="number" name="toll_fee" value="0" min="0" step="100"></td>'
      + '<td><button type="button" class="btn small secondary remove-row-btn">삭제</button></td>',
  };
  document.querySelectorAll('.add-row-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-target');
      var body = document.querySelector('#' + id + ' tbody');
      if (!body || !TEMPLATES[id]) return;
      var tr = document.createElement('tr');
      tr.innerHTML = TEMPLATES[id];
      body.appendChild(tr);
    });
  });
  document.addEventListener('click', function (e) {
    if (e.target && e.target.classList.contains('remove-row-btn')) {
      var tr = e.target.closest('tr');
      if (tr) tr.remove();
    }
  });
})();
</script>
