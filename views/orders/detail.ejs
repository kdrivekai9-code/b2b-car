<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">
      오더 상세 · <%= order.oid %>
      <% if (order.callmaner_conf_slip) { %>
      <%# 일반 공백은 브라우저가 한 칸으로 접어버리므로(white-space:normal 기본값) &nbsp;로 2칸 확보 %>
      &nbsp;&nbsp;<span class="callmaner-conf-slip">콜마너접수번호 : <%= order.callmaner_conf_slip %></span>
      <% } %>
    </h1>
    <p class="page-sub">
      <span class="badge <%= statusColor(order.status) %>"><%= order.status %></span>
      <%# 나눠 접수한 건이면 몇 건 중 몇 번째인지 밝힌다 — 나누고 나면 두 건이 서로 남남이라,
          이 표시가 없으면 한쪽만 보고 "이게 전부"라고 판단하게 된다. %>
      <% if (order.split_group_id && order.split_total > 1) { %>
        <span class="badge purple">분리접수 <%= order.split_seq %>/<%= order.split_total %>건</span>
      <% } %>
      &nbsp; <%= order.branch_name %> · <%= order.group_name || '-' %> · 등록일시 <%= order.created_at %>
    </p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/orders">&larr; 오더 리스트로</a>
  </div>
</div>

<div class="detail-grid" style="margin-top:18px;">
  <div class="card">
    <h2>📍 이동 경로</h2>
    <div class="kv"><span class="k">출발지</span><span><%= order.origin_address %></span></div>
    <div class="kv"><span class="k">출발지 연락처</span><span><%= order.origin_contact || '-' %></span></div>
    <% waypoints.forEach(function(w, i){ %>
    <% var wLabel = '경유지' + (waypoints.length > 1 ? (' ' + (i + 1)) : ''); %>
    <div class="kv"><span class="k"><%= wLabel %></span><span><%= w.address %></span></div>
    <% if (w.contact_phone || w.vehicle_number) { %>
    <div class="kv"><span class="k"><%= wLabel %> 연락처</span><span><%= w.contact_phone || '-' %></span></div>
    <div class="kv"><span class="k"><%= wLabel %> 차량번호</span><span><%= w.vehicle_number || '-' %></span></div>
    <% } %>
    <% }) %>
    <div class="kv"><span class="k">도착지</span><span><%= order.destination_address %></span></div>
    <div class="kv"><span class="k">도착지 연락처</span><span><%= order.destination_contact || '-' %></span></div>
    <div class="kv"><span class="k">차종 / 차량번호</span><span>
      <%= [order.vehicle_type, order.vehicle_number].filter(Boolean).join(' / ') || '-' %>
      <%- include('../partials/vehicle_class_badge', { row: order }) %>
      <%- include('../partials/plate_check_badge', { row: order }) %>
    </span></div>
    <%# 번호판이 다르면 근거(인식 결과 + 그 사진)를 바로 보여준다 — 배지만 있으면
        관리자가 사진을 찾아 헤매고, 그 사이 차는 이미 달리고 있다. %>
    <% if (order.plate_check_status === 'mismatch') { %>
      <div class="alert error" style="margin-top:8px;">
        <b>번호판이 접수 내용과 다릅니다.</b>
        <div style="margin-top:6px;">
          접수 차량번호 <b><%= order.vehicle_number || '-' %></b>
          &nbsp;/&nbsp; 사진에서 인식 <b><%= order.plate_recognized || '-' %></b>
        </div>
        <% if (order.plate_photo_url) { %>
          <div style="margin-top:8px;">
            <a href="<%= order.plate_photo_url %>" target="_blank" rel="noopener">
              <img src="<%= order.plate_photo_url %>" alt="운행시작 전면 사진" style="max-width:320px;border-radius:8px;display:block;"
                   onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<span class=\'page-sub\'>사진 링크가 만료되었습니다</span>')">
            </a>
          </div>
        <% } %>
        <p class="page-sub" style="margin-top:6px;">
          <%= order.plate_checked_at || '' %> 확인. 다른 차량이 배차되었거나 접수 번호가 잘못 입력되었을 수 있습니다.
        </p>
      </div>
    <% } %>
    <div class="kv"><span class="k">예약일시</span><span><%= order.reserved_date %> <%= order.reserved_time %></span></div>
    <div class="kv"><span class="k">결제방식</span><span><%= order.payment_method_name || '-' %></span></div>
    <div class="kv"><span class="k">요금</span><span><%= formatMoney(order.fare_amount) %></span></div>
    <div class="kv"><span class="k">도선료</span><span><%= formatMoney(order.ferry_fare_amount || 0) %></span></div>
    <div class="kv"><span class="k">배정 기사</span><span><%= order.driver_name || '미배정' %></span></div>

    <%
      const orderTypeLabels = { dispatch: '탁송', premium: '프리미엄', daily_driver: '일일기사' };
      const tripTypeLabels = { round_trip: '왕복', one_way: '편도' };
    %>
    <div class="kv"><span class="k">오더 타입</span><span><%= orderTypeLabels[order.order_type] || order.order_type || 'dispatch' %></span></div>
    <% if (order.trip_type) { %>
      <div class="kv"><span class="k">이용 형태</span><span><%= tripTypeLabels[order.trip_type] || order.trip_type %></span></div>
    <% } %>
    <% if (order.destination_wait_minutes != null) { %>
      <div class="kv"><span class="k">도착지 대기시간</span><span><%= order.destination_wait_minutes %>분</span></div>
    <% } %>
    <% if (order.final_destination_address) { %>
      <div class="kv"><span class="k">최종 목적지</span><span><%= order.final_destination_address %><%= order.final_destination_address_detail ? ' ' + order.final_destination_address_detail : '' %></span></div>
    <% } %>

    <div class="section-title">메모</div>
    <%# 분석 대상이 이 글이라 읽고 있는 자리에 버튼을 둔다. 고객에게는 안 보인다 —
        청구 항목을 정하는 일이다. 팝업 동작은 public/js/memo-reanalyze.js. %>
    <div class="kv">
      <span class="k">고객사 메모</span>
      <span>
        <%= order.memo_customer || '작성된 메모가 없습니다.' %>
        <% if (currentUser.role !== 'client' && order.memo_customer) { %>
        <button type="button" class="btn small secondary memo-reanalyze-btn"
                data-order="<%= order.id %>" style="margin-left:8px;">요청사항 다시 분석</button>
        <% } %>
      </span>
    </div>
    <%# 업체요청사항과 기사 챗봇 전달사항은 관리자에게만 보인다(사용자 확정 2026-09-03).
        고객은 요청사항을 한 칸에 쓰고, 나누는 일은 서버가 한다 — 나뉜 결과를 되돌려 보여주면
        "내가 이렇게 쓴 적 없는데"가 된다. 기사 챗봇 전달사항은 애초에 상담원이 기사에게
        하는 말이라 고객이 볼 자리가 아니다. %>
    <% if (currentUser.role !== 'client') { %>
    <div class="kv"><span class="k">업체요청사항</span><span><%= order.memo_billing || '작성된 내용이 없습니다.' %></span></div>
    <div class="kv"><span class="k">기사 챗봇 전달사항</span><span><%= order.memo_driver_chat || '작성된 내용이 없습니다.' %></span></div>
    <% } %>
    <div class="kv"><span class="k">관리자 메모</span><span><%= order.memo_admin || '작성된 메모가 없습니다.' %></span></div>

    <% if (canViewPhotos) { %>
    <div class="section-title">📷 기사 업로드 사진</div>
    <% if (photos.length === 0) { %>
      <p class="page-sub" style="margin:0;">업로드된 사진이 없습니다.</p>
    <% } else { %>
      <div class="upload-gallery">
        <% photos.forEach(function(p){ %>
          <%# 구간 링크로 올라온 사진은 어느 구간인지 표시한다 — 인수 시점과 인도 시점 사진이
              섞이면 분쟁 때 어느 쪽 증빙인지 가릴 수 없다. %>
          <a href="<%= p.url %>" target="_blank" class="upload-photo-item">
            <img src="<%= p.url %>" alt="업로드된 사진">
            <% if (p.leg_seq) { %><span class="upload-photo-leg"><%= p.leg_seq %>구간</span><% } %>
          </a>
        <% }) %>
      </div>
      <%
        // 기사가 계기판 사진과 함께 적어둔 값. 사진을 열어 숫자를 읽지 않아도 되도록 여기 요약한다.
        // 같은 계산을 챗봇도 쓴다(lib/kakaoOrderPhotos.js의 summarizeOdometer).
        const odometerValues = photos.map(function (p) { return Number(p.odometer_km); })
          .filter(function (v) { return Number.isFinite(v) && v > 0; })
          .sort(function (a, b) { return a - b; });
      %>
      <% if (odometerValues.length) { %>
        <p class="page-sub" style="margin:8px 0 0;">
          계기판 <%= odometerValues[0].toLocaleString('ko-KR') %>km
          <% if (odometerValues.length > 1) { %>
            → <%= odometerValues[odometerValues.length - 1].toLocaleString('ko-KR') %>km
            (주행 <%= (odometerValues[odometerValues.length - 1] - odometerValues[0]).toLocaleString('ko-KR') %>km)
          <% } %>
        </p>
      <% } %>
    <% } %>

    <%# 기사 위치 — Next 오더상세(src/app/orders/[id]/DriverLocationMap.js)와 같은 화면이다.
        한쪽만 고치면 플래그를 되돌렸을 때 조용히 사라진다. 관리자·지사·고객 모두 본다.
        배차 전·완료 후에는 아예 그리지 않는다 — 완료 뒤에는 위치를 더는 수집하지 않는다. %>
    <% if (['기사배정', '운행시작'].indexOf(order.status) !== -1) { %>
      <div class="section-title">📍 기사님 위치</div>
      <div id="driverLoc" data-order-id="<%= order.id %>">
        <p class="hint" id="driverLocText">위치를 확인하는 중입니다…</p>
        <div id="driverLocMap" style="width:100%;height:280px;background:#e9ecef;border-radius:4px;display:none;"></div>
      </div>
    <% } %>

    <%# 콜마너 탁송사진 — 기사 업로드 사진과 별도다(외부 CDN 링크만 보관). 링크가 만료되면
        썸네일이 깨질 수 있어 onerror로 썸네일만 숨기고 링크는 남긴다. %>
    <% if (typeof callmanerPhotos !== 'undefined' && callmanerPhotos.length) { %>
      <div class="section-title">🚚 콜마너 탁송사진</div>
      <%# 운행전·운행후를 순번으로 짝지어 나란히 놓는다. 각각 13장을 따로 늘어놓으면 같은 자리를
          비교하려고 눈으로 세어 짝을 찾아야 한다 — 흠집이 언제 생겼는지가 사고 처리의 전부인데
          그걸 손으로 맞추게 두면 안 된다. 짝짓기는 서버가 한다(lib/callmanerPhotos.js
          pairByPhase) — 화면이 다시 세면 Next 화면과 갈린다. %>
      <p class="page-sub" style="margin:4px 0 10px;">
        같은 항목의 <strong>운행전 · 운행후</strong>를 나란히 놓았습니다. 총 <%= callmanerPhotos.length %>장.
      </p>
      <div class="photo-compare">
        <% (typeof callmanerPhotoPairs !== 'undefined' ? callmanerPhotoPairs : []).forEach(function (p) { %>
          <div class="photo-row">
            <div class="photo-label"><%= p.label %></div>
            <div class="photo-pair">
              <% [['start','운행전'], ['end','운행후']].forEach(function (ph) { %>
                <% var shot = p[ph[0]]; %>
                <% if (shot) { %>
                  <a class="photo-cell" href="<%= shot.url %>" target="_blank" rel="noopener">
                    <img src="<%= shot.url %>" alt="<%= p.label %> <%= ph[1] %>" loading="lazy"
                         onerror="this.style.display='none'">
                    <span class="photo-phase"><%= ph[1] %></span>
                  </a>
                <% } else { %>
                  <%# 빠진 자리를 남긴다 — 보여야 "안 찍었다"를 알 수 있다. %>
                  <div class="photo-cell empty"><span><%= ph[1] %> 없음</span></div>
                <% } %>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
      <p class="page-sub" style="margin:10px 0 0;">
        콜마너가 제공하는 링크를 그대로 보여줍니다 — 콜마너 쪽에서 만료되면 열리지 않을 수 있습니다.
      </p>
    <% } %>
    <% } %>

    <%# 실비 영수증 — 사진 바로 아래. 같은 운행에서 나온 근거라 함께 본다.
        금액만 있고 사진이 어디 있는지 모르면 청구를 다투는 자리에서 아무것도 못 한다.
        Next 화면의 같은 카드는 src/app/orders/[id]/ReceiptGallery.js다. %>
    <% var receipts = (typeof receiptCharges !== 'undefined' && receiptCharges) || []; %>
    <% if (receipts.length) { %>
    <div class="card">
      <h2>🧾 실비 영수증</h2>
      <% var waiting = receipts.filter(function (r) { return !(r.receipt && r.receipt.files && r.receipt.files.length); }).length; %>
      <p class="page-sub" style="margin:4px 0 12px;">
        실비 <%= receipts.length %>건<% if (waiting) { %> · <strong>영수증 없음 <%= waiting %>건</strong><% } %>
      </p>
      <div class="receipt-list">
        <% receipts.forEach(function (r) { %>
          <% var files = ((r.receipt && r.receipt.files) || []).map(function (f) { return typeof f === 'string' ? { url: f } : f; })
               .filter(function (f) { return f && f.url; }); %>
          <div class="receipt-row">
            <div class="receipt-head">
              <strong><%= r.charge_type %></strong>
              <span class="receipt-amount"><%= Number(r.amount || 0).toLocaleString('ko-KR') %>원</span>
              <span class="receipt-mode"><%= { included: '요금 포함', monthly: '월정산', individual: '개별정산' }[r.settle_mode] || (r.settle_mode || '') %></span>
              <% if (!r.billable) { %><span class="receipt-mode">청구 안 함</span><% } %>
              <% if (r.charged_on) { %><span class="receipt-date"><%= r.charged_on %></span><% } %>
            </div>
            <% if (r.note) { %><div class="receipt-note"><%= r.note %></div><% } %>
            <% if (files.length) { %>
              <div class="receipt-shots">
                <% files.forEach(function (f, i) { %>
                  <a class="photo-cell" href="<%= f.url %>" target="_blank" rel="noopener">
                    <img src="<%= f.url %>" alt="<%= r.charge_type %> 영수증 <%= i + 1 %>" loading="lazy"
                         onerror="this.style.display='none'">
                  </a>
                <% }) %>
              </div>
            <% } else { %>
              <div class="receipt-missing">영수증이 아직 올라오지 않았습니다.</div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>

  <div>
    <div class="card">
      <h2>VOC 접수</h2>
      <p class="page-sub" style="margin:0 0 10px;">사고 · 과태료 · 클레임을 접수하면 담당자가 확인합니다. 해당 항목을 선택한 뒤 내용을 입력해주세요.</p>
      <form method="POST" action="/orders/<%= order.id %>/voc" id="vocForm">
        <div class="row"><div class="field full">
          <label><input type="checkbox" name="voc_accident" id="vocAccidentCheck" <%= order.voc_accident_note != null ? 'checked' : '' %>> 사고 접수</label>
          <textarea name="voc_accident_note" id="vocAccidentNote" placeholder="사고 내용" style="display:<%= order.voc_accident_note != null ? '' : 'none' %>;"><%= order.voc_accident_note || '' %></textarea>
        </div></div>
        <div class="row"><div class="field full">
          <label><input type="checkbox" name="voc_fine" id="vocFineCheck" <%= order.voc_fine_note != null ? 'checked' : '' %>> 과태료 접수</label>
          <textarea name="voc_fine_note" id="vocFineNote" placeholder="과태료 내용" style="display:<%= order.voc_fine_note != null ? '' : 'none' %>;"><%= order.voc_fine_note || '' %></textarea>
        </div></div>
        <div class="row"><div class="field full">
          <label><input type="checkbox" name="voc_claim" id="vocClaimCheck" <%= order.voc_claim_note != null ? 'checked' : '' %>> 클레임 접수</label>
          <textarea name="voc_claim_note" id="vocClaimNote" placeholder="클레임 내용" style="display:<%= order.voc_claim_note != null ? '' : 'none' %>;"><%= order.voc_claim_note || '' %></textarea>
        </div></div>
        <button class="btn" type="submit">저장</button>
      </form>
      <script>
        (function () {
          [['vocAccidentCheck', 'vocAccidentNote'], ['vocFineCheck', 'vocFineNote'], ['vocClaimCheck', 'vocClaimNote']].forEach(function (pair) {
            var check = document.getElementById(pair[0]);
            var note = document.getElementById(pair[1]);
            if (!check || !note) return;
            check.addEventListener('change', function () {
              note.style.display = check.checked ? '' : 'none';
            });
          });
        })();
      </script>
    </div>

    <% if (currentUser.role !== 'client') { %>
    <%# 요청사항에서 찾은 부대비용 후보 — 기사에게 전달되기 전에 관리자가 고르는 자리.
        법인 고객에게는 접수 화면의 부대비용 입력이 보이지 않아 요청사항 본문이 유일한
        통로다. 자동으로 줄을 만들지 않는 이유는 lib/memoExtraCosts.js에 적어뒀다.
        Next 화면의 같은 카드는 src/app/orders/[id]/MemoExtraCandidates.js다 —
        한쪽만 고치면 플래그를 되돌렸을 때 기능이 사라진다. %>
    <% var memoExtras = (typeof memoExtraCandidates !== 'undefined' && memoExtraCandidates) || []; %>
    <% var memoBillable = memoExtras.filter(function (c) { return c.billable; }); %>
    <% var memoIncluded = memoExtras.filter(function (c) { return !c.billable; }); %>
    <% if (memoExtras.length) { %>
    <div class="card" style="border-color:#c7a008;">
      <h2>요청사항에서 찾은 부대비용 <span style="font-size:12px;font-weight:400;color:#8a6d00;">확인 필요</span></h2>
      <p class="page-sub" style="margin:0 0 10px;">
        고객 요청사항 본문에 적혀 있는데 부대비용 항목으로는 선택되지 않은 것들입니다.
        <b>기사에게 전달되기 전에</b> 확인해 주세요.
      </p>
      <form method="POST" action="/orders/<%= order.id %>/memo-extra">
        <% memoBillable.forEach(function (c) { %>
        <label style="display:block;padding:10px 12px;margin-bottom:8px;border:1px solid #e2e2e2;border-radius:6px;cursor:pointer;">
          <input type="checkbox" name="accept_code" value="<%= c.code %>" checked style="margin-right:8px;">
          <b><%= c.label %></b>
          <%= Number(c.amount) > 0 ? ' ' + Number(c.amount).toLocaleString('ko-KR') + '원' : ' (금액 미정 — 영수증으로 확정)' %>
          <span style="margin-left:8px;font-size:12px;color:#8a6d00;">
            <%= c.settleMode === 'individual' ? '실비 개별정산' : '실비 월정산' %>
          </span>
          <%# 근거를 보여줘야 "왜 이게 잡혔나"를 판단할 수 있다. 요약이 아니라 원문 조각이다. %>
          <div style="margin-top:4px;font-size:12px;color:#666;">요청사항: &ldquo;<%= c.evidence %>&rdquo;</div>
        </label>
        <% }); %>
        <% if (memoIncluded.length) { %>
        <%# 청구는 안 하지만 기사에게는 알려야 한다 — 지시가 안 닿으면 차가 빈 채로 간다. %>
        <div style="padding:10px 12px;margin-bottom:8px;border-radius:6px;background:#f4f4f4;font-size:13px;color:#555;">
          <b>요금에 포함된 항목</b> — 청구하지 않지만 기사에게는 전달됩니다.
          <ul style="margin:6px 0 0;padding-left:18px;">
            <% memoIncluded.forEach(function (c) { %>
            <li><%= c.label %> — 요청사항: &ldquo;<%= c.evidence %>&rdquo;</li>
            <% }); %>
          </ul>
        </div>
        <% } %>
        <button class="btn" type="submit"><%= memoBillable.length ? '선택한 항목 추가' : '확인' %></button>
        <span style="margin-left:10px;font-size:12px;color:#888;">
          체크를 모두 해제하고 눌러도 됩니다 — 그러면 청구하지 않은 것으로 기록됩니다.
        </span>
      </form>
    </div>
    <% } %>

    <%# 기타 정산 내역 — 운행요금과 별도로 거래처에 청구하는 실비다. 고객이 자기 오더의
        청구액을 바꿀 수 있으면 정산이 성립하지 않아 고객에게는 아예 보이지 않는다. %>
    <div class="card">
      <h2>기타 정산 내역</h2>
      <p class="page-sub" style="margin:0 0 10px;">
        주유비 · 주차요금 · 톨게이트비를 넣으면 <b>법인 정산내역</b>에 이 오더가 완료된 달로 잡힙니다.
        <b>별도 청구</b>를 끄면 기록만 남고 정산서에는 올라가지 않습니다.
      </p>
      <form method="POST" action="/orders/<%= order.id %>/extra-charges" id="extraChargeForm">
        <div class="table-wrap">
          <table id="extraChargeTable">
            <thead>
              <tr>
                <th style="width:140px;">일자</th><th style="width:110px;">항목</th>
                <th style="width:110px;">금액</th><th style="width:80px;">별도청구</th>
                <th>비고</th><th></th>
              </tr>
            </thead>
            <tbody id="extraChargeBody">
              <% extraCharges.forEach(function (c, i) { %>
                <tr>
                  <td><input type="date" name="extra_charge_date" value="<%= c.charged_on || order.reserved_date || '' %>"></td>
                  <td>
                    <select name="extra_charge_type">
                      <% extraChargeTypes.forEach(function (t) { %>
                        <option value="<%= t %>" <%= c.charge_type === t ? 'selected' : '' %>><%= t %></option>
                      <% }) %>
                    </select>
                  </td>
                  <td><input type="number" name="extra_charge_amount" value="<%= c.amount %>" min="0" step="100"></td>
                  <%# 체크박스는 체크된 것만 올라오므로 값에 행 번호를 실어 어느 줄인지 가린다. %>
                  <td style="text-align:center;"><input type="checkbox" name="extra_charge_billable" value="<%= i %>" <%= c.billable ? 'checked' : '' %>></td>
                  <td><input type="text" name="extra_charge_note" value="<%= c.note || '' %>" placeholder="예: 서해대교 통행료"></td>
                  <td><button type="button" class="btn small secondary extra-charge-remove">삭제</button></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div style="margin-top:10px;display:flex;gap:8px;">
          <button type="button" class="btn small secondary" id="extraChargeAdd">+ 항목 추가</button>
          <button class="btn" type="submit">저장</button>
        </div>
      </form>
      <script>
        (function () {
          var body = document.getElementById('extraChargeBody');
          var addBtn = document.getElementById('extraChargeAdd');
          var types = <%- JSON.stringify(extraChargeTypes) %>;
          var defaultDate = <%- JSON.stringify(order.reserved_date || '') %>;

          // 별도청구 체크박스의 value는 행 번호다 — 행을 지우면 번호가 밀리므로 매번 다시 매긴다.
          // 이걸 빼먹으면 2번 줄을 지웠을 때 3번 줄의 체크가 엉뚱한 줄에 붙는다.
          function renumber() {
            body.querySelectorAll('tr').forEach(function (row, i) {
              var cb = row.querySelector('input[name="extra_charge_billable"]');
              if (cb) cb.value = String(i);
            });
          }
          function wireRemove(row) {
            row.querySelector('.extra-charge-remove').addEventListener('click', function () {
              row.remove();
              renumber();
            });
          }
          body.querySelectorAll('tr').forEach(wireRemove);

          addBtn.addEventListener('click', function () {
            var row = document.createElement('tr');
            var options = types.map(function (t) { return '<option value="' + t + '">' + t + '</option>'; }).join('');
            row.innerHTML =
              '<td><input type="date" name="extra_charge_date" value="' + defaultDate + '"></td>' +
              '<td><select name="extra_charge_type">' + options + '</select></td>' +
              '<td><input type="number" name="extra_charge_amount" value="0" min="0" step="100"></td>' +
              '<td style="text-align:center;"><input type="checkbox" name="extra_charge_billable" value="" checked></td>' +
              '<td><input type="text" name="extra_charge_note" placeholder="예: 서해대교 통행료"></td>' +
              '<td><button type="button" class="btn small secondary extra-charge-remove">삭제</button></td>';
            body.appendChild(row);
            wireRemove(row);
            renumber();
          });
        })();
      </script>
    </div>

    <div class="card">
      <h2>담당자</h2>
      <% if (order.status === '오더등록') { %>
        <form method="POST" action="/orders/<%= order.id %>/assign-self">
          <button class="btn" type="submit">내가 담당하기</button>
        </form>
      <% } else { %>
        <div class="kv"><span class="k">담당자</span><span><%= order.assigned_agent_name || '미지정' %></span></div>
      <% } %>
    </div>


    <div class="card">
      <h2>🧑‍✈️ 기사 배정</h2>
      <% if (typeof legs !== 'undefined' && legs.length > 0) { %>
        <!-- 구간 릴레이: 구간(leg)마다 다른 기사를 배정할 수 있다. order_legs 마이그레이션
             이후 생성된 오더만 이 화면을 본다 — 그 전 오더는 아래 else 분기(기존 단일
             배정)를 그대로 쓴다. -->
        <form method="POST" action="/orders/<%= order.id %>/legs/drivers">
          <% legs.forEach(function(leg){ %>
            <div class="row" style="align-items:center;">
              <div class="field" style="flex:0 0 auto;min-width:220px;">
                <label>구간 <%= leg.seq %>: <%= leg.fromLabel %> → <%= leg.toLabel %></label>
                <input type="hidden" name="leg_seq" value="<%= leg.seq %>">
                <select name="leg_driver_id">
                  <option value="">미배정</option>
                  <% drivers.forEach(function(d){ %>
                    <option value="<%= d.id %>" <%= String(leg.driverId) === String(d.id) ? 'selected' : '' %>><%= d.name %> (<%= d.phone || '연락처 없음' %>)</option>
                  <% }) %>
                </select>
              </div>
            </div>
          <% }) %>
          <button class="btn" type="submit">구간별 배정 저장</button>
        </form>
      <% } else { %>
        <form method="POST" action="/orders/<%= order.id %>/driver">
          <div class="row">
            <div class="field">
              <label>기사 선택</label>
              <select name="driver_id">
                <option value="">미배정</option>
                <% drivers.forEach(function(d){ %>
                  <option value="<%= d.id %>" <%= String(order.assigned_driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %> (<%= d.phone || '연락처 없음' %>)</option>
                <% }) %>
              </select>
            </div>
          </div>
          <button class="btn" type="submit">배정 저장</button>
        </form>
      <% } %>
      <% if (order.callmaner_driver_name || order.callmaner_driver_phone) { %>
      <!-- 콜마너 쪽에서 실제 배차한 기사 — 위 배정(우리 자체 drivers 테이블)과는 완전히
           별개다. routes/callmanerSync.js가 1분 폴링 + 상태가 배차로 바뀔 때 1회 채운다. -->
      <div class="kv">
        <span class="k">콜마너 배정 기사</span>
        <span><%= order.callmaner_driver_name || '이름 미확인' %><% if (order.callmaner_driver_sabun) { %> (사번 <%= order.callmaner_driver_sabun %>)<% } %><% if (order.callmaner_driver_phone) { %> · <%= order.callmaner_driver_phone %><% } %></span>
      </div>
      <% } %>
      <div class="section-title small">사진 업로드 링크(기사 전달용, 로그인 불필요)</div>
      <%
        // 구간 릴레이 오더는 기사가 여럿이라 링크도 구간마다 따로 준다 — 오더 링크 하나를
        // 셋에게 주면 올라온 사진이 어느 구간 것인지 알 수 없다. 구간이 없는 오더(단일 배정,
        // 옛 오더)는 예전처럼 오더 링크 하나만 보여준다.
        const legLinks = (typeof legs !== 'undefined' ? legs : []).filter(function (l) { return l.photoUploadToken; });
      %>
      <% if (legLinks.length) { %>
        <% legLinks.forEach(function(leg){ %>
          <div class="leg-photo-link">
            <span class="leg-photo-link-label"><%= leg.seq %>구간<% if (leg.driverName) { %> · <%= leg.driverName %><% } %></span>
            <input type="text" class="photo-link-input" readonly value="<%= baseUrl %>/upload/<%= leg.photoUploadToken %>" onclick="this.select()">
          </div>
        <% }) %>
      <% } else { %>
        <input type="text" class="photo-link-input" readonly value="<%= baseUrl %>/upload/<%= order.photo_upload_token %>" onclick="this.select()">
      <% } %>
    </div>

    <div class="card">
      <h2>요금 / 관리자 메모 수정</h2>
      <form method="POST" action="/orders/<%= order.id %>/fare">
        <div class="row">
          <div class="field"><label>요금(원)</label><input type="number" name="fare_amount" value="<%= order.fare_amount %>" min="0" step="1000"></div>
        </div>
        <div class="row"><div class="field full"><label>관리자 메모(내부용)</label><textarea name="memo_admin"><%= order.memo_admin || '' %></textarea></div></div>
        <button class="btn" type="submit">저장</button>
      </form>
    </div>
    <% } %>

    <div class="card">
      <h2>변경 이력</h2>
      <ul class="timeline">
        <% history.forEach(function(h){ %>
          <li>
            <%
              // POST /orders/:id(신규 React 수정 화면)의 필드 수정은 상태를 안 바꾸고
              // old_status=new_status로 이력을 남긴다 — "접수 → 접수"처럼 보이지 않게 구분한다.
              var historyLabel = h.old_status == null ? ('최초 등록: ' + h.new_status)
                : (h.old_status === h.new_status ? '정보 수정' : (h.old_status + ' → ' + h.new_status));
            %>
            <b><%= historyLabel %></b>
            <div class="meta"><%= h.actor_name || '시스템' %> · <%= h.created_at %><% if (h.note) { %> · <%= h.note %><% } %></div>
          </li>
        <% }) %>
      </ul>
    </div>

    <%
      // 고객은 상담원/관리자와 완전히 같은 권한을 가질 수 없다(사용자 확정 사항, routes/orders.js
      // CLIENT_ALLOWED_STATUS_TARGETS와 반드시 같아야 함) — 기사 배정 후에는 아예 막고,
      // 배정 전이라도 대기/취소만 고를 수 있다.
      const isClientRole = currentUser.role === 'client';
      const clientAllowedStatuses = ['대기', '취소'];
      const statusOptions = isClientRole ? clientAllowedStatuses : ORDER_STATUSES;
    %>
    <div class="card">
      <h2>상태 변경</h2>
      <% if (isClientRole && order.hasAssignedDriver) { %>
        <p class="fare-calc-hint">기사님이 이미 배정된 상태입니다. 상태 변경은 상담원 챗봇이나 고객센터를 통해 요청해주세요.</p>
      <% } else { %>
      <form method="POST" action="/orders/<%= order.id %>/status">
        <div class="row">
          <div class="field">
            <label>새 상태</label>
            <select name="status">
              <% statusOptions.forEach(function(s){ %>
                <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label>사유/메모 (선택)</label><input type="text" name="note" placeholder="변경 사유"></div>
        </div>
        <button class="btn" type="submit">상태 변경 저장</button>
      </form>
      <% } %>
    </div>
  </div>
</div>
<% if (order.callmaner_last_error) { %>
<%# data-error-signature 형식은 callmaner-alert.js의 errorSignature()와 맞춰야 한다 — 폴링이
    "이미 화면에 보여주고 있는 실패"인지 판단해 팝업 중복을 피하는 데 쓴다. %>
<div class="callmaner-error-badge" role="alert" data-error-signature="<%= (order.callmaner_last_error_code || '') + '|' + order.callmaner_last_error %>">
  <strong>⚠️ 콜마너 연동 실패</strong>
  <% if (order.callmaner_last_error_code) { %>
  <div class="callmaner-error-code">에러코드 <%= order.callmaner_last_error_code %></div>
  <% } %>
  <div><%= order.callmaner_last_error %></div>
</div>
<% } %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // maxAttempts를 늘린 이유는 src/app/orders/new/OrderForm.js의 같은 폴링 주석 참고
    // (콜마너 타임아웃 10초 > 기본 폴링 창 7.5초).
    if (window.__callmanerAlert) window.__callmanerAlert.poll(<%= order.id %>, { maxAttempts: 10 });
  });
</script>
<%- include('../partials/footer') %>

<%# 기사 위치 폴링. Next 컴포넌트와 같은 규칙(30초, 숨은 탭에서는 멈춤, 오래된 좌표는 밝힘). %>
<% if (order && ['기사배정', '운행시작'].indexOf(order.status) !== -1) { %>
<%# 요청사항 다시 분석 버튼·팝업. Next 화면의 같은 기능은
    src/app/orders/new/MemoReanalyzeButton.js다 — 한쪽만 고치면 플래그를 되돌렸을 때
    기능이 사라진다. %>
<% if (currentUser.role !== 'client') { %><script src="/js/memo-reanalyze.js"></script><% } %>
<script src="//dapi.kakao.com/v2/maps/sdk.js?appkey=<%= process.env.KAKAO_JS_KEY || '' %>"></script>
<script>
(function () {
  var box = document.getElementById('driverLoc');
  if (!box) return;
  var ORDER_ID = box.getAttribute('data-order-id');
  var textEl = document.getElementById('driverLocText');
  var mapEl = document.getElementById('driverLocMap');
  var REASON = {
    not_dispatched: '아직 기사님이 배정되지 않았습니다.',
    not_matched: '아직 기사님이 배정되지 않았습니다.',
    completed: '운행이 완료되어 위치를 표시하지 않습니다.',
    no_fix: '기사님 위치 신호가 아직 잡히지 않았습니다.',
    no_callmaner: '위치 확인을 지원하지 않는 주문입니다.',
    mcp_not_configured: '위치 확인을 지원하지 않는 주문입니다.',
    no_cid: '출발지 연락처가 없어 위치를 조회할 수 없습니다.'
  };
  var map = null, marker = null, drawn = false;

  function pin(p, label, color) {
    if (!p || !p.lat || !p.lon) return;
    var at = new kakao.maps.LatLng(p.lat, p.lon);
    new kakao.maps.Marker({ map: map, position: at });
    new kakao.maps.CustomOverlay({ map: map, position: at, yAnchor: 2.1,
      content: '<div style="background:' + color + ';color:#fff;font-size:11px;padding:2px 6px;border-radius:3px;white-space:nowrap;">' + label + '</div>' });
  }

  function render(d) {
    if (!d || !d.available) {
      mapEl.style.display = 'none';
      textEl.textContent = REASON[d && d.reason] || '기사님 위치를 확인하지 못했습니다.';
      return;
    }
    var bits = [];
    if (d.distanceKm) bits.push('출발지까지 약 ' + d.distanceKm + 'km');
    if (d.etaMinutes) bits.push('약 ' + d.etaMinutes + '분 소요 예상');
    // 오래된 좌표를 "지금 위치"로 보여주면 엉뚱한 곳에서 기다리게 된다.
    textEl.textContent = (bits.length ? bits.join(' · ') : '기사님이 이동 중입니다.')
      + (d.stale && d.ageMinutes != null ? ' (' + d.ageMinutes + '분 전 기준)' : '');
    if (!window.kakao || !kakao.maps || !kakao.maps.Map) return;
    mapEl.style.display = '';
    var pos = new kakao.maps.LatLng(d.lat, d.lon);
    if (!map) map = new kakao.maps.Map(mapEl, { center: pos, level: 5 });
    if (!drawn) { pin(d.origin, '출발', '#2e5c8a'); pin(d.destination, '도착', '#c2410c'); drawn = true; }
    if (!marker) {
      marker = new kakao.maps.Marker({ map: map, position: pos, zIndex: 10 });
      new kakao.maps.CustomOverlay({ map: map, position: pos, yAnchor: 2.1, zIndex: 11,
        content: '<div style="background:#111;color:#fff;font-size:11px;padding:2px 6px;border-radius:3px;white-space:nowrap;">기사님</div>' });
      map.setCenter(pos);
    } else { marker.setPosition(pos); map.panTo(pos); }
  }

  function poll() {
    fetch('/orders/' + ORDER_ID + '/driver-location.json', { credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) { if (d) render(d); })
      .catch(function () {});
  }
  poll();
  var timer = setInterval(poll, 30000);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { clearInterval(timer); timer = null; }
    else if (!timer) { poll(); timer = setInterval(poll, 30000); }
  });
})();
</script>
<% } %>
