<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">
      오더 상세 · <%= order.oid %>
      <% if (order.callmaner_conf_slip) { %>
      <%# 일반 공백은 브라우저가 한 칸으로 접어버리므로(white-space:normal 기본값) &nbsp;로 2칸 확보 %>
      &nbsp;&nbsp;<span class="callmaner-conf-slip">콜마너접수번호 : <%= order.callmaner_conf_slip %></span>
      <% } %>
    </h1>
    <p class="page-sub">
      <span class="badge <%= statusColor(order.status) %>"><%= order.status %></span>
      <%# 나눠 접수한 건이면 몇 건 중 몇 번째인지 밝힌다 — 나누고 나면 두 건이 서로 남남이라,
          이 표시가 없으면 한쪽만 보고 "이게 전부"라고 판단하게 된다. %>
      <% if (order.split_group_id && order.split_total > 1) { %>
        <span class="badge purple">분리접수 <%= order.split_seq %>/<%= order.split_total %>건</span>
      <% } %>
      &nbsp; <%= order.branch_name %> · <%= order.group_name || '-' %> · 등록일시 <%= order.created_at %>
    </p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/orders">&larr; 오더 리스트로</a>
  </div>
</div>

<div class="detail-grid" style="margin-top:18px;">
  <div class="card">
    <h2>📍 이동 경로</h2>
    <div class="kv"><span class="k">출발지</span><span><%= order.origin_address %></span></div>
    <div class="kv"><span class="k">출발지 연락처</span><span><%= order.origin_contact || '-' %></span></div>
    <% waypoints.forEach(function(w, i){ %>
    <% var wLabel = '경유지' + (waypoints.length > 1 ? (' ' + (i + 1)) : ''); %>
    <div class="kv"><span class="k"><%= wLabel %></span><span><%= w.address %></span></div>
    <% if (w.contact_phone || w.vehicle_number) { %>
    <div class="kv"><span class="k"><%= wLabel %> 연락처</span><span><%= w.contact_phone || '-' %></span></div>
    <div class="kv"><span class="k"><%= wLabel %> 차량번호</span><span><%= w.vehicle_number || '-' %></span></div>
    <% } %>
    <% }) %>
    <div class="kv"><span class="k">도착지</span><span><%= order.destination_address %></span></div>
    <div class="kv"><span class="k">도착지 연락처</span><span><%= order.destination_contact || '-' %></span></div>
    <div class="kv"><span class="k">차종 / 차량번호</span><span><%= [order.vehicle_type, order.vehicle_number].filter(Boolean).join(' / ') || '-' %></span></div>
    <div class="kv"><span class="k">예약일시</span><span><%= order.reserved_date %> <%= order.reserved_time %></span></div>
    <div class="kv"><span class="k">결제방식</span><span><%= order.payment_method_name || '-' %></span></div>
    <div class="kv"><span class="k">요금</span><span><%= formatMoney(order.fare_amount) %></span></div>
    <div class="kv"><span class="k">도선료</span><span><%= formatMoney(order.ferry_fare_amount || 0) %></span></div>
    <div class="kv"><span class="k">배정 기사</span><span><%= order.driver_name || '미배정' %></span></div>

    <%
      const orderTypeLabels = { dispatch: '탁송', premium: '프리미엄', daily_driver: '일일기사' };
      const tripTypeLabels = { round_trip: '왕복', one_way: '편도' };
    %>
    <div class="kv"><span class="k">오더 타입</span><span><%= orderTypeLabels[order.order_type] || order.order_type || 'dispatch' %></span></div>
    <% if (order.trip_type) { %>
      <div class="kv"><span class="k">이용 형태</span><span><%= tripTypeLabels[order.trip_type] || order.trip_type %></span></div>
    <% } %>
    <% if (order.destination_wait_minutes != null) { %>
      <div class="kv"><span class="k">도착지 대기시간</span><span><%= order.destination_wait_minutes %>분</span></div>
    <% } %>
    <% if (order.final_destination_address) { %>
      <div class="kv"><span class="k">최종 목적지</span><span><%= order.final_destination_address %><%= order.final_destination_address_detail ? ' ' + order.final_destination_address_detail : '' %></span></div>
    <% } %>

    <div class="section-title">메모</div>
    <div class="kv"><span class="k">고객사 메모</span><span><%= order.memo_customer || '작성된 메모가 없습니다.' %></span></div>
    <div class="kv"><span class="k">업체요청사항</span><span><%= order.memo_billing || '작성된 내용이 없습니다.' %></span></div>
    <div class="kv"><span class="k">관리자 메모</span><span><%= order.memo_admin || '작성된 메모가 없습니다.' %></span></div>

    <% if (canViewPhotos) { %>
    <div class="section-title">📷 기사 업로드 사진</div>
    <% if (photos.length === 0) { %>
      <p class="page-sub" style="margin:0;">업로드된 사진이 없습니다.</p>
    <% } else { %>
      <div class="upload-gallery">
        <% photos.forEach(function(p){ %>
          <%# 구간 링크로 올라온 사진은 어느 구간인지 표시한다 — 인수 시점과 인도 시점 사진이
              섞이면 분쟁 때 어느 쪽 증빙인지 가릴 수 없다. %>
          <a href="<%= p.url %>" target="_blank" class="upload-photo-item">
            <img src="<%= p.url %>" alt="업로드된 사진">
            <% if (p.leg_seq) { %><span class="upload-photo-leg"><%= p.leg_seq %>구간</span><% } %>
          </a>
        <% }) %>
      </div>
      <%
        // 기사가 계기판 사진과 함께 적어둔 값. 사진을 열어 숫자를 읽지 않아도 되도록 여기 요약한다.
        // 같은 계산을 챗봇도 쓴다(lib/kakaoOrderPhotos.js의 summarizeOdometer).
        const odometerValues = photos.map(function (p) { return Number(p.odometer_km); })
          .filter(function (v) { return Number.isFinite(v) && v > 0; })
          .sort(function (a, b) { return a - b; });
      %>
      <% if (odometerValues.length) { %>
        <p class="page-sub" style="margin:8px 0 0;">
          계기판 <%= odometerValues[0].toLocaleString('ko-KR') %>km
          <% if (odometerValues.length > 1) { %>
            → <%= odometerValues[odometerValues.length - 1].toLocaleString('ko-KR') %>km
            (주행 <%= (odometerValues[odometerValues.length - 1] - odometerValues[0]).toLocaleString('ko-KR') %>km)
          <% } %>
        </p>
      <% } %>
    <% } %>

    <%# 콜마너 탁송사진 — 기사 업로드 사진과 별도다(외부 CDN 링크만 보관). 링크가 만료되면
        썸네일이 깨질 수 있어 onerror로 썸네일만 숨기고 링크는 남긴다. %>
    <% if (typeof callmanerPhotos !== 'undefined' && callmanerPhotos.length) { %>
      <div class="section-title">🚚 콜마너 탁송사진</div>
      <% ['start', 'end'].forEach(function (phase) { %>
        <% const rows = callmanerPhotos.filter(function (p) { return p.phase === phase; }); %>
        <% if (rows.length) { %>
          <p class="page-sub" style="margin:6px 0 4px;">
            <strong><%= phase === 'start' ? '운행전' : '운행후' %></strong> <%= rows.length %>장
          </p>
          <div class="callmaner-gallery">
            <% rows.forEach(function (p) { %>
              <a href="<%= p.url %>" target="_blank" rel="noopener" class="upload-photo-item">
                <img src="<%= p.url %>" alt="<%= phase === 'start' ? '운행전' : '운행후' %> <%= p.seq %>번째 사진"
                     onerror="this.style.display='none'">
                <span class="upload-photo-leg"><%= p.seq %></span>
              </a>
            <% }) %>
          </div>
        <% } %>
      <% }) %>
      <p class="page-sub" style="margin:8px 0 0;">
        콜마너가 제공하는 링크를 그대로 보여줍니다 — 콜마너 쪽에서 만료되면 열리지 않을 수 있습니다.
      </p>
    <% } %>
    <% } %>
  </div>

  <div>
    <div class="card">
      <h2>VOC 접수</h2>
      <p class="page-sub" style="margin:0 0 10px;">사고 · 과태료 · 클레임을 접수하면 담당자가 확인합니다. 해당 항목을 선택한 뒤 내용을 입력해주세요.</p>
      <form method="POST" action="/orders/<%= order.id %>/voc" id="vocForm">
        <div class="row"><div class="field full">
          <label><input type="checkbox" name="voc_accident" id="vocAccidentCheck" <%= order.voc_accident_note != null ? 'checked' : '' %>> 사고 접수</label>
          <textarea name="voc_accident_note" id="vocAccidentNote" placeholder="사고 내용" style="display:<%= order.voc_accident_note != null ? '' : 'none' %>;"><%= order.voc_accident_note || '' %></textarea>
        </div></div>
        <div class="row"><div class="field full">
          <label><input type="checkbox" name="voc_fine" id="vocFineCheck" <%= order.voc_fine_note != null ? 'checked' : '' %>> 과태료 접수</label>
          <textarea name="voc_fine_note" id="vocFineNote" placeholder="과태료 내용" style="display:<%= order.voc_fine_note != null ? '' : 'none' %>;"><%= order.voc_fine_note || '' %></textarea>
        </div></div>
        <div class="row"><div class="field full">
          <label><input type="checkbox" name="voc_claim" id="vocClaimCheck" <%= order.voc_claim_note != null ? 'checked' : '' %>> 클레임 접수</label>
          <textarea name="voc_claim_note" id="vocClaimNote" placeholder="클레임 내용" style="display:<%= order.voc_claim_note != null ? '' : 'none' %>;"><%= order.voc_claim_note || '' %></textarea>
        </div></div>
        <button class="btn" type="submit">저장</button>
      </form>
      <script>
        (function () {
          [['vocAccidentCheck', 'vocAccidentNote'], ['vocFineCheck', 'vocFineNote'], ['vocClaimCheck', 'vocClaimNote']].forEach(function (pair) {
            var check = document.getElementById(pair[0]);
            var note = document.getElementById(pair[1]);
            if (!check || !note) return;
            check.addEventListener('change', function () {
              note.style.display = check.checked ? '' : 'none';
            });
          });
        })();
      </script>
    </div>

    <% if (currentUser.role !== 'client') { %>
    <div class="card">
      <h2>담당자</h2>
      <% if (order.status === '오더등록') { %>
        <form method="POST" action="/orders/<%= order.id %>/assign-self">
          <button class="btn" type="submit">내가 담당하기</button>
        </form>
      <% } else { %>
        <div class="kv"><span class="k">담당자</span><span><%= order.assigned_agent_name || '미지정' %></span></div>
      <% } %>
    </div>


    <div class="card">
      <h2>🧑‍✈️ 기사 배정</h2>
      <% if (typeof legs !== 'undefined' && legs.length > 0) { %>
        <!-- 구간 릴레이: 구간(leg)마다 다른 기사를 배정할 수 있다. order_legs 마이그레이션
             이후 생성된 오더만 이 화면을 본다 — 그 전 오더는 아래 else 분기(기존 단일
             배정)를 그대로 쓴다. -->
        <form method="POST" action="/orders/<%= order.id %>/legs/drivers">
          <% legs.forEach(function(leg){ %>
            <div class="row" style="align-items:center;">
              <div class="field" style="flex:0 0 auto;min-width:220px;">
                <label>구간 <%= leg.seq %>: <%= leg.fromLabel %> → <%= leg.toLabel %></label>
                <input type="hidden" name="leg_seq" value="<%= leg.seq %>">
                <select name="leg_driver_id">
                  <option value="">미배정</option>
                  <% drivers.forEach(function(d){ %>
                    <option value="<%= d.id %>" <%= String(leg.driverId) === String(d.id) ? 'selected' : '' %>><%= d.name %> (<%= d.phone || '연락처 없음' %>)</option>
                  <% }) %>
                </select>
              </div>
            </div>
          <% }) %>
          <button class="btn" type="submit">구간별 배정 저장</button>
        </form>
      <% } else { %>
        <form method="POST" action="/orders/<%= order.id %>/driver">
          <div class="row">
            <div class="field">
              <label>기사 선택</label>
              <select name="driver_id">
                <option value="">미배정</option>
                <% drivers.forEach(function(d){ %>
                  <option value="<%= d.id %>" <%= String(order.assigned_driver_id) === String(d.id) ? 'selected' : '' %>><%= d.name %> (<%= d.phone || '연락처 없음' %>)</option>
                <% }) %>
              </select>
            </div>
          </div>
          <button class="btn" type="submit">배정 저장</button>
        </form>
      <% } %>
      <% if (order.callmaner_driver_name || order.callmaner_driver_phone) { %>
      <!-- 콜마너 쪽에서 실제 배차한 기사 — 위 배정(우리 자체 drivers 테이블)과는 완전히
           별개다. routes/callmanerSync.js가 1분 폴링 + 상태가 배차로 바뀔 때 1회 채운다. -->
      <div class="kv">
        <span class="k">콜마너 배정 기사</span>
        <span><%= order.callmaner_driver_name || '이름 미확인' %><% if (order.callmaner_driver_sabun) { %> (사번 <%= order.callmaner_driver_sabun %>)<% } %><% if (order.callmaner_driver_phone) { %> · <%= order.callmaner_driver_phone %><% } %></span>
      </div>
      <% } %>
      <div class="section-title small">사진 업로드 링크(기사 전달용, 로그인 불필요)</div>
      <%
        // 구간 릴레이 오더는 기사가 여럿이라 링크도 구간마다 따로 준다 — 오더 링크 하나를
        // 셋에게 주면 올라온 사진이 어느 구간 것인지 알 수 없다. 구간이 없는 오더(단일 배정,
        // 옛 오더)는 예전처럼 오더 링크 하나만 보여준다.
        const legLinks = (typeof legs !== 'undefined' ? legs : []).filter(function (l) { return l.photoUploadToken; });
      %>
      <% if (legLinks.length) { %>
        <% legLinks.forEach(function(leg){ %>
          <div class="leg-photo-link">
            <span class="leg-photo-link-label"><%= leg.seq %>구간<% if (leg.driverName) { %> · <%= leg.driverName %><% } %></span>
            <input type="text" class="photo-link-input" readonly value="<%= baseUrl %>/upload/<%= leg.photoUploadToken %>" onclick="this.select()">
          </div>
        <% }) %>
      <% } else { %>
        <input type="text" class="photo-link-input" readonly value="<%= baseUrl %>/upload/<%= order.photo_upload_token %>" onclick="this.select()">
      <% } %>
    </div>

    <div class="card">
      <h2>요금 / 관리자 메모 수정</h2>
      <form method="POST" action="/orders/<%= order.id %>/fare">
        <div class="row">
          <div class="field"><label>요금(원)</label><input type="number" name="fare_amount" value="<%= order.fare_amount %>" min="0" step="1000"></div>
        </div>
        <div class="row"><div class="field full"><label>관리자 메모(내부용)</label><textarea name="memo_admin"><%= order.memo_admin || '' %></textarea></div></div>
        <button class="btn" type="submit">저장</button>
      </form>
    </div>
    <% } %>

    <div class="card">
      <h2>변경 이력</h2>
      <ul class="timeline">
        <% history.forEach(function(h){ %>
          <li>
            <%
              // POST /orders/:id(신규 React 수정 화면)의 필드 수정은 상태를 안 바꾸고
              // old_status=new_status로 이력을 남긴다 — "접수 → 접수"처럼 보이지 않게 구분한다.
              var historyLabel = h.old_status == null ? ('최초 등록: ' + h.new_status)
                : (h.old_status === h.new_status ? '정보 수정' : (h.old_status + ' → ' + h.new_status));
            %>
            <b><%= historyLabel %></b>
            <div class="meta"><%= h.actor_name || '시스템' %> · <%= h.created_at %><% if (h.note) { %> · <%= h.note %><% } %></div>
          </li>
        <% }) %>
      </ul>
    </div>

    <%
      // 고객은 상담원/관리자와 완전히 같은 권한을 가질 수 없다(사용자 확정 사항, routes/orders.js
      // CLIENT_ALLOWED_STATUS_TARGETS와 반드시 같아야 함) — 기사 배정 후에는 아예 막고,
      // 배정 전이라도 대기/취소만 고를 수 있다.
      const isClientRole = currentUser.role === 'client';
      const clientAllowedStatuses = ['대기', '취소'];
      const statusOptions = isClientRole ? clientAllowedStatuses : ORDER_STATUSES;
    %>
    <div class="card">
      <h2>상태 변경</h2>
      <% if (isClientRole && order.hasAssignedDriver) { %>
        <p class="fare-calc-hint">기사님이 이미 배정된 상태입니다. 상태 변경은 상담원 챗봇이나 고객센터를 통해 요청해주세요.</p>
      <% } else { %>
      <form method="POST" action="/orders/<%= order.id %>/status">
        <div class="row">
          <div class="field">
            <label>새 상태</label>
            <select name="status">
              <% statusOptions.forEach(function(s){ %>
                <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label>사유/메모 (선택)</label><input type="text" name="note" placeholder="변경 사유"></div>
        </div>
        <button class="btn" type="submit">상태 변경 저장</button>
      </form>
      <% } %>
    </div>
  </div>
</div>
<% if (order.callmaner_last_error) { %>
<%# data-error-signature 형식은 callmaner-alert.js의 errorSignature()와 맞춰야 한다 — 폴링이
    "이미 화면에 보여주고 있는 실패"인지 판단해 팝업 중복을 피하는 데 쓴다. %>
<div class="callmaner-error-badge" role="alert" data-error-signature="<%= (order.callmaner_last_error_code || '') + '|' + order.callmaner_last_error %>">
  <strong>⚠️ 콜마너 연동 실패</strong>
  <% if (order.callmaner_last_error_code) { %>
  <div class="callmaner-error-code">에러코드 <%= order.callmaner_last_error_code %></div>
  <% } %>
  <div><%= order.callmaner_last_error %></div>
</div>
<% } %>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // maxAttempts를 늘린 이유는 src/app/orders/new/OrderForm.js의 같은 폴링 주석 참고
    // (콜마너 타임아웃 10초 > 기본 폴링 창 7.5초).
    if (window.__callmanerAlert) window.__callmanerAlert.poll(<%= order.id %>, { maxAttempts: 10 });
  });
</script>
<%- include('../partials/footer') %>
