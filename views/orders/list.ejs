<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">오더 리스트</h1>
    <p class="page-sub">등록된 오더를 조회하고 상태를 관리합니다. 컬럼 표시/순서/너비/행간격은 이 브라우저에만 저장됩니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn" href="/orders/new">+ 오더 등록</a>
  </div>
</div>

<form class="filters card" method="GET" action="/orders">
  <% if (currentUser.role === 'admin') { %>
  <div class="field">
    <label>지사</label>
    <select name="branch_id">
      <option value="">전체 지사</option>
      <% branches.forEach(function(b){ %>
        <option value="<%= b.id %>" <%= String(filters.branch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
      <% }) %>
    </select>
  </div>
  <% } %>
  <div class="field">
    <label>상태</label>
    <select name="status">
      <option value="">전체 상태</option>
      <% ORDER_STATUSES.forEach(function(s){ %>
        <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
  </div>
  <div class="field"><label>시작일</label><input type="date" name="from" value="<%= filters.from %>"></div>
  <div class="field"><label>종료일</label><input type="date" name="to" value="<%= filters.to %>"></div>
  <div class="field"><label>검색(OID/주소)</label><input type="text" name="q" value="<%= filters.q %>" placeholder="OID, 출발지, 도착지"></div>
  <div class="field filter-actions">
    <a class="btn small secondary" href="/orders">초기화</a>
    <button class="btn" type="submit">조회</button>
  </div>
</form>

<div style="margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
  <div>
    <% if (filters.branch_id) { %><span class="chip">지사 필터 적용중</span><% } else { %><span class="chip">전체 지사 표시중</span><% } %>
    <% if (filters.status) { %><span class="chip">상태: <%= filters.status %></span><% } %>
    <% if (filters.from || filters.to) { %><span class="chip">기간: <%= filters.from || '전체' %> ~ <%= filters.to || '전체' %></span><% } %>
    <span class="chip">총 <%= statusSummary.total %>건</span>
    <span class="chip">오더등록 <%= statusSummary.registered %>건</span>
    <span class="chip">완료 <%= statusSummary.completed %>건</span>
    <span class="chip">대기 <%= statusSummary.pending %>건</span>
    <span class="chip">취소 <%= statusSummary.cancelled %>건</span>
    <span class="chip">문의 <%= statusSummary.inquiry %>건</span>
  </div>
  <button class="btn secondary" type="button" id="columnSettingsBtn">⚙️ 항목 설정</button>
</div>

<div id="columnSettingsPanel" class="card column-settings-panel" style="display:none;">
  <div class="section-title small">표시할 항목 (체크 해제하면 표에서 숨겨집니다. 표 헤더를 드래그하면 순서를, 헤더 오른쪽 경계를 드래그하면 너비를 바꿀 수 있습니다.)</div>
  <div id="columnCheckboxes" class="column-checkbox-grid"></div>
  <div class="section-title small">행 간격</div>
  <div class="row-density-buttons">
    <button type="button" class="btn small secondary" data-density="compact">좁게</button>
    <button type="button" class="btn small secondary" data-density="normal">보통</button>
    <button type="button" class="btn small secondary" data-density="comfortable">넓게</button>
  </div>
  <div style="margin-top:14px;">
    <button type="button" class="btn small secondary" id="columnResetBtn">기본값으로 초기화</button>
  </div>
</div>

<section class="card list-section-card">
  <div class="table-wrap">
  <table id="ordersTable">
    <thead>
      <tr>
        <th data-column="oid">OID</th>
        <th data-column="branch">지사</th>
        <th data-column="group">요청 법인</th>
        <th data-column="group_phone">대표번호</th>
        <th data-column="origin">출발지</th>
        <th data-column="waypoints">경유지</th>
        <th data-column="destination">도착지</th>
        <th data-column="vehicle">차종 / 차량번호</th>
        <th data-column="driver">기사정보</th>
        <th data-column="reserved_at">예약일시</th>
        <th data-column="payment_method">결제방식</th>
        <th data-column="fare">요금</th>
        <th data-column="status">상태</th>
        <th data-column="photo">사진</th>
        <th data-column="created_at">등록일시</th>
      </tr>
    </thead>
    <tbody>
      <% if (orders.length === 0) { %>
        <tr><td colspan="15" class="empty">조건에 맞는 오더가 없습니다.</td></tr>
      <% } %>
      <% orders.forEach(function(o){ %>
        <%
          // 구간 릴레이: leg_count > 0이면(order_legs 마이그레이션 이후 생성된 오더)
          // "N/M명 배정" 요약으로, 아니면(레거시 오더) 기존 단일 기사 표시 그대로.
          var driverLabel = Number(o.leg_count) > 0
            ? '기사 ' + o.legs_assigned_count + '/' + o.leg_count + '명 배정' + (o.leg_driver_names ? ' (' + o.leg_driver_names + ')' : '')
            : (o.driver_name ? (o.driver_name + (o.driver_phone ? ' (' + o.driver_phone + ')' : '')) : '미배정');
        %>
        <tr onclick="location.href='/orders/<%= o.id %>'" style="cursor:pointer;">
          <td data-column="oid" data-label="OID"><a href="/orders/<%= o.id %>"><%= o.oid %></a></td>
          <td data-column="branch" data-label="지사" title="<%= o.branch_name %>"><%= o.branch_name %></td>
          <td data-column="group" data-label="요청 법인" title="<%= o.group_name || '-' %>"><%= o.group_name || '-' %></td>
          <td data-column="group_phone" data-label="대표번호" title="<%= o.group_phone || '-' %>"><%= o.group_phone || '-' %></td>
          <td data-column="origin" data-label="출발지" title="<%= o.origin_address %>"><%= o.origin_address %></td>
          <td data-column="waypoints" data-label="경유지" title="<%= o.waypoints_text || '' %>"><%= o.waypoints_text || '-' %></td>
          <td data-column="destination" data-label="도착지" title="<%= o.destination_address %>"><%= o.destination_address %></td>
          <td data-column="vehicle" data-label="차종 / 차량번호" title="<%= [o.vehicle_type, o.vehicle_number].filter(Boolean).join(' / ') || '-' %>"><%= [o.vehicle_type, o.vehicle_number].filter(Boolean).join(' / ') || '-' %></td>
          <td data-column="driver" data-label="기사정보" title="<%= driverLabel %>"><%= driverLabel %></td>
          <td data-column="reserved_at" data-label="예약일시" title="<%= o.reserved_date %> <%= o.reserved_time %>"><%= o.reserved_date %> <%= o.reserved_time %></td>
          <td data-column="payment_method" data-label="결제방식" title="<%= o.payment_method_name || '-' %>"><%= o.payment_method_name || '-' %></td>
          <td data-column="fare" data-label="요금"><%= formatMoney(o.fare_amount) %></td>
          <td data-column="status" data-label="상태"><span class="badge <%= statusColor(o.status) %>"><%= o.status %></span></td>
          <td data-column="photo" data-label="사진"><%= Number(o.photo_count) > 0 ? ('📷 ' + o.photo_count) : '-' %></td>
          <td data-column="created_at" data-label="등록일시" title="<%= o.created_at %>"><%= String(o.created_at || '').slice(0, 16) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% if (pagination.totalPages > 1) { %>
    <%
      const pageHref = (p) => {
        const qp = new URLSearchParams();
        if (filters.branch_id) qp.set('branch_id', filters.branch_id);
        if (filters.status) qp.set('status', filters.status);
        if (filters.from) qp.set('from', filters.from);
        if (filters.to) qp.set('to', filters.to);
        if (filters.q) qp.set('q', filters.q);
        qp.set('page', p);
        return '/orders?' + qp.toString();
      };
    %>
    <div class="pagination-bar">
      <% if (pagination.page > 1) { %>
        <a class="btn small secondary" href="<%= pageHref(pagination.page - 1) %>">‹ 이전</a>
      <% } else { %>
        <span class="btn small secondary disabled">‹ 이전</span>
      <% } %>
      <span class="pagination-info"><%= pagination.page %> / <%= pagination.totalPages %> 페이지</span>
      <% if (pagination.page < pagination.totalPages) { %>
        <a class="btn small secondary" href="<%= pageHref(pagination.page + 1) %>">다음 ›</a>
      <% } else { %>
        <span class="btn small secondary disabled">다음 ›</span>
      <% } %>
    </div>
  <% } %>
</section>
<script src="/js/order-list-columns.js"></script>
<%- include('../partials/footer') %>
