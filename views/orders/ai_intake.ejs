<%- include('../partials/header') %>
<div class="page-head-row page-heading">
  <div>
    <h1 class="page-title">AI 챗봇</h1>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<%
  const intakeNow = new Date();
  const intakeYearBase = intakeNow.getFullYear();
  const intakeReservedDate = order.reserved_date || '';
  const intakeReservedYear = /^\d{4}-\d{2}-\d{2}$/.test(intakeReservedDate) ? intakeReservedDate.slice(0, 4) : String(intakeYearBase);
  const intakeReservedMonth = /^\d{4}-\d{2}-\d{2}$/.test(intakeReservedDate) ? intakeReservedDate.slice(5, 7) : String(intakeNow.getMonth() + 1).padStart(2, '0');
  const intakeReservedDay = /^\d{4}-\d{2}-\d{2}$/.test(intakeReservedDate) ? intakeReservedDate.slice(8, 10) : String(intakeNow.getDate()).padStart(2, '0');
%>

<form id="orderForm" method="POST" action="/orders" data-my-phone="<%= currentUser.phone || '' %>" data-my-role="<%= currentUser.role %>">
  <div class="ai-intake-grid">

    <div class="card ai-chat-card ai-intake-scroll-panel">
      <div class="ai-chat-header">
        <button type="button" class="ai-chat-menu-btn" id="aiChatMenuBtn" aria-haspopup="true" aria-expanded="false">
          <span class="hamburger-icon"><span></span><span></span></span>
          <span class="ai-chat-title">🤖 AI 챗봇 + 👤 상담원 채팅</span>
        </button>
        <div class="ai-chat-connection" id="aiChatConnection" aria-live="polite">
          <span class="ai-chat-connection-dot" id="aiChatConnectionDot" aria-hidden="true"></span>
          <span class="ai-chat-connection-text" id="aiChatConnectionText">AI 연결 확인중</span>
        </div>
        <div class="ai-chat-menu-panel" id="aiChatMenuPanel" style="display:none;">
          <button type="button" class="ai-chat-menu-item" id="aiNewChatBtn">🆕 <span>새 채팅</span></button>
          <button type="button" class="ai-chat-menu-item" id="aiChatSearchToggleBtn">🔍 <span>검색</span></button>
          <div class="ai-chat-search-row" id="aiChatSearchRow" style="display:none;">
            <input type="text" id="aiChatSearchInput" placeholder="채팅 검색">
          </div>
          <div class="ai-chat-recent-label">최근 항목</div>
          <div class="ai-chat-recent-list" id="aiChatRecentList"></div>
        </div>
      </div>
      <div class="ai-chat-messages" id="aiChatMessages">
        <div class="ai-chat-bubble ai-bot">오더접수 내용을 붙여넣거나, 궁금하신 점을 질문해주세요.</div>
      </div>
      <div class="ai-quick-replies" id="aiQuickReplies" style="display:none;"></div>
      <div class="ai-chat-input-row">
        <textarea id="aiIntakeText" placeholder="예) 내일 13시 출발 / 출: 강남역 010-1111-2222 / 경: 마포역 010-2222-3333 / 도: 도곡역 010-3333-4444 / 12가3456"></textarea>
        <button type="button" class="ai-favorite-btn" id="aiFavoriteBtn" aria-label="즐겨찾기 주소 사용" title="즐겨찾기 주소 사용">⭐</button>
        <button type="button" class="ai-send-btn" id="aiSendBtn" aria-label="메시지 전송" title="메시지 전송" disabled>↑</button>
      </div>
    </div>

    <div class="card ai-intake-order-card ai-intake-scroll-panel">
      <div class="page-head-row" style="margin-bottom:8px;">
        <div class="section-title" style="margin:0;">📋 오더 접수 내용 <span id="orderTypeBadge" class="order-type-badge" style="display:none;"></span></div>
        <span class="requester-badge">요청자: <%= currentUser.name %> <%= currentUser.phone || '' %></span>
      </div>

      <div class="ai-intake-section section-schedule">
        <div class="inline-duo" style="margin-bottom:8px; align-items:center;">
          <label class="checkline"><input type="radio" name="reservation_basis" id="reservation_basis_pickup" value="pickup" <%= order.reservation_basis === 'delivery' ? '' : 'checked' %>> 출발지 픽업시간 기준</label>
          <label class="checkline"><input type="radio" name="reservation_basis" id="reservation_basis_delivery" value="delivery" <%= order.reservation_basis === 'delivery' ? 'checked' : '' %>> 도착지 인도시간 기준</label>
        </div>
        <div class="row">
          <div class="field">
            <label id="reservationDateTimeLabel" class="field-label-strong">예약일시 <span class="required-mark" aria-hidden="true">*</span></label>
            <div class="inline-duo reservation-date-row">
              <select id="reserved_date_year" required class="date-select" aria-label="예약 연도">
                <% for (let y = intakeYearBase - 1; y <= intakeYearBase + 3; y++) { const yy = String(y); %>
                  <option value="<%= yy %>" <%= intakeReservedYear === yy ? 'selected' : '' %>><%= yy %>년</option>
                <% } %>
              </select>
              <select id="reserved_date_month" required class="date-select" aria-label="예약 월">
                <% for (let m = 1; m <= 12; m++) { const mm = String(m).padStart(2, '0'); %>
                  <option value="<%= mm %>" <%= intakeReservedMonth === mm ? 'selected' : '' %>><%= mm %>월</option>
                <% } %>
              </select>
              <select id="reserved_date_day" required class="date-select" aria-label="예약 일">
                <% for (let d = 1; d <= 31; d++) { const dd = String(d).padStart(2, '0'); %>
                  <option value="<%= dd %>" <%= intakeReservedDay === dd ? 'selected' : '' %>><%= dd %>일</option>
                <% } %>
              </select>
            </div>
          </div>
          <div class="field">
            <label class="field-label-strong">예약 시간 <span class="required-mark" aria-hidden="true">*</span></label>
            <div class="inline-duo reservation-datetime-row">
              <select name="reserved_time_hour" id="reserved_time_hour" required class="time-select">
                <% for (let h = 0; h < 24; h++) { %>
                  <% const hh = String(h).padStart(2, '0'); %>
                  <option value="<%= hh %>" <%= (order.reserved_time || '').slice(0, 2) === hh ? 'selected' : '' %>><%= hh %>시</option>
                <% } %>
              </select>
              <select name="reserved_time_minute" id="reserved_time_minute" required class="time-select">
                <% ['00', '10', '20', '30', '40', '50'].forEach(function (mm) { %>
                  <option value="<%= mm %>" <%= (order.reserved_time || '').slice(3, 5) === mm ? 'selected' : '' %>><%= mm %>분</option>
                <% }) %>
              </select>
              <input type="hidden" name="reserved_date" id="reserved_date" required value="<%= order.reserved_date || '' %>">
              <input type="hidden" name="reserved_time" id="reserved_time" value="<%= order.reserved_time || '' %>">
              <input type="hidden" name="pickup_reserved_date" id="pickup_reserved_date" value="<%= order.pickup_reserved_date || '' %>">
              <input type="hidden" name="pickup_reserved_time" id="pickup_reserved_time" value="<%= order.pickup_reserved_time || '' %>">
            </div>
          </div>
        </div>
      </div>

      <div class="ai-intake-section section-origin">
        <div class="field full">
          <div class="field-label-row">
            <label class="field-label-strong">출발지 주소 <span class="required-mark" aria-hidden="true">*</span> <span class="confirm-badge" id="originConfirmBadge">✓ 지도확정</span></label>
            <label class="checkline"><input type="checkbox" class="direct-input-toggle" data-target="origin_address"> 직접 입력 (주소 검색 안됨)</label>
          </div>
          <div class="addr-input-row">
            <input type="text" class="addr-input" id="origin_address" name="origin_address" required placeholder="도로명, 지번 또는 상호명으로 검색" value="<%= order.origin_address || '' %>">
            <button type="button" class="btn small secondary addr-search-btn" data-target="origin_address">🔍 검색</button>
            <button type="button" class="btn small secondary map-view-btn" data-slot="origin" title="지도보기">지도보기</button>
          </div>
          <div id="origin_address_results" class="addr-results"></div>
          <div class="addr-detail-row">
            <input type="text" class="addr-detail-input" id="origin_detail_address" name="origin_detail_address" placeholder="상세주소 입력 (건물명, 동/호수)" <%= order.origin_detail_address ? '' : 'disabled' %> value="<%= order.origin_detail_address || '' %>">
            <button type="button" class="btn small secondary registered-addr-btn" data-target="origin_address">등록주소</button>
          </div>
          <div class="row contact-check-row" style="margin-top:8px;">
            <div class="field" style="max-width:220px;"><label class="field-label-strong">출발지 연락처 <span class="required-mark" aria-hidden="true">*</span></label><input type="text" class="phone-input" id="origin_contact" name="origin_contact" placeholder="010-0000-0000" value="<%= order.origin_contact || '' %>"></div>
            <label class="checkline"><input type="checkbox" id="sameAsMyPhone"> 요청자(본인) 연락처와 동일</label>
          </div>
          <div class="row" style="margin-top:8px;">
            <div id="pickupPreviewBlock" class="field full" style="display:none; margin-bottom:0;">
              <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap; font-size:12px; line-height:1.5; color:var(--navy); font-weight:800;">
                <span>출발지 픽업시간 <span class="required-mark" aria-hidden="true">*</span></span>
                <span id="pickupPreviewValue">-</span>
                <span id="deliveryRouteFormulaPreview" style="font-size:10px; color:var(--muted); font-weight:500;">(경로탐색 : -)</span>
              </div>
            </div>
          </div>
          <div class="row" style="margin-top:8px;">
            <div class="field"><label class="field-label-strong">차종<span class="required-mark" id="vehicleTypeRequiredMark" aria-hidden="true" style="display:none;"> *</span> (<span id="vehicleTypeOptionalText">선택</span>)</label><input type="text" id="vehicle_type" name="vehicle_type" placeholder="예: 카니발, 그랜저, 1톤" value="<%= order.vehicle_type || '' %>" autocomplete="off"><div id="vehicle_type_results" class="addr-results"></div></div>
            <div class="field"><label class="field-label-strong">출발지 차량번호 (선택)</label><input type="text" id="vehicle_number" name="vehicle_number" placeholder="예: 12가3456" value="<%= order.vehicle_number || '' %>"></div>
          </div>
        </div>
      </div>

      <div id="waypointsWrap"></div>
      <button type="button" class="btn small secondary" id="addWaypointBtn">+ 경유지 추가</button>

      <div class="ai-intake-section section-destination" style="margin-top:10px;">
        <div class="field full">
          <div class="field-label-row">
            <label class="field-label-strong">도착지 주소 <span class="required-mark" aria-hidden="true">*</span> <span class="confirm-badge" id="destinationConfirmBadge">✓ 지도확정</span></label>
            <label class="checkline"><input type="checkbox" class="direct-input-toggle" data-target="destination_address"> 직접 입력 (주소 검색 안됨)</label>
          </div>
          <div class="addr-input-row">
            <input type="text" class="addr-input" id="destination_address" name="destination_address" required placeholder="도로명, 지번 또는 상호명으로 검색" value="<%= order.destination_address || '' %>">
            <button type="button" class="btn small secondary addr-search-btn" data-target="destination_address">🔍 검색</button>
            <button type="button" class="btn small secondary map-view-btn" data-slot="destination" title="지도보기">지도보기</button>
          </div>
          <div id="destination_address_results" class="addr-results"></div>
          <div class="addr-detail-row">
            <input type="text" class="addr-detail-input" id="destination_detail_address" name="destination_detail_address" placeholder="상세주소 입력 (건물명, 동/호수)" <%= order.destination_detail_address ? '' : 'disabled' %> value="<%= order.destination_detail_address || '' %>">
            <button type="button" class="btn small secondary registered-addr-btn" data-target="destination_address">등록주소</button>
          </div>
          <div class="field" style="margin-top:8px;">
            <label class="field-label-strong">도착지 연락처 <span class="required-mark" aria-hidden="true">*</span></label>
            <input type="text" class="phone-input" id="destination_contact" name="destination_contact" placeholder="010-0000-0000" value="<%= order.destination_contact || '' %>">
          </div>
          <label class="checkline"><input type="checkbox" id="sameAsOriginContact"> 출발지 연락처와 동일</label>
        </div>
      </div>

      <div class="ai-intake-section">
        <div class="field full"><label class="field-label-strong">메모(기사전달사항)</label><textarea id="memo_customer" name="memo_customer" placeholder="예) 사고 이력 안내&#10;예) 스크래치 등 차량 관련 내용"><%= order.memo_customer || '' %></textarea></div>
        <div class="field full"><label class="field-label-strong">업체 전달사항</label><textarea id="memo_billing" name="memo_billing" placeholder="예) 계산서/내역서 비고란에 'OOO'로 기재 요청"><%= order.memo_billing || '' %></textarea></div>
      </div>

      <% if (currentUser.role === 'admin') { %>
      <div class="field">
        <label>지사 선택 <span class="required-mark" aria-hidden="true">*</span></label>
        <select name="branch_id" id="branch_id" required>
          <option value="">선택하세요</option>
          <% branches.forEach(function(b){ %>
            <option value="<%= b.id %>" <%= String(order.branch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <% } else { %>
        <input type="hidden" id="branch_id" name="branch_id" value="<%= defaultBranch %>">
      <% } %>
      <% if (currentUser.role !== 'client') { %>
      <div class="field">
        <label>요청 법인(고객사)</label>
        <select name="requester_group_id">
          <option value="">선택 안 함</option>
          <% groups.forEach(function(g){ %>
            <option value="<%= g.id %>"><%= g.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <div class="order-form-actions">
        <a class="btn secondary" href="/orders">취소</a>
        <button class="btn" type="submit" form="orderForm">오더 등록</button>
      </div>
    </div>

    <div class="ai-intake-side">
      <div class="card ai-intake-fare-card">
        <div class="section-title">💳 요금 및 결제방식</div>
        <div class="row fare-payment-row">
          <div class="field">
            <label>요금(원)</label>
            <input type="number" id="fare_amount" name="fare_amount" min="0" step="1000" placeholder="0" value="<%= order.fare_amount || '' %>">
          </div>
          <div class="field">
            <label>결제방식</label>
            <select name="payment_method_id" id="payment_method_id">
              <option value="">선택 안 함</option>
              <% paymentMethods.forEach(function(pm){ %>
                <option value="<%= pm.id %>" <%= (String(order.payment_method_id) === String(pm.id)) || (!order.payment_method_id && pm.is_default) ? 'selected' : '' %>><%= pm.name %></option>
              <% }) %>
            </select>
          </div>
        </div>
          <input type="hidden" id="ferry_fare_amount" name="ferry_fare_amount" value="<%= order.ferry_fare_amount || 0 %>">
        <p class="fare-calc-hint" id="fareCalcHint" style="display:none;"></p>
      </div>

      <div class="card map-card ai-intake-map-card">
        <div class="page-head-row" style="margin-bottom:8px;">
          <div class="section-title" style="margin:0;">🗺 경로 미리보기</div>
          <button type="button" class="btn small secondary" id="mapShowAllBtn">전체 경로 보기</button>
        </div>
        <div id="mapDistanceInfo" class="map-distance-info" style="display:none;">
          <div class="route-search-header">
            <div class="section-title small" style="margin:0;">🧭 경로탐색 <span id="routeDurationFormulaHeader" style="font-weight:400;color:var(--muted);"></span></div>
            <select id="routePrioritySelect" class="route-priority-select">
              <option value="RECOMMEND">추천</option>
              <option value="TIME">최단시간</option>
              <option value="DISTANCE">최단거리</option>
              <option value="FREE">무료도로</option>
            </select>
          </div>
          <div class="route-summary-grid">
            <div class="route-summary-item"><div class="label">총거리</div><div class="value" id="routeTotalDistance">-</div></div>
            <div class="route-summary-item"><div class="label">예상소요시간</div><div class="value" id="routeTotalDuration">-</div></div>
            <div class="route-summary-item"><div class="label">예상톨비</div><div class="value" id="routeTollFare">-</div></div>
            <div class="route-summary-item" id="routeFerryFareItem" style="display:none;"><div class="label">도선요금</div><div class="value" id="routeFerryFare">-</div></div>
            <div class="route-summary-item" id="routeFerryArrivalItem" style="display:none;"><div class="label">도착 예정</div><div class="value" id="routeFerryArrival">-</div></div>
          </div>
          <div class="section-title small" style="margin:12px 0 6px;">구간별 상세</div>
          <div id="mapDistanceList"></div>
        </div>
        <div id="orderMap" class="order-map"></div>
      </div>
    </div>

  </div>
</form>

<div id="registeredAddrModal" class="modal-overlay" style="display:none;">
  <div class="modal-box">
    <div class="modal-header">
      <h3>등록 주소</h3>
      <button type="button" class="modal-close" id="registeredAddrClose">✕</button>
    </div>
    <div id="registeredAddrList" class="registered-address-list"></div>
    <button type="button" class="btn small secondary" id="registeredAddrManageToggle" style="margin-top:10px;">등록주소 관리 (추가/수정/삭제)</button>
    <div id="registeredAddrManage" style="display:none;margin-top:12px;">
      <div id="registeredAddrManageList"></div>
      <div class="section-title small">새 주소 등록</div>
      <div class="row">
        <div class="field"><label>이름</label><input type="text" id="regAddrNewLabel" placeholder="예: 강남 인수 거점"></div>
      </div>
      <div class="field full">
        <label>주소</label>
        <div class="addr-input-row">
          <input type="text" class="addr-input" id="regAddrNewAddress" placeholder="도로명, 지번 또는 상호명으로 검색">
          <button type="button" class="btn small secondary addr-search-btn" data-target="regAddrNewAddress">🔍 검색</button>
        </div>
        <div id="regAddrNewAddress_results" class="addr-results"></div>
      </div>
      <button type="button" class="btn small" id="regAddrAddBtn">추가</button>
    </div>
  </div>
</div>

<script>
  window.__prefillWaypoints = <%- toScriptJson(order.waypoints || []) %>;
  window.__favorites = <%- toScriptJson(favorites || []) %>;
  window.__waypointExtended = true;
  window.__aiIntakeExistingSession = <%- toScriptJson(existingSession ? { id: existingSession.id, status: existingSession.status, messages: existingMessages, draft: existingDraft } : null) %>;
</script>
<script src="//dapi.kakao.com/v2/maps/sdk.js?appkey=<%= kakaoJsKey %>"></script>
<script src="/js/order-form.js"></script>
<script src="/js/ai-intake.js"></script>

<%- include('../partials/footer') %>
