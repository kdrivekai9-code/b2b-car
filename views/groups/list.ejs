<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">법인 관리</h1>
    <p class="page-sub">지사에 소속된 법인 목록입니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn" href="/groups/new">+ 법인 등록</a>
  </div>
</div>
<%- include('../partials/group_tabs', { groups: groups, active: 'list' }) %>
<div class="card">
  <div class="table-wrap">
  <table>
    <thead><tr><th>법인명</th><th>소속 지사</th><th>대표번호</th><th>사업자번호</th><th>등록일</th><th>관리</th></tr></thead>
    <tbody>
      <% if (groups.length === 0) { %><tr><td colspan="6" class="empty">등록된 법인이 없습니다.</td></tr><% } %>
      <% groups.forEach(function(g){ %>
        <tr>
          <%# 법인명을 누르면 법인 정보로 간다 — 목록에서 곧바로 설정에 들어가는 통로다. %>
          <td><a href="/groups/<%= g.id %>/edit"><%= g.name %></a></td>
          <td><%= g.branch_name %></td>
          <td><%= g.main_phone || '-' %></td>
          <td><%= g.business_registration_number || '-' %></td>
          <td><%= g.created_at %></td>
          <td>
            <div class="table-actions">
              <a class="btn small secondary" href="/groups/<%= g.id %>/edit">법인정보</a>
              <%# 법인별 설정(정책 변경) — 요금표·통보를 지사가 아니라 법인 단위로 관리한다. %>
              <a class="btn small" href="/groups/<%= g.id %>/accounts">계정정보</a>
              <a class="btn small secondary" href="/groups/<%= g.id %>/fare-rules">탁송 요금</a>
              <a class="btn small secondary" href="/groups/<%= g.id %>/daily-driver-fare-rules">일일기사 요금</a>
              <a class="btn small secondary" href="/groups/<%= g.id %>/customer-notifications">고객 통보</a>
              <a class="btn small secondary" href="/groups/<%= g.id %>/dispatch-delay">배차지연</a>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
