<%
  // 내부 결재용 정산내역서. 공용 레이아웃(header/footer)을 쓰지 않는다 — 사이드바·네비게이션이
  // 종이에 같이 찍히면 결재 서류로 못 쓴다. 그래서 이 파일 하나로 문서 전체를 그린다.
  //
  // 금액 표기는 화면(settlement.ejs)과 같아야 한다. 서류와 화면이 다른 숫자를 보이면 어느 쪽을
  // 믿을지 알 수 없다 — 그래서 같은 loadSettlement 결과를 그대로 쓰고, 여기서 다시 더하지 않는다.
  const money = (n) => (Number(n) || 0).toLocaleString('ko-KR') + '원';
  const addr = (a, d) => [a, d].filter(Boolean).join(' ') || '-';
  // 별도 줄 방식이면 운행요금에서 할증을 뺀 금액을 보여준다(총액은 같다).
  const itemized = surchargeMode === 'itemized';
  // 도선료는 기타 정산으로 옮겼다(사용자 지시) — 운행요금 소계에서 뺀다. 총 청구액은 그대로다.
  const runningTotal = itemized ? (summary.base + summary.wait + summary.cancel) : summary.total;
%><!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>정산내역서 · <%= group.name %> · <%= month %></title>
<style>
  /* 종이 한 장으로 떨어지게. 화면에서도 같은 폭으로 보여 인쇄 결과를 미리 가늠할 수 있다. */
  @page { size: A4; margin: 14mm 12mm; }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 18px;
    font-family: -apple-system, BlinkMacSystemFont, "Malgun Gothic", "맑은 고딕", sans-serif;
    font-size: 12px; color: #111; background: #f4f5f7;
  }
  .sheet { max-width: 820px; margin: 0 auto; background: #fff; padding: 28px 30px; }
  h1 { font-size: 24px; letter-spacing: 8px; text-align: center; margin: 0 0 4px; }
  .subtitle { text-align: center; color: #555; margin-bottom: 18px; }
  table { width: 100%; border-collapse: collapse; }
  .meta td { padding: 5px 8px; border: 1px solid #bbb; }
  .meta th {
    padding: 5px 8px; border: 1px solid #bbb; background: #f2f3f5;
    text-align: left; width: 90px; font-weight: 600; white-space: nowrap;
  }
  /* 도장을 찍을 자리 — 비워두는 것이 목적이라 높이를 고정한다. */
  .rows th, .rows td { border: 1px solid #bbb; padding: 5px 7px; }
  .rows th { background: #f2f3f5; font-weight: 600; }
  .rows td.num, .rows th.num { text-align: right; white-space: nowrap; }
  .rows tfoot th { background: #f7f8fa; }
  .section { margin-top: 20px; }
  .section-head { font-weight: 700; margin-bottom: 6px; font-size: 13px; }
  .muted { color: #666; font-size: 11px; }
  .grand { margin-top: 16px; border: 2px solid #333; padding: 10px 14px; display: flex;
           justify-content: space-between; align-items: center; }
  .grand b { font-size: 20px; }
  .sign { margin-top: 26px; text-align: center; line-height: 1.9; }
  .toolbar { max-width: 820px; margin: 0 auto 12px; display: flex; gap: 8px; justify-content: flex-end; }
  .btn { padding: 7px 14px; border: 1px solid #2e5c8a; background: #2e5c8a; color: #fff;
         border-radius: 4px; cursor: pointer; font-size: 13px; }
  .btn.secondary { background: #fff; color: #2e5c8a; }
  .empty { color: #666; padding: 10px 0; }
  /* 인쇄할 때는 버튼과 배경을 뺀다 — 버튼이 종이에 찍히면 서류가 아니다. */
  @media print {
    body { background: #fff; padding: 0; font-size: 11px; }
    .toolbar { display: none; }
    .sheet { max-width: none; padding: 0; }
    /* 표가 페이지 경계에서 잘리면 결재자가 금액을 못 읽는다. */
    table { page-break-inside: auto; }
    tr { page-break-inside: avoid; page-break-after: auto; }
    thead { display: table-header-group; }
  }
</style>
</head>
<body>

<div class="toolbar">
  <button class="btn" onclick="window.print()">인쇄</button>
  <button class="btn secondary" onclick="window.close()">닫기</button>
</div>

<div class="sheet">
  <h1>정 산 내 역 서</h1>
  <p class="subtitle"><%= month %> (완료일 기준)</p>

  <%# 결재란(담당/검토/승인)은 걷어냈다(사용자 지시). 그래서 정보표가 전체 폭을 쓴다 —
      2단으로 감싸던 표까지 같이 없앤다. 남겨두면 표가 왼쪽 2/3에만 찍혀 여백이 뜬다. %>
  <table class="meta" style="margin-bottom:14px;">
    <tr><th>공급받는자</th><td><b><%= group.name %></b></td></tr>
    <tr><th>사업자번호</th><td><%= group.business_registration_number || '-' %></td></tr>
    <tr><th>주소</th><td><%= group.business_address || '-' %></td></tr>
    <tr><th>담당자</th><td><%= [group.contact_name, group.contact_phone].filter(Boolean).join(' · ') || '-' %></td></tr>
    <tr><th>공급자</th><td><%= group.branch_name || '-' %><%= group.branch_phone ? ' · ' + group.branch_phone : '' %></td></tr>
    <tr><th>발행일</th><td><%= issuedOn %><%= issuedBy ? ' · 작성 ' + issuedBy : '' %></td></tr>
    <%# 입금계좌는 청구서의 목적 그 자체다 — 없으면 받는 쪽이 어디로 보낼지 몰라 따로 물어야
        한다. 비어 있으면 빈 칸을 두지 말고 어디서 채우는지 알려준다. %>
    <tr>
      <th>입금계좌</th>
      <td>
        <% if (group.bank_account) { %>
          <b><%= [group.bank_name, group.bank_account].filter(Boolean).join(' ') %></b><%= group.bank_holder ? ' · 예금주 ' + group.bank_holder : '' %>
        <% } else { %>
          <span class="muted">지사 정보에 입금계좌가 등록되어 있지 않습니다(지사관리 → 기본 정보).</span>
        <% } %>
      </td>
    </tr>
  </table>

  <div class="section">
    <div class="section-head">
      1. 운행요금 (<%= summary.count %>건)
      <% if (itemized) { %><span class="muted">— 할증은 아래 2번에 별도 표기</span><% } %>
    </div>
    <% if (!items.length) { %>
      <p class="empty">해당 월에 완료된 오더가 없습니다.</p>
    <% } else { %>
      <table class="rows">
        <thead>
          <tr>
            <th style="width:34px;">#</th>
            <th style="width:92px;">예약일</th>
            <th style="width:92px;">차량번호</th>
            <th>출발지</th>
            <th>도착지</th>
            <th class="num" style="width:96px;">금액</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (r, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= r.reserved_date || '-' %></td>
              <td><%= r.vehicle_number || '-' %></td>
              <td><%= addr(r.origin_address, r.origin_address_detail) %></td>
              <td><%= addr(r.destination_address, r.destination_address_detail) %></td>
              <td class="num">
                <%= money(itemized ? r.baseFare + r.waitFee + r.cancelFee : r.total) %>
                <% if (!itemized && r.surchargeTotal > 0) { %>
                  <br><span class="muted">할증 <%= money(r.surchargeTotal) %> 포함</span>
                <% } %>
                <% if (r.waitFee > 0) { %><br><span class="muted">대기요금 <%= money(r.waitFee) %></span><% } %>
                <% if (r.cancelFee > 0) { %><br><span class="muted">취소요금 <%= money(r.cancelFee) %></span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><th colspan="5" class="num">소계</th><th class="num"><%= money(runningTotal) %></th></tr>
        </tfoot>
      </table>
    <% } %>
  </div>

  <% if (itemized && summary.surcharge > 0) { %>
    <div class="section">
      <div class="section-head">2. 할증</div>
      <table class="rows">
        <thead><tr><th>항목</th><th class="num" style="width:80px;">건수</th><th class="num" style="width:110px;">금액</th></tr></thead>
        <tbody>
          <% Object.keys(surchargeByLabel).forEach(function (label) { %>
            <tr>
              <td><%= label %></td>
              <td class="num"><%= surchargeByLabel[label].count %>건</td>
              <td class="num"><%= money(surchargeByLabel[label].amount) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot><tr><th class="num" colspan="2">소계</th><th class="num"><%= money(summary.surcharge) %></th></tr></tfoot>
      </table>
    </div>
  <% } %>

  <div class="section">
    <div class="section-head">
      <%= itemized && summary.surcharge > 0 ? '3' : '2' %>. 기타 정산 내역 (월정산, <%= extraSummary.count %>건)
    </div>
    <%# 개별정산은 건별 청구서로 따로 청구한다 — 이 문서에 넣으면 두 번 청구된다. %>
    <% const monthlyExtras = extras.filter(function (e) { return e.settleMode !== 'individual'; }) %>
    <% if (!monthlyExtras.length) { %>
      <p class="empty">월정산으로 청구할 기타 정산 내역이 없습니다.</p>
    <% } else { %>
      <table class="rows">
        <thead>
          <tr>
            <th style="width:92px;">일자</th>
            <th style="width:92px;">차량번호</th>
            <th>출발지</th>
            <th style="width:96px;">항목</th>
            <th class="num" style="width:96px;">금액</th>
          </tr>
        </thead>
        <tbody>
          <% monthlyExtras.forEach(function (r) { %>
            <tr>
              <td><%= r.charged_on || '-' %></td>
              <td><%= r.vehicle_number || '-' %></td>
              <td>
                <%= addr(r.origin_address, r.origin_address_detail) %>
                <span class="muted"><%= r.oid %></span>
                <% if (r.note) { %><br><span class="muted"><%= r.note %></span><% } %>
              </td>
              <td>기타정산(<%= r.charge_type %>)</td>
              <td class="num"><%= money(r.amount) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot><tr><th colspan="4" class="num">소계</th><th class="num"><%= money(extraSummary.total) %></th></tr></tfoot>
      </table>
    <% } %>
  </div>

  <%# 총 청구액은 화면과 같은 값(grandTotal)을 그대로 쓴다 — 여기서 다시 더하면 표시 방식에
      따라 서류와 화면이 갈릴 수 있다. %>
  <div class="grand">
    <span>총 청구액 <span class="muted">(운행요금 + 기타 정산)</span></span>
    <b><%= money(grandTotal) %></b>
  </div>

  <div class="sign">
    위와 같이 정산 내역을 제출합니다.<br>
    <%= issuedOn %>
  </div>
</div>

<script>
  // 새 창으로 열리면 바로 인쇄 대화상자를 띄운다 — 결재 서류라 대부분 열자마자 뽑는다.
  // ?autoprint=0으로 열면 미리보기만 한다.
  if (new URLSearchParams(location.search).get('autoprint') !== '0') {
    window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 300); });
  }
</script>
</body>
</html>
