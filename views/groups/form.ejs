<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= title %></h1>
    <p class="page-sub">법인 정보를 입력하세요.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/groups">취소</a>
    <% if (mode === 'edit') { %><a class="btn secondary" href="/groups/<%= group.id %>/users">사용자 리스트</a><% } %>
    <button class="btn" type="submit" form="groupForm">저장</button>
  </div>
</div>
<div class="card">
  <form id="groupForm" method="POST" action="<%= mode === 'create' ? '/groups' : '/groups/' + group.id %>">
    <div class="section-title">🏢 법인 정보</div>
    <div class="row">
      <div class="field">
        <label>소속 지사 *</label>
        <select name="branch_id" id="corp_branch_id" required>
          <option value="">선택하세요</option>
          <% branches.forEach(function(b){ %>
            <option value="<%= b.id %>" data-main-phone="<%= b.main_phone || '' %>" <%= String(group.branch_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field"><label>대표번호</label><input type="text" id="corp_main_phone" name="main_phone" value="<%= group.main_phone || '' %>" readonly></div>
    </div>
    <div class="row">
      <div class="field"><label>법인명 *</label><input type="text" name="name" value="<%= group.name || '' %>" required></div>
      <div class="field"><label>사업자등록번호</label><input type="text" name="business_registration_number" value="<%= group.business_registration_number || '' %>" placeholder="예: 123-45-67890"></div>
    </div>

    <div class="row">
      <div class="field"><label>업체 전화번호</label><input type="text" name="company_phone" value="<%= group.company_phone || '' %>" placeholder="예: 02-1234-5678"></div>
      <div class="field"><label>담당자명</label><input type="text" name="contact_name" value="<%= group.contact_name || '' %>"></div>
    </div>

    <div class="row">
      <div class="field"><label>담당자 연락처/전화번호</label><input type="text" name="contact_phone" value="<%= group.contact_phone || '' %>" placeholder="예: 010-1234-5678"></div>
      <div class="field"><label>이메일주소</label><input type="email" name="tax_email" value="<%= group.tax_email || '' %>" placeholder="tax@example.com"></div>
    </div>

    <div class="row">
      <div class="field full"><label>실제 사업장 주소지</label><input type="text" name="business_address" value="<%= group.business_address || '' %>" placeholder="사업장 주소"></div>
    </div>

    <div class="section-title">🧾 세금계산서/정산 정보</div>
    <div class="row">
      <div class="field"><label>세금계산서 발행일</label><input type="number" name="tax_invoice_issue_day" min="1" max="31" value="<%= group.tax_invoice_issue_day || '' %>" placeholder="예: 1"></div>
      <div class="field"><label>결재일</label><input type="number" name="payment_due_day" min="1" max="31" value="<%= group.payment_due_day || '' %>" placeholder="예: 30"></div>
      <div class="field">
        <label>결재방식</label>
        <select name="settlement_method">
          <option value="">선택 안 함</option>
          <% ['계좌이체','카드','후불','현금','기타'].forEach(function(method){ %>
            <option value="<%= method %>" <%= group.settlement_method === method ? 'selected' : '' %>><%= method %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="section-title">🔗 소속 사용자 공유</div>
    <div class="field full">
      <label class="checkline">
        <input type="checkbox" name="share_activity_feed" value="1" <%= group.share_activity_feed ? 'checked' : '' %>>
        같은 법인 소속 사용자들에게 서로의 접수·취소·변경 요청을 공유한다
      </label>
      <p class="page-sub">
        켜면 이 법인 소속 사용자들이 서로의 대화 내용을 직접 보는 게 아니라,
        접수·취소·변경이 있을 때마다 만들어지는 한 줄 요약만 "팀 접수 현황 안내"에서 함께 봅니다.
      </p>
    </div>
  </form>
</div>
<script>
(function () {
  var branchSelect = document.getElementById('corp_branch_id');
  var phoneInput = document.getElementById('corp_main_phone');
  if (!branchSelect || !phoneInput) return;

  function syncBranchPhone(force) {
    var opt = branchSelect.options[branchSelect.selectedIndex];
    if (!opt) return;
    var branchPhone = opt.getAttribute('data-main-phone') || '';
    if (force || !String(phoneInput.value || '').trim()) {
      phoneInput.value = branchPhone;
    }
  }

  branchSelect.addEventListener('change', function () { syncBranchPhone(true); });
  syncBranchPhone(false);
})();
</script>
<%- include('../partials/footer') %>
