<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= group.name %> · 탁송 요금</h1>
    <p class="page-sub">거리 기반 자동요금 계산 규칙입니다. 계산식: 기본요금 + (거리 − 기준거리) × (할증요금 ÷ 할증단위)</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/groups">법인 목록으로</a>
    <button class="btn" type="submit" form="fareForm">저장</button>
  </div>
</div>
<%- include('../partials/group_tabs', { group: group, groups: groups, active: 'fare' }) %>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>

<%# 비어 있을 때 무엇이 적용되는지 반드시 밝힌다 — 빈 표만 보이면 요금이 0원인 줄 안다. %>
<div class="card">
  <div class="section-title">📌 현재 적용되는 요금표</div>
  <% if (tiers.length) { %>
    <p class="page-sub" style="margin:0;"><b>이 법인 전용 요금표</b>가 적용됩니다. (구간 <%= tiers.length %>개)</p>
  <% } else { %>
    <p class="page-sub" style="margin:0;">
      이 법인에 등록된 요금표가 없어 <b>소속 지사(<%= group.branch_name || '-' %>)의 탁송 요금표</b>가 적용됩니다.
      (지사 구간 <%= branchTiers.length %>개<%= branchExtra.fare_table_enabled ? '' : ' · 지사 요금표 사용 꺼짐' %>)
    </p>
    <% if (branchTiers.length) { %>
      <form method="POST" action="/groups/<%= group.id %>/fare-rules/copy" style="margin-top:10px;"
            onsubmit="return confirm('소속 지사 요금표를 이 법인으로 복사할까요?');">
        <button class="btn secondary" type="submit">소속 지사 요금표 가져오기</button>
      </form>
    <% } %>
  <% } %>
</div>

<form id="fareForm" method="POST" action="/groups/<%= group.id %>/fare-rules">
  <div class="card">
    <%# 할증은 이미 fare_amount에 더해져 청구된다(lib/branchPolicy.js). 여기서 고르는 것은
        정산서에 어떻게 **보여줄지**뿐이라, 총 청구액은 어느 쪽이든 같다. 그 사실을 밝히지
        않으면 관리자가 금액이 바뀔까 봐 못 바꾼다. %>
    <div class="section-title">🧾 정산서 할증 표시</div>
    <p class="page-sub" style="margin-top:0;">
      수입차 · 대형 · 전기차 · 야간 · 오지 할증을 정산내역서에 어떻게 보여줄지 정합니다.
      <b>총 청구액은 어느 쪽이든 같습니다</b> — 줄 구성만 달라집니다.
    </p>
    <div class="row" style="gap:20px;margin-bottom:6px;">
      <label class="checkline inline">
        <input type="radio" name="settlement_surcharge_mode" value="included"
               <%= (group.settlement_surcharge_mode || 'included') !== 'itemized' ? 'checked' : '' %>>
        운행요금에 포함 <span class="page-sub">(예: 운행요금 105,000원 · 기본 97,000 + 수입차 5,000 + 야간 3,000)</span>
      </label>
      <label class="checkline inline">
        <input type="radio" name="settlement_surcharge_mode" value="itemized"
               <%= (group.settlement_surcharge_mode || '') === 'itemized' ? 'checked' : '' %>>
        별도 줄로 분리 <span class="page-sub">(예: 운행요금 97,000원 + 할증 8,000원)</span>
      </label>
    </div>
    <p class="page-sub" style="margin-bottom:14px;">
      계약서에 "탁송료" 한 줄로 적혀 있으면 <b>포함</b>이 맞습니다. 줄을 나누면 거래처에서 문의가 올 수 있습니다.
    </p>

    <div class="section-title">📏 거리 구간별 요금 규칙</div>
    <%# 지점 구간요금이 이 표를 덮는다. 그 사실을 여기서 밝히지 않으면 관리자는 이 표를
        고쳐놓고 "왜 안 바뀌지"를 겪는다 — 요금이 안 맞는 원인을 찾을 곳이 다른 화면이다. %>
    <p class="page-sub" style="margin-top:0;">
      출발지나 도착지가 <a href="/groups/<%= group.id %>/office-fares">지점 구간요금</a>에 등록된 지점이면
      <b>그 표의 금액이 먼저 적용됩니다.</b> 아래 구간표는 지점에 해당하지 않는 오더에 쓰입니다.
    </p>
    <div class="table-wrap">
    <table id="fareTiersTable">
      <thead>
        <tr>
          <th>구간</th><th>기준거리(km)</th><th>기본요금(원)</th><th>할증단위(km)</th><th>할증요금(원)</th>
          <th>최대거리(km)</th><th>최대요금(원)</th><th>반올림단위</th><th>반올림방식</th><th></th>
        </tr>
      </thead>
      <tbody id="fareTiersBody">
        <% tiers.forEach(function(t, i){ %>
          <tr>
            <td class="tier-label">구간요금<%= i + 1 %></td>
            <td><input type="number" name="base_distance_km" value="<%= t.base_distance_km %>" min="0" step="0.1"></td>
            <td><input type="number" name="base_fare" value="<%= t.base_fare %>" min="0" step="1000"></td>
            <td><input type="number" name="surcharge_unit_km" value="<%= t.surcharge_unit_km %>" min="0.1" step="0.1"></td>
            <td><input type="number" name="surcharge_fare" value="<%= t.surcharge_fare %>" min="0" step="100"></td>
            <td><input type="number" name="max_distance_km" value="<%= t.max_distance_km || '' %>" min="0" step="0.1"></td>
            <td><input type="number" name="max_fare" value="<%= t.max_fare || '' %>" min="0" step="1000"></td>
            <td><input type="number" name="round_unit" value="<%= t.round_unit %>" min="1" step="1"></td>
            <td>
              <select name="round_method">
                <option value="up" <%= t.round_method === 'up' ? 'selected' : '' %>>올림</option>
                <option value="round" <%= t.round_method === 'round' ? 'selected' : '' %>>반올림</option>
                <option value="down" <%= t.round_method === 'down' ? 'selected' : '' %>>내림</option>
              </select>
            </td>
            <td><button type="button" class="btn small secondary remove-tier-btn">삭제</button></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <button type="button" class="btn small secondary" id="addTierBtn" style="margin-top:10px;">+ 구간 추가</button>
  </div>

  <div class="card">
    <div class="section-title">➕ 부가 요금 / 노출 설정</div>
    <div class="row">
      <div class="field"><label>왕복 비율(%, 편도 대비)</label><input type="number" name="round_trip_ratio" value="<%= extra.round_trip_ratio || 180 %>" min="0"></div>
      <div class="field"><label>대기 기준시간(분)</label><input type="number" name="wait_threshold_min" value="<%= extra.wait_threshold_min || 15 %>" min="0"></div>
      <div class="field"><label>대기요금(원)</label><input type="number" name="wait_fee" value="<%= extra.wait_fee || 0 %>" min="0"></div>
    </div>
    <div class="row">
      <%# 취소요금은 1,000원 단위로 받는다(사용자 확정) — 지사 화면(views/branches/fare_rules.ejs)도 같다. %>
      <div class="field"><label>도착 전 취소요금(원)</label><input type="number" name="cancel_before_fee" value="<%= extra.cancel_before_fee || 0 %>" min="0" step="1000"></div>
      <div class="field"><label>도착 후 취소요금(원)</label><input type="number" name="cancel_after_fee" value="<%= extra.cancel_after_fee || 0 %>" min="0" step="1000"></div>
    </div>
    <%# 오지요금은 다른 할증들과 함께 아래 "탁송 특화 할증" 카드로 옮겼다 —
        같은 성격(구간요금에 더하는 정액)인데 따로 두면 상·하한 규칙이 갈린다. %>
    <div class="row">
      <div class="field"><label class="checkline"><input type="checkbox" name="fare_table_enabled" value="1" <%= extra.fare_table_enabled ? 'checked' : '' %>> 이 요금표 사용 (끄면 소속 지사 요금표를 씁니다)</label></div>
      <div class="field"><label class="checkline"><input type="checkbox" name="fare_visible_to_client" value="1" <%= extra.fare_visible_to_client !== 0 ? 'checked' : '' %>> 고객사(딜러)에게 요금 노출</label></div>
      <div class="field"><label class="checkline"><input type="checkbox" name="fare_editable_by_client" value="1" <%= extra.fare_editable_by_client ? 'checked' : '' %>> 고객사(딜러)의 금액 수정 허용</label></div>
    </div>
  </div>

  <%- include('../partials/fare_surcharge_settings') %>
</form>

<% if (saved) { %><div class="toast">저장되었습니다.</div><% } %>
<% if (copied) { %><div class="toast">소속 지사 요금표를 가져왔습니다.</div><% } %>
<script src="/js/fare-rules.js"></script>
<%- include('../partials/footer') %>
