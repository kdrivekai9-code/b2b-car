<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= group.name %> · 정산내역</h1>
    <%# 목록에 찍는 날짜는 예약일이지만, 어느 달로 묶이는지는 완료일이 정한다.
        말일에 예약해 다음 달 새벽에 끝난 건이 어느 정산서에 들어갔는지 못 찾는 일이 없도록
        그 기준을 화면에 밝혀 둔다. %>
    <p class="page-sub">
      완료된 오더를 <b>완료일 기준</b>으로 묶었습니다. 금액은 업체별 계약 요금입니다(배차 요금 아님).
      <%# 어느 모드든 총 청구액은 같다 — 그 사실을 밝히지 않으면 모드를 바꿀 때 금액이
          달라지는 줄 알고 못 바꾼다. %>
      할증 표시는 <b><%= surchargeMode === 'itemized' ? '별도 줄(항목별)' : '운행요금 포함' %></b> 방식입니다.
    </p>
  </div>
  <div class="page-head-actions">
    <%# 새 창으로 연다(사용자 지시) — 목록을 보던 화면을 잃지 않고 인쇄만 하고 닫을 수 있어야 한다.
        조회 중인 달을 그대로 넘긴다. 안 넘기면 이번 달이 인쇄돼 엉뚱한 서류가 나간다. %>
    <%# 엑셀은 인쇄 앞에 둔다(사용자 지시). 조회 중인 달을 그대로 넘긴다 —
        안 넘기면 이번 달이 받아져 엉뚱한 파일이 나간다(인쇄 버튼과 같은 이유). %>
    <a class="btn secondary" id="settlementExcelBtn"
       href="/groups/<%= group.id %>/settlement/excel?month=<%= encodeURIComponent(month) %>">⬇ 엑셀 다운로드</a>
    <button type="button" class="btn" id="settlementPrintBtn">📄 정산내역서 출력</button>
    <a class="btn secondary" href="/groups">법인 목록으로</a>
  </div>
</div>
<%- include('../partials/group_tabs', { group: group, groups: groups, active: 'settlement' }) %>

<%# 방금 바꾼 것이 반영됐는지 알려준다 — 총액이 안 바뀌는 설정이라 화면만 보고는
    적용됐는지 알기 어렵다. %>
<% if (saved) { %><div class="alert"><%= saved %></div><% } %>

<%# ── 할증 표시 방식 ──────────────────────────────────────────────────────
    이 설정이 바꾸는 것은 아래 정산서의 줄 구성뿐이다(총 청구액은 같다). 그래서 요금을
    설정하는 화면이 아니라 정산서를 보는 이 화면 위에 둔다 — 바꾸고 바로 아래에서 결과를
    확인할 수 있어야 한다. %>
<div class="card" style="border-left:4px solid #2e5c8a;">
  <div class="section-title">🧾 정산서 할증 표시</div>
  <p class="page-sub">
    수입차 · 대형 · 전기차 · 야간 · 오지 할증을 정산내역서에 어떻게 보여줄지 정합니다.
    <b>총 청구액은 어느 쪽이든 같습니다</b> — 줄 구성만 달라집니다.
  </p>
  <form method="POST" action="/groups/<%= group.id %>/settlement/surcharge-mode"
        class="row" style="align-items:center;gap:20px;">
    <%# 조회 중인 달을 함께 보낸다 — 안 보내면 저장 후 이번 달로 튕겨 방금 보던 정산서를 잃는다. %>
    <input type="hidden" name="month" value="<%= month %>">
    <label class="checkline inline">
      <input type="radio" name="settlement_surcharge_mode" value="included"
             <%= surchargeMode !== 'itemized' ? 'checked' : '' %>>
      운행요금에 포함
      <span class="page-sub">(예: 운행요금 105,000원 · 기본 97,000 + 수입차 5,000 + 야간 3,000)</span>
    </label>
    <label class="checkline inline">
      <input type="radio" name="settlement_surcharge_mode" value="itemized"
             <%= surchargeMode === 'itemized' ? 'checked' : '' %>>
      별도 줄로 분리
      <span class="page-sub">(예: 운행요금 97,000원 + 할증 8,000원)</span>
    </label>
    <button class="btn secondary" type="submit">적용</button>
  </form>
  <p class="page-sub" style="margin-bottom:0;">
    계약서에 "탁송료" 한 줄로 적혀 있으면 <b>포함</b>이 맞습니다. 줄을 나누면 거래처에서 문의가 올 수 있습니다.
  </p>
</div>

<div class="card">
  <form method="GET" action="/groups/<%= group.id %>/settlement" class="filter-row" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;">
    <div class="field" style="margin:0;">
      <label for="month">정산월</label>
      <%# month 입력은 브라우저마다 지원이 갈려서, 실적이 있는 달은 목록으로도 고를 수 있게 둔다. %>
      <input type="month" id="month" name="month" value="<%= month %>">
    </div>
    <% if (months.length) { %>
      <div class="field" style="margin:0;">
        <label for="monthPick">실적이 있는 달</label>
        <select id="monthPick">
          <option value="">선택</option>
          <% months.forEach(function (m) { %>
            <option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <button class="btn" type="submit">조회</button>
  </form>
</div>

<div class="card">
  <div class="section-title">📄 <%= month %> 운행요금 (<%= summary.count %>건)</div>
  <% if (!items.length) { %>
    <p class="page-sub" style="margin:0;">이 달에 완료된 오더가 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table settlement-table">
        <thead>
          <tr>
            <th style="width:46px;">#</th>
            <th style="width:120px;">예약일</th>
            <th style="width:170px;">차종</th>
            <th>출발지</th>
            <th>도착지</th>
            <th style="width:130px;text-align:right;">요금</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (r, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td>
                <%= r.reserved_date || '-' %>
                <% if (r.reserved_time) { %><span class="muted"><%= String(r.reserved_time).slice(0, 5) %></span><% } %>
              </td>
              <td>
                <%= r.vehicle_type || '-' %>
                <%- include('../partials/vehicle_class_badge', { row: r }) %>
              </td>
              <td><%= [r.origin_address, r.origin_address_detail].filter(Boolean).join(' ') || '-' %></td>
              <td><%= [r.destination_address, r.destination_address_detail].filter(Boolean).join(' ') || '-' %></td>
              <td style="text-align:right;">
                <%= formatMoney(surchargeMode === 'itemized' ? r.baseFare + r.ferry : r.total) %>
                <%# 도선료는 탁송료와 별개로 청구하는 실비다. 합계에는 들어가 있으니 내역에서도 보여야
                    "요금표와 금액이 다르다"는 문의가 나오지 않는다. %>
                <% if (r.ferry > 0) { %><br><span class="muted">도선료 <%= formatMoney(r.ferry) %> 포함</span><% } %>
                <%# 할증 내역. 포함 방식이면 왜 그 금액인지 밝히고, 별도 줄 방식이면 아래
                    "할증 내역" 표로 빠졌다는 것을 알린다. %>
                <% if (r.surchargeTotal > 0) { %>
                  <br><span class="muted">
                    <% if (surchargeMode === 'itemized') { %>
                      할증 <%= formatMoney(r.surchargeTotal) %> 별도
                    <% } else { %>
                      기본 <%= formatMoney(r.baseFare) %> +
                      <%= r.surcharges.map(function (it) { return (it.label || it.code) + ' ' + (Number(it.amount) || 0).toLocaleString('ko-KR'); }).join(' + ') %>
                    <% } %>
                  </span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="5" style="text-align:right;">합계</th>
            <th style="text-align:right;">
              <%= formatMoney(surchargeMode === 'itemized' ? summary.base + summary.ferry : summary.total) %>
            </th>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</div>

<% if (surchargeMode === 'itemized' && summary.surcharge > 0) { %>
  <%# 별도 줄 방식에서만 나온다. 포함 방식에서는 위 운행요금에 이미 들어 있어 여기 또 보이면
      이중으로 읽힌다. %>
  <div class="card">
    <div class="section-title">➕ 할증 내역 (운행요금에서 분리)</div>
    <p class="page-sub">
      위 운행요금은 할증을 <b>뺀</b> 금액입니다. 아래 할증을 더한 값이 예전과 같은 총액입니다 —
      <b>청구 금액은 달라지지 않습니다.</b>
    </p>
    <div class="table-wrap">
      <table class="table surcharge-table">
        <thead><tr><th>항목</th><th style="width:100px;text-align:right;">건수</th><th style="text-align:right;">금액</th></tr></thead>
        <tbody>
          <% Object.keys(surchargeByLabel).forEach(function (label) { %>
            <tr>
              <td><%= label %></td>
              <td style="text-align:right;"><%= surchargeByLabel[label].count %>건</td>
              <td style="text-align:right;"><%= formatMoney(surchargeByLabel[label].amount) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><th>합계</th><th></th><th style="text-align:right;"><%= formatMoney(summary.surcharge) %></th></tr>
        </tfoot>
      </table>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="section-title">🧾 기타 정산 내역 · 별도 청구 (<%= extraSummary.count %>건)</div>
  <%# 실비가 어느 달로 묶이는지는 오더를 따라간다. 목록의 '일자'는 실제 발생일이라 월말 오더의
      톨게이트비가 다음 달 날짜로 찍힐 수 있는데, 그걸 보고 "잘못 들어왔다"고 읽지 않도록 밝힌다. %>
  <p class="page-sub">
    주유비 · 주차요금 · 톨게이트비 중 <b>별도 청구</b>로 표시된 것만 모았습니다.
    해당 오더가 완료된 달의 정산에 들어가며, 일자는 실제 발생일입니다.
  </p>
  <% if (!extras.length) { %>
    <p class="page-sub" style="margin:0;">이 달에 별도 청구할 기타 정산 내역이 없습니다.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table extra-charge-table">
        <thead>
          <tr>
            <th style="width:120px;">일자</th>
            <th style="width:130px;">차량번호</th>
            <th>출발지</th>
            <th style="width:110px;">항목</th>
            <th style="width:120px;text-align:right;">금액</th>
          </tr>
        </thead>
        <tbody>
          <% extras.forEach(function (r) { %>
            <tr>
              <td><%= r.charged_on || '-' %></td>
              <td><%= r.vehicle_number || '-' %></td>
              <td>
                <%= [r.origin_address, r.origin_address_detail].filter(Boolean).join(' ') || '-' %>
                <%# 같은 차량·같은 날 실비가 여러 건이면 어느 오더 것인지 구분이 안 된다. %>
                <span class="muted"><%= r.oid %></span>
                <% if (r.note) { %><br><span class="muted"><%= r.note %></span><% } %>
              </td>
              <td><%= r.charge_type %></td>
              <td style="text-align:right;"><%= formatMoney(r.amount) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="4" style="text-align:right;">합계</th>
            <th style="text-align:right;"><%= formatMoney(extraSummary.total) %></th>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="section-title" style="margin-top:16px;">항목별 합계표</div>
    <div class="table-wrap">
      <table class="table extra-charge-summary-table">
        <thead>
          <tr><th style="width:140px;">항목</th><th style="width:100px;text-align:right;">건수</th><th style="text-align:right;">금액</th></tr>
        </thead>
        <tbody>
          <%# 건수가 0인 항목도 줄을 남긴다 — 빠진 항목이 있는지 표에서 바로 보이게 한다. %>
          <% extraChargeTypes.forEach(function (t) { %>
            <tr>
              <td><%= t %></td>
              <td style="text-align:right;"><%= (extraSummary.byType[t] || {}).count || 0 %>건</td>
              <td style="text-align:right;"><%= formatMoney((extraSummary.byType[t] || {}).amount || 0) %></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th>합계</th>
            <th style="text-align:right;"><%= extraSummary.count %>건</th>
            <th style="text-align:right;"><%= formatMoney(extraSummary.total) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="section-title">💰 금액 통계</div>
  <%# 예전에는 항목을 가로로 늘어놓아서 숫자가 자리마다 다른 위치에 찍혔다 — 자릿수가 다르면
      크기 비교가 안 된다. 표로 바꾸고 금액을 우측 정렬해 자릿수를 맞춘다. %>
  <div class="table-wrap">
    <table class="table stat-table">
      <tbody>
        <tr><th>완료 건수</th><td><%= summary.count.toLocaleString('ko-KR') %>건</td></tr>
        <tr><th>탁송료</th><td><%= formatMoney(summary.fare) %></td></tr>
        <tr><th>도선료</th><td><%= formatMoney(summary.ferry) %></td></tr>
        <% if (surchargeMode === 'itemized') { %>
          <tr><th>운행요금 <span class="muted">(할증 제외)</span></th><td><%= formatMoney(summary.base + summary.ferry) %></td></tr>
          <tr><th>할증</th><td><%= formatMoney(summary.surcharge) %></td></tr>
        <% } else { %>
          <tr><th>운행요금 합계</th><td><%= formatMoney(summary.total) %></td></tr>
          <% if (summary.surcharge > 0) { %>
            <%# 포함 방식에서는 위 합계 안에 이미 들어 있다 — 더하는 줄이 아니라는 걸 들여쓰기로 보인다. %>
            <tr class="stat-sub"><th>└ 그중 할증</th><td><%= formatMoney(summary.surcharge) %></td></tr>
          <% } %>
        <% } %>
        <tr><th>기타 정산 <span class="muted">(별도 청구)</span></th><td><%= formatMoney(extraSummary.total) %></td></tr>
        <tr><th>건당 평균 <span class="muted">(운행요금)</span></th><td><%= formatMoney(summary.count ? Math.round(summary.total / summary.count) : 0) %></td></tr>
      </tbody>
      <tfoot>
        <%# 청구서에 찍힐 금액이라 다른 숫자보다 눈에 띄어야 한다. %>
        <tr class="stat-total"><th>총 청구액</th><td><%= formatMoney(grandTotal) %></td></tr>
      </tfoot>
    </table>
  </div>
</div>

<script>
  var printBtn = document.getElementById('settlementPrintBtn');
  if (printBtn) {
    printBtn.addEventListener('click', function () {
      var m = (document.getElementById('month') || {}).value || '<%= month %>';
      window.open('/groups/<%= group.id %>/settlement/print?month=' + encodeURIComponent(m),
        'settlementPrint', 'width=900,height=1000,scrollbars=yes');
    });
  }

  // 엑셀도 인쇄와 같은 달을 받아야 한다. 월 입력만 바꾸고 조회를 안 누른 상태에서 눌러도
  // 화면에 보이는 달이 나가도록 누르는 순간 링크를 고쳐 준다(인쇄 버튼과 같은 규칙).
  var excelBtn = document.getElementById('settlementExcelBtn');
  if (excelBtn) {
    excelBtn.addEventListener('click', function () {
      var m = (document.getElementById('month') || {}).value || '<%= month %>';
      excelBtn.href = '/groups/<%= group.id %>/settlement/excel?month=' + encodeURIComponent(m);
    });
  }

  var pick = document.getElementById('monthPick');
  if (pick) {
    pick.addEventListener('change', function () {
      if (!this.value) return;
      document.getElementById('month').value = this.value;
      this.form.submit();
    });
  }
</script>
<%- include('../partials/footer') %>
