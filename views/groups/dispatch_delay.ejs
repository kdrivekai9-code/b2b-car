<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title"><%= group.name %> · 배차지연 알림</h1>
    <p class="page-sub">기사 배정이 늦어지면 챗봇이 먼저 "요금을 올릴까요?"라고 제안합니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/groups">법인 목록으로</a>
    <button class="btn" type="submit" form="delayForm">저장</button>
  </div>
</div>
<%- include('../partials/group_tabs', { group: group, groups: groups, active: 'dispatch_delay' }) %>

<% if (error) { %><div class="error-msg"><%= error %></div><% } %>
<% if (notice) { %><div class="success-msg"><%= notice %></div><% } %>

<div class="card">
  <div class="section-title">📌 현재 상태</div>
  <% if (setting) { %>
    <p class="page-sub" style="margin:0;">이 법인에 <b>선제 안내가 켜져 있습니다.</b></p>
  <% } else { %>
    <%# 옵트인이다 — 등록하지 않으면 아무 일도 일어나지 않는다. 지사 기본값이 따로 없다. %>
    <p class="page-sub" style="margin:0;">
      등록된 설정이 없어 이 법인에는 <b>선제 안내가 나가지 않습니다.</b>
      배차지연 안내는 등록한 법인에만 나가는 옵트인 기능이라, 지사 기본값을 물려받지 않습니다.
    </p>
  <% } %>
</div>

<form id="delayForm" method="POST" action="/groups/<%= group.id %>/dispatch-delay">
  <div class="card">
    <div class="section-title">⏱ 지연 판단과 상향 금액</div>
    <div class="field">
      <label>적용할 콜 유형</label>
      <div class="var-chip-row" style="display:flex;gap:12px;flex-wrap:wrap;">
        <% callTypes.forEach(function (t) { %>
          <label class="checkline inline">
            <input type="checkbox" name="call_types" value="<%= t.key %>" <%= selected.indexOf(t.key) >= 0 ? 'checked' : '' %>>
            <%= t.label %>
          </label>
        <% }) %>
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label>배차지연 판단 시간(분)</label>
        <input type="number" name="delay_minutes" value="<%= setting ? setting.delay_minutes : 5 %>" min="1" max="120" step="1" required>
        <span class="hint">"접수" 상태로 이 시간이 지나면 지연으로 봅니다.</span>
      </div>
      <div class="field">
        <label>요금 상향금액(원)</label>
        <input type="number" name="raise_amount" value="<%= setting ? setting.raise_amount : 3000 %>" min="1000" max="10000" step="1000" required>
        <span class="hint">1,000원 단위로 10,000원까지</span>
      </div>
    </div>
  </div>
</form>

<% if (setting) { %>
<div class="card">
  <form method="POST" action="/groups/<%= group.id %>/dispatch-delay/delete"
        onsubmit="return confirm('이 법인의 배차지연 선제 안내를 끌까요?');">
    <button class="btn small secondary" type="submit">선제 안내 끄기</button>
  </form>
</div>
<% } %>

<style>
  .checkline.inline { display: inline-flex; align-items: center; gap: 4px; }
</style>
<%- include('../partials/footer') %>
