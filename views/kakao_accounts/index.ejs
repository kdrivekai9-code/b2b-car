<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">카카오 채널 매핑</h1>
    <p class="page-sub">카카오 상담톡 고객은 b2b-car 계정이 없어서, 어느 계정·지사로 접수하고 조회할지 채널 단위로 지정합니다. 등록되지 않은 채널은 상담원 연결로만 처리됩니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/chat/sessions">상담 관리로</a>
    <button class="btn" type="submit" form="kakaoAccountForm">등록</button>
  </div>
</div>

<% if (error) { %><div class="error-msg"><%= error %></div><% } %>
<% if (notice) { %><div class="success-msg"><%= notice %></div><% } %>

<div class="card">
  <form id="kakaoAccountForm" method="POST" action="/kakao-accounts">
    <div class="section-title">🔗 채널 매핑 등록</div>

    <div class="row">
      <div class="field">
        <label>service_key (발신프로필 키)</label>
        <input type="text" name="service_key" placeholder="예: b85d2bbb95062ed615…">
        <p class="page-sub">이 값만 넣으면 <strong>채널 전체</strong>에 적용됩니다.</p>
      </div>
      <div class="field">
        <label>고객 키 (external_user_key)</label>
        <input type="text" name="external_user_key" placeholder="특정 고객만 지정할 때">
        <p class="page-sub">함께 넣으면 <strong>그 고객만</strong> 적용되고, 채널 전체 매핑보다 우선합니다.</p>
      </div>
    </div>

    <% if (recentSessions.length) { %>
      <div class="field full">
        <label>최근 카카오 세션에서 키 가져오기</label>
        <select id="sessionKeyPicker">
          <option value="">직접 입력</option>
          <% recentSessions.forEach(function (s) { %>
            <option value="<%= s.kakao_service_key %>|<%= s.external_user_key || '' %>"
                    data-name="<%= s.external_name || '' %>" data-phone="<%= s.external_phone || '' %>">
              <%= s.external_name ? s.external_name + ' · ' : '' %>#<%= s.id %> · <%= s.created_at %> · service=<%= String(s.kakao_service_key).slice(0, 12) %>… user=<%= s.external_user_key || '-' %>
            </option>
          <% }) %>
        </select>
        <p class="page-sub">고르면 위 두 칸이 자동으로 채워집니다. 이미 채널 매핑이 된 고객은 이 목록에서 빠집니다.</p>
      </div>
    <% } %>

    <div class="row">
      <div class="field">
        <label>담당 계정 <span class="req">*</span></label>
        <select name="user_id" id="userIdSelect" required>
          <option value="">계정을 선택하세요</option>
          <option value="__unregistered__">미등록계정 — 새 사용자로 등록</option>
          <% users.forEach(function (u) { %>
            <option value="<%= u.id %>"><%= u.name %> (<%= u.login_id %>)</option>
          <% }) %>
        </select>
        <p class="page-sub">
          이 계정 이름으로 오더가 등록되고, 주문 조회 권한도 이 계정 기준입니다.
          아직 b2b-car 계정이 없는 고객이면 <strong>미등록계정</strong>을 고르세요 —
          등록을 누르면 이름·연락처를 채운 사용자 등록 화면으로 이동합니다.
        </p>
      </div>
      <div class="field">
        <label>지사 <span class="req">*</span></label>
        <select name="branch_id" required>
          <option value="">지사를 선택하세요</option>
          <% branches.forEach(function (b) { %>
            <option value="<%= b.id %>"><%= b.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="row">
      <div class="field">
        <label>요청 법인 <span class="req">*</span></label>
        <select name="requester_group_id" required>
          <option value="">법인을 선택하세요</option>
          <% groups.forEach(function (g) { %>
            <option value="<%= g.id %>" data-branch="<%= g.branch_id %>"><%= g.name %></option>
          <% }) %>
        </select>
        <p class="page-sub">청구·귀속 기준일 뿐 아니라 주문 조회 경계이기도 합니다 — 같은 담당 계정을 여러 법인 매핑이 함께 써도, 이 값이 있어야 서로의 접수 건이 섞이지 않습니다.</p>
      </div>
      <div class="field">
        <label>결제수단</label>
        <select name="payment_method_id">
          <option value="">지정 안 함</option>
          <% paymentMethods.forEach(function (p) { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="field full">
      <label class="checkline">
        <input type="checkbox" name="auto_register" value="1" checked>
        접수 폼을 받으면 <strong>오더를 자동 등록</strong>한다
      </label>
      <p class="page-sub">
        자동 등록된 오더는 상태가 <strong>오더등록</strong>이고 콜마너에도 <strong>대기</strong>로 접수되어,
        담당자가 확인하기 전에 배차가 돌지 않습니다(웹 챗봇과 동일). 꺼두면 파싱만 하고 상담원에게 인계합니다 —
        꺼져 있어도 <strong>주문 조회·변경·취소(배차 도우미)는 동작</strong>합니다.
      </p>
    </div>
  </form>
</div>

<div class="card" style="margin-top:16px">
  <div class="section-title">📋 등록된 채널 매핑</div>
  <% if (!accounts.length) { %>
    <p class="page-sub" style="margin:0">등록된 매핑이 없습니다. 지금은 모든 카카오 문의가 상담원 연결로 넘어갑니다.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th>대상</th><th>담당 계정</th><th>지사 / 법인</th><th>결제수단</th>
          <th style="width:90px">자동등록</th><th style="width:80px">사용</th><th style="width:150px">등록일시</th><th style="width:70px"></th>
        </tr>
      </thead>
      <tbody>
        <% accounts.forEach(function (a) { %>
          <tr>
            <td>
              <% if (a.label) { %><strong><%= a.label %></strong><br><% } %>
              <span class="page-sub">
                <% if (a.external_user_key) { %>고객 <%= a.external_user_key %><br><% } %>
                service <%= a.service_key ? String(a.service_key).slice(0, 16) + '…' : '(전체)' %>
              </span>
            </td>
            <td><%= a.user_name || '(삭제된 계정)' %><br><span class="page-sub"><%= a.login_id || '' %></span></td>
            <td><%= a.branch_name || '-' %><br><span class="page-sub"><%= a.group_name || '법인 미지정' %></span></td>
            <td><%= a.payment_name || '-' %></td>
            <td>
              <form method="POST" action="/kakao-accounts/<%= a.id %>/toggle-auto">
                <button class="btn small <%= a.auto_register ? '' : 'secondary' %>" type="submit"><%= a.auto_register ? '켜짐' : '꺼짐' %></button>
              </form>
            </td>
            <td>
              <form method="POST" action="/kakao-accounts/<%= a.id %>/toggle-enabled">
                <button class="btn small <%= a.enabled ? '' : 'secondary' %>" type="submit"><%= a.enabled ? '사용' : '중지' %></button>
              </form>
            </td>
            <td><%= a.created_at %></td>
            <td>
              <form method="POST" action="/kakao-accounts/<%= a.id %>/delete"
                    onsubmit="return confirm('이 채널 매핑을 삭제할까요? 해당 채널은 상담원 연결로만 처리됩니다.')">
                <button class="btn small danger" type="submit">삭제</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
  <% if (error) { %>
    // 등록 실패는 배너로도 보이지만(위 .error-msg), 특히 "이미 등록된 사용자입니다" 같은
    // 실수 방지 안내는 놓치기 쉬워 팝업으로도 띄운다(사용자 확정 요청).
    alert(<%- JSON.stringify(error) %>);
  <% } %>

  // 최근 세션에서 키 자동 채우기 — 이름·연락처는 "미등록계정" 등록 시 사용자 등록 화면으로
  // 넘길 값으로 함께 기억해둔다(pickedName/pickedPhone).
  var pickedName = '';
  var pickedPhone = '';
  (function () {
    var picker = document.getElementById('sessionKeyPicker');
    if (!picker) return;
    picker.addEventListener('change', function () {
      var parts = String(this.value || '').split('|');
      var form = document.getElementById('kakaoAccountForm');
      form.service_key.value = parts[0] || '';
      form.external_user_key.value = parts[1] || '';
      var opt = this.options[this.selectedIndex];
      pickedName = (opt && opt.dataset.name) || '';
      pickedPhone = (opt && opt.dataset.phone) || '';
    });
  })();

  // "미등록계정"을 고르고 등록을 누르면 저장을 시도하지 않고(담당 계정이 없어 서버가 막는다)
  // 사용자 등록 화면으로 이름·연락처·지사를 채워 보낸다. 새 계정을 만든 뒤에는 이 화면으로
  // 돌아와(return_to) 방금 만든 계정을 담당 계정으로 고르면 된다.
  (function () {
    var form = document.getElementById('kakaoAccountForm');
    form.addEventListener('submit', function (e) {
      if (form.user_id.value !== '__unregistered__') return;
      e.preventDefault();
      var params = new URLSearchParams();
      if (pickedName) params.set('name', pickedName);
      if (pickedPhone) params.set('phone', pickedPhone);
      if (form.branch_id.value) params.set('branch_id', form.branch_id.value);
      params.set('return_to', '/kakao-accounts');
      window.location.href = '/users/new?' + params.toString();
    });
  })();

  // 지사를 고르면 그 지사 법인만 남긴다 — 서버에서도 같은 검증을 한다.
  (function () {
    var form = document.getElementById('kakaoAccountForm');
    var branchSelect = form.branch_id;
    var groupSelect = form.requester_group_id;
    var allGroups = Array.prototype.slice.call(groupSelect.options);
    branchSelect.addEventListener('change', function () {
      var branchId = this.value;
      groupSelect.innerHTML = '';
      allGroups.forEach(function (opt) {
        if (!opt.value || !branchId || opt.dataset.branch === branchId) groupSelect.appendChild(opt.cloneNode(true));
      });
    });
  })();
</script>
<%- include('../partials/footer') %>
