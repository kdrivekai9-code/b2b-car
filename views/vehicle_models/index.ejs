<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">차종 관리</h1>
    <%# 예전 안내문은 "여기 등록된 판정값으로 붙습니다"였는데, 그 말대로 읽으면 등록하지 않은
        차종에는 할증이 안 붙는 줄 안다(실사용 지적 2026-08-28: "등록화면에 내가 등록한 것밖에
        안 보인다"). 실제로는 등록이 없으면 아래 내장 사전으로 자동 판정해서 붙는다. %>
    <p class="page-sub">
      요금설정의 <b>수입차 · 대형/화물 · 전기차 할증</b>은 <b>등록하지 않은 차종에도 붙습니다</b> —
      등록이 없으면 아래 <b>자동 인식 사전</b>으로 그 자리에서 판정합니다.
      이 목록은 <b>사전이 틀렸을 때 바로잡는 곳</b>입니다. 등록해두면 그 값이 사전보다 우선합니다.
    </p>
  </div>
</div>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (migrationMissing) { %>
  <div class="alert error">차종 테이블이 아직 없습니다. 마이그레이션(20260828010000)을 실행해주세요.</div>
<% } %>

<div class="card">
  <div class="section-title">➕ 차종 등록</div>
  <form method="POST" action="/vehicle-models" class="row" style="align-items:flex-end;">
    <input type="hidden" name="q" value="<%= q %>">
    <div class="field" style="flex:2;">
      <label>차종명</label>
      <input type="text" name="name" placeholder="예: 카니발 9인승 / BMW 520d / 봉고3 1톤" required>
      <p class="page-sub">브랜드가 들어가면 수입 여부를, "전기차·EV"가 들어가면 전기차를, "톤·승합·카니발" 등은 대형/화물을 자동으로 잡습니다.</p>
    </div>
    <div class="field"><button class="btn" type="submit">등록</button></div>
  </form>
  <% if (preview) { %>
    <p class="page-sub">
      <b><%= previewName %></b> 자동 판정 →
      car_type <b><%= preview.carType %></b> ·
      fuel_type <b><%= preview.fuelType || '-' %></b> ·
      수입 <b><%= preview.isImported ? 'O' : '-' %></b> ·
      대형/화물 <b><%= preview.isLarge ? 'O' : '-' %></b> ·
      전기 <b><%= preview.isEv ? 'O' : '-' %></b>
      <%= preview.reasons.length ? '(' + preview.reasons.join(', ') + ')' : '' %>
    </p>
  <% } %>
</div>

<div class="card">
  <div class="section-title">📋 등록된 차종 (<%= rows.length %>건)</div>
  <form method="GET" action="/vehicle-models" class="row" style="align-items:flex-end;">
    <div class="field" style="flex:2;">
      <label>차종명 검색</label>
      <input type="text" name="q" value="<%= q %>" placeholder="차종명 일부">
    </div>
    <div class="field"><button class="btn secondary" type="submit">검색</button></div>
  </form>

  <form method="POST" action="/vehicle-models/bulk" id="bulkForm">
    <input type="hidden" name="q" value="<%= q %>">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>차종명</th>
            <th style="width:90px;">car_type</th>
            <th style="width:80px;">fuel_type</th>
            <th style="width:80px;">수입차</th>
            <th style="width:95px;">대형/화물</th>
            <th style="width:80px;">전기차</th>
            <th style="width:20%;">자동 판정 근거</th>
            <th style="width:70px;"></th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="8" class="page-sub">등록된 차종이 없습니다. 위에서 등록해주세요.</td></tr>
          <% } %>
          <% rows.forEach(function (r) { %>
            <%# 자동 판정과 확정값이 갈린 줄은 사람이 고친 것이다 — 사전을 손볼 단서라 표시해 둔다. %>
            <% const edited = (!!r.is_imported !== !!r.auto_imported) || (!!r.is_large !== !!r.auto_large) || (!!r.is_ev !== !!r.auto_ev) %>
            <tr>
              <td>
                <input type="hidden" name="model_id" value="<%= r.id %>">
                <%= r.name %>
                <% if (edited) { %><span class="page-sub">· 수정됨</span><% } %>
              </td>
              <%# car_type/fuel_type은 체크박스에서 파생되는 값이라 직접 고치지 않는다 —
                  따로 손댈 수 있게 하면 목록은 '국산'인데 요금은 수입 할증이 붙는 상태가 생긴다. %>
              <td><b><%= r.car_type || '-' %></b></td>
              <td><%= r.fuel_type || '-' %></td>
              <td><input type="checkbox" name="is_imported" value="<%= r.id %>" <%= r.is_imported ? 'checked' : '' %>></td>
              <td><input type="checkbox" name="is_large" value="<%= r.id %>" <%= r.is_large ? 'checked' : '' %>></td>
              <td><input type="checkbox" name="is_ev" value="<%= r.id %>" <%= r.is_ev ? 'checked' : '' %>></td>
              <td class="page-sub"><%= r.note || '-' %></td>
              <td>
                <button type="submit" class="btn small secondary" formaction="/vehicle-models/<%= r.id %>/delete" formmethod="POST">삭제</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (rows.length) { %>
      <button class="btn" type="submit" style="margin-top:12px;">판정값 저장</button>
      <p class="page-sub">체크를 고치면 이후 접수부터 그 값이 적용됩니다. 이미 접수된 오더의 요금은 바뀌지 않습니다.</p>
    <% } %>
  </form>
</div>

<%# ── 자동 인식 사전 ────────────────────────────────────────────────────────
    코드(lib/vehicleClass.js)에 박아둔 목록이라 이 화면에서 고칠 수 없다. 그래도 보여주는
    이유: 무엇이 이미 인식되는지 모르면 관리자는 "등록된 몇 건만 할증이 붙는다"고 오해하고,
    이미 잡히는 차종을 중복 등록하거나 반대로 새는 차종을 못 찾는다. %>
<div class="card">
  <div class="section-title">🔎 자동 인식 사전 — 등록 없이 판정되는 이름</div>
  <p class="page-sub">
    아래 낱말이 차종명에 들어 있으면 등록하지 않아도 자동으로 판정합니다.
    표기가 흔들려도(<code>benz E250</code>, <code>벤츠e클래스</code>) 잡습니다.
    <b>여기 없는 이름은 국산·일반으로 떨어져 할증이 붙지 않습니다</b> — 그런 차종을 발견하면 위에서 등록해주세요.
  </p>
  <div class="field" style="max-width:320px;">
    <label for="dictFilter">사전 검색</label>
    <input type="text" id="dictFilter" placeholder="예: 벤츠, tesla, 톤">
  </div>
  <% dictionaries.forEach(function (d) { %>
    <details class="dict-group" data-key="<%= d.key %>" style="margin-top:10px;">
      <summary><b><%= d.label %></b> <span class="page-sub">(<%= d.words.length %>개)</span></summary>
      <div class="dict-words" style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;">
        <% d.words.forEach(function (w) { %>
          <span class="badge gray dict-word" style="font-weight:normal;"><%= w %></span>
        <% }) %>
      </div>
    </details>
  <% }) %>
  <p class="page-sub" style="margin-top:12px;">
    위 목록은 코드에 들어 있어 화면에서 지울 수 없습니다. <b>빠진 이름은 아래에서 더하세요</b> —
    브랜드를 한 번 더하면 그 브랜드의 <b>모든 모델</b>이 잡힙니다(차종마다 등록하지 않아도 됩니다).
  </p>

  <%# 코드 사전과 따로 둔다. 지울 수 있는 것은 여기 있는 것뿐이라, 섞어 놓으면
      "왜 이건 삭제가 안 되지"가 된다. %>
  <div class="section-title" style="font-size:14px;margin-top:16px;">➕ 낱말 추가 (<%= addedKeywords.length %>개 추가됨)</div>
  <form method="POST" action="/vehicle-models/keywords" class="row" style="align-items:flex-end;">
    <div class="field">
      <label>분류</label>
      <select name="kind" required>
        <% keywordKinds.forEach(function (k) { %>
          <option value="<%= k.key %>"><%= k.label %></option>
        <% }) %>
      </select>
    </div>
    <div class="field" style="flex:1;">
      <label>낱말</label>
      <input type="text" name="word" placeholder="예: 쿠프라 / EX30 / 이트론" required minlength="2">
    </div>
    <div class="field" style="flex:1;">
      <label>비고</label>
      <input type="text" name="note" placeholder="예: 2026년 국내 출시">
    </div>
    <div class="field"><button class="btn" type="submit">추가</button></div>
  </form>
  <p class="page-sub">
    차종명에 이 낱말이 <b>들어 있기만 하면</b> 판정됩니다. 그래서 한 글자는 받지 않습니다 —
    아무 이름에나 걸려 국산차를 수입으로 만듭니다. 추가는 1분 안에 접수에 반영됩니다.
  </p>

  <% if (addedKeywords.length) { %>
    <div class="table-wrap" style="margin-top:10px;">
      <table class="table">
        <thead><tr><th style="width:160px;">분류</th><th>낱말</th><th>비고</th><th style="width:70px;"></th></tr></thead>
        <tbody>
          <% addedKeywords.forEach(function (k) { %>
            <tr>
              <td><%= (keywordKinds.find(function (x) { return x.key === k.kind; }) || {}).label || k.kind %></td>
              <td><b><%= k.word %></b></td>
              <td class="page-sub"><%= k.note || '-' %></td>
              <td>
                <form method="POST" action="/vehicle-models/keywords/<%= k.id %>/delete">
                  <button class="btn small secondary" type="submit">삭제</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
  (function () {
    var input = document.getElementById('dictFilter');
    if (!input) return;
    var groups = Array.prototype.slice.call(document.querySelectorAll('.dict-group'));
    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      groups.forEach(function (g) {
        var words = Array.prototype.slice.call(g.querySelectorAll('.dict-word'));
        var hit = 0;
        words.forEach(function (w) {
          var match = !q || w.textContent.toLowerCase().indexOf(q) !== -1;
          w.style.display = match ? '' : 'none';
          if (match) hit += 1;
        });
        // 검색 중에는 걸린 묶음만 펼쳐 보여준다 — 빈 묶음이 남아 있으면 "없음"인지 "안 펼침"인지 헷갈린다.
        g.style.display = (q && !hit) ? 'none' : '';
        if (q) g.open = hit > 0;
      });
    });
  })();
</script>

<% if (saved) { %><div class="toast">저장되었습니다.</div><% } %>
<%- include('../partials/footer') %>
