<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">차종 관리</h1>
    <p class="page-sub">
      요금설정의 <b>수입차 · 대형/화물 · 전기차 할증</b>이 여기 등록된 판정값으로 붙습니다.
      차종을 등록하면 이름으로 자동 판정하고, 틀린 줄은 체크를 고쳐 저장하면 그 값이 계속 쓰입니다.
    </p>
  </div>
</div>

<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<% if (migrationMissing) { %>
  <div class="alert error">차종 테이블이 아직 없습니다. 마이그레이션(20260828010000)을 실행해주세요.</div>
<% } %>

<div class="card">
  <div class="section-title">➕ 차종 등록</div>
  <form method="POST" action="/vehicle-models" class="row" style="align-items:flex-end;">
    <input type="hidden" name="q" value="<%= q %>">
    <div class="field" style="flex:2;">
      <label>차종명</label>
      <input type="text" name="name" placeholder="예: 카니발 9인승 / BMW 520d / 봉고3 1톤" required>
      <p class="page-sub">브랜드가 들어가면 수입 여부를, "전기차·EV"가 들어가면 전기차를, "톤·승합·카니발" 등은 대형/화물을 자동으로 잡습니다.</p>
    </div>
    <div class="field"><button class="btn" type="submit">등록</button></div>
  </form>
  <% if (preview) { %>
    <p class="page-sub">
      <b><%= previewName %></b> 자동 판정 →
      수입 <b><%= preview.isImported ? 'O' : '-' %></b> ·
      대형/화물 <b><%= preview.isLarge ? 'O' : '-' %></b> ·
      전기 <b><%= preview.isEv ? 'O' : '-' %></b>
      <%= preview.reasons.length ? '(' + preview.reasons.join(', ') + ')' : '' %>
    </p>
  <% } %>
</div>

<div class="card">
  <div class="section-title">📋 등록된 차종 (<%= rows.length %>건)</div>
  <form method="GET" action="/vehicle-models" class="row" style="align-items:flex-end;">
    <div class="field" style="flex:2;">
      <label>차종명 검색</label>
      <input type="text" name="q" value="<%= q %>" placeholder="차종명 일부">
    </div>
    <div class="field"><button class="btn secondary" type="submit">검색</button></div>
  </form>

  <form method="POST" action="/vehicle-models/bulk" id="bulkForm">
    <input type="hidden" name="q" value="<%= q %>">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>차종명</th>
            <th style="width:90px;">수입차</th>
            <th style="width:110px;">대형/화물</th>
            <th style="width:90px;">전기차</th>
            <th style="width:24%;">자동 판정 근거</th>
            <th style="width:70px;"></th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="6" class="page-sub">등록된 차종이 없습니다. 위에서 등록해주세요.</td></tr>
          <% } %>
          <% rows.forEach(function (r) { %>
            <%# 자동 판정과 확정값이 갈린 줄은 사람이 고친 것이다 — 사전을 손볼 단서라 표시해 둔다. %>
            <% const edited = (!!r.is_imported !== !!r.auto_imported) || (!!r.is_large !== !!r.auto_large) || (!!r.is_ev !== !!r.auto_ev) %>
            <tr>
              <td>
                <input type="hidden" name="model_id" value="<%= r.id %>">
                <%= r.name %>
                <% if (edited) { %><span class="page-sub">· 수정됨</span><% } %>
              </td>
              <td><input type="checkbox" name="is_imported" value="<%= r.id %>" <%= r.is_imported ? 'checked' : '' %>></td>
              <td><input type="checkbox" name="is_large" value="<%= r.id %>" <%= r.is_large ? 'checked' : '' %>></td>
              <td><input type="checkbox" name="is_ev" value="<%= r.id %>" <%= r.is_ev ? 'checked' : '' %>></td>
              <td class="page-sub"><%= r.note || '-' %></td>
              <td>
                <button type="submit" class="btn small secondary" formaction="/vehicle-models/<%= r.id %>/delete" formmethod="POST">삭제</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (rows.length) { %>
      <button class="btn" type="submit" style="margin-top:12px;">판정값 저장</button>
      <p class="page-sub">체크를 고치면 이후 접수부터 그 값이 적용됩니다. 이미 접수된 오더의 요금은 바뀌지 않습니다.</p>
    <% } %>
  </form>
</div>

<% if (saved) { %><div class="toast">저장되었습니다.</div><% } %>
<%- include('../partials/footer') %>
