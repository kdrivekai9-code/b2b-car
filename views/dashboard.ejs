<%- include('partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">통합 대시보드</h1>
    <p class="page-sub">기간별 오더 현황, 시간대 분포, 지사·법인별 비교를 확인합니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn" href="/orders/new">+ 오더 등록</a>
  </div>
</div>

<div class="card">
  <div class="period-row">
    <div class="period-presets">
      <a class="btn small <%= period.preset==='' || period.preset==='all' ? '' : 'secondary' %>" href="?period=all">전체</a>
      <a class="btn small <%= period.preset==='yesterday' ? '' : 'secondary' %>" href="?period=yesterday">전일</a>
      <a class="btn small <%= period.preset==='today' ? '' : 'secondary' %>" href="?period=today">금일</a>
      <a class="btn small <%= period.preset==='last_week' ? '' : 'secondary' %>" href="?period=last_week">전주</a>
      <a class="btn small <%= period.preset==='this_week' ? '' : 'secondary' %>" href="?period=this_week">금주</a>
      <a class="btn small <%= period.preset==='last_month' ? '' : 'secondary' %>" href="?period=last_month">전월</a>
      <a class="btn small <%= period.preset==='this_month' ? '' : 'secondary' %>" href="?period=this_month">금월</a>
    </div>
    <form method="GET" class="period-custom">
      <input type="hidden" name="period" value="custom">
      <input type="date" name="from" value="<%= period.from || '' %>">
      <span>~</span>
      <input type="date" name="to" value="<%= period.to || '' %>">
      <button class="btn small" type="submit">조회</button>
    </form>
  </div>
  <p class="page-sub" style="margin:10px 0 0;">적용 기간: <b><%= period.from ? (period.from + ' ~ ' + period.to) : '전체 기간' %></b></p>
</div>

<div class="kpi-grid">
  <div class="kpi accent"><div class="label">총 오더수</div><div class="value"><%= totalOrders %>건</div></div>
  <div class="kpi"><div class="label">요금 합계</div><div class="value" style="font-size:18px;"><%= formatMoney(totalFare) %></div></div>
  <div class="kpi"><div class="label">미배정(등록/대기/접수)</div><div class="value"><%= unassigned %>건</div></div>
  <div class="kpi"><div class="label">진행중(배정중/기사배정)</div><div class="value"><%= inProgress %>건</div></div>
  <div class="kpi"><div class="label">완료</div><div class="value"><%= completed %>건</div></div>
  <div class="kpi"><div class="label">이슈(문의/사고/취소 등)</div><div class="value"><%= issues %>건</div></div>
</div>

<div class="dashboard-card-grid">
<section class="card dashboard-analysis-card">
  <h2>⏱ 시간대 분포 <small class="page-sub" style="font-weight:400;">(오더 등록 시각 기준)</small></h2>
  <div class="kpi-grid" style="margin-bottom:16px;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));">
    <div class="kpi"><div class="label">총 콜수</div><div class="value"><%= totalOrders %>건</div></div>
    <div class="kpi"><div class="label">피크 시간</div><div class="value"><%= totalOrders ? (peakHour + '시') : '-' %></div></div>
    <div class="kpi"><div class="label">활동 시간대</div><div class="value"><%= activeHours %>개 / 평균 <%= avgPerActiveHour %>건</div></div>
  </div>
  <div class="table-wrap">
    <div class="hour-chart">
      <% var hourMax = Math.max(1, ...hourly); %>
      <% for (var h = 0; h < 24; h++) { %>
        <div class="hour-bar-col">
          <div class="hour-bar-track"><div class="hour-bar" style="height:<%= Math.round(hourly[h] / hourMax * 100) %>%" title="<%= h %>시: <%= hourly[h] %>건"></div></div>
          <div class="hour-bar-label"><%= h %></div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="card dashboard-analysis-card">
  <h2>📅 요일 × 시간 히트맵</h2>
  <div class="table-wrap">
    <div class="heatmap-grid">
      <div class="heatmap-cell heatmap-corner"></div>
      <% for (var hh = 0; hh < 24; hh++) { %><div class="heatmap-cell heatmap-label"><%= hh %></div><% } %>
      <% DOW_LABELS.forEach(function(dowLabel, dowIdx){ %>
        <div class="heatmap-cell heatmap-label"><%= dowLabel %></div>
        <% for (var h2 = 0; h2 < 24; h2++) { %>
          <% var v = heatmap[dowIdx][h2]; %>
          <div class="heatmap-cell" style="background:rgba(46,92,138,<%= v ? (0.15 + 0.85 * v / heatmapMax).toFixed(2) : 0.04 %>)" title="<%= dowLabel %>요일 <%= h2 %>시: <%= v %>건"><%= v || '' %></div>
        <% } %>
      <% }) %>
    </div>
  </div>
</section>
</div>

<% if (showBranchSections) { %>
<div class="dashboard-card-grid">
<section class="card dashboard-analysis-card">
  <h2>🏢 지사별 비교 <small class="page-sub" style="font-weight:400;">(직전 동일 기간 대비)</small></h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>지사</th><th>콜수</th><th>이전 콜수</th><th>증감</th><th>매출</th><th>이전 매출</th><th>증감</th></tr></thead>
    <tbody>
      <% if (branchCompare.length === 0) { %><tr><td colspan="7" class="empty">데이터가 없습니다.</td></tr><% } %>
      <% branchCompare.forEach(function(b){ %>
        <tr>
          <td><%= b.branch_name %></td>
          <td><%= b.cnt %>건</td>
          <td><%= b.prev_cnt %>건</td>
          <td><%= b.cnt_pct === null ? '-' : ((b.cnt_pct >= 0 ? '+' : '') + b.cnt_pct + '%') %></td>
          <td><%= formatMoney(b.fare) %></td>
          <td><%= formatMoney(b.prev_fare) %></td>
          <td><%= b.fare_pct === null ? '-' : ((b.fare_pct >= 0 ? '+' : '') + b.fare_pct + '%') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</section>

<section class="card dashboard-analysis-card">
  <h2>🗂 지사별 상태 디테일</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>지사</th><% ORDER_STATUSES.forEach(function(s){ %><th><%= s %></th><% }) %><th>합계</th><th>매출</th></tr></thead>
    <tbody>
      <% if (statusMatrix.length === 0) { %><tr><td colspan="<%= ORDER_STATUSES.length + 3 %>" class="empty">데이터가 없습니다.</td></tr><% } %>
      <% statusMatrix.forEach(function(row){ %>
        <tr>
          <td><%= row.branch_name %></td>
          <% ORDER_STATUSES.forEach(function(s){ %><td><%= row.statuses[s] || 0 %></td><% }) %>
          <td><b><%= row.total %></b></td>
          <td><%= formatMoney(row.fare) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</section>
</div>
<% } %>

<div class="card">
  <h2>👥 법인별 콜수·매출</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>법인(고객사)</th><th>콜수</th><th>매출</th></tr></thead>
    <tbody>
          <% if (groupCompare.length === 0) { %><tr><td colspan="3" class="empty">법인별 데이터가 없습니다.</td></tr><% } %>
      <% groupCompare.forEach(function(g){ %>
        <tr><td><%= g.group_name %></td><td><%= g.cnt %>건</td><td><%= formatMoney(g.fare) %></td></tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('partials/footer') %>
