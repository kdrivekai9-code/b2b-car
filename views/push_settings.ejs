<%- include('partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">오더 알림 설정</h1>
    <%# 문구가 역할마다 달라야 한다. 고객에게 "본인이 등록한 오더는 알림이 안 온다"고 적어두면
        정확히 반대다 — 고객은 **자기 오더**의 진행을 알려고 이 화면에 온다. 그 문구는 관리자
        기준(excludeUserId)이고, 고객용 알림은 lib/push.js notifyUser가 따로 보낸다. %>
    <% if (currentUser.role === 'client') { %>
      <p class="page-sub">이 브라우저(기기)에서 <strong>내 오더의 진행 알림</strong>을 받습니다. 배차·운행시작·운행완료·취소가 있을 때 상담창을 열지 않아도 알림이 뜹니다.</p>
    <% } else { %>
      <p class="page-sub">이 브라우저(기기)에서 받을 알림 이벤트를 설정하세요. 본인이 등록/수정한 오더는 본인에게 알림이 표시되지 않습니다.</p>
    <% } %>
  </div>
</div>

<div class="card">
  <div id="pushStatus" class="page-sub">알림 구독 상태를 확인 중...</div>

  <div class="section-title small">알림 받을 이벤트</div>
  <div class="row">
    <% if (currentUser.role === 'client') { %>
      <%# 고객에게는 종류가 하나다. 서버는 이 값을 notify_order_events로 읽는다
          (lib/push.js notifyUser) — 칸을 새로 만들지 않아 마이그레이션이 필요 없다.
          기사 배정 알림은 지사 범위로 도는 관리자용이라 고객 화면에서 뺀다. %>
      <div class="field"><label class="checkline"><input type="checkbox" id="notifyOrderEvents" checked> <strong>내 오더 진행 알림</strong> (전체 스위치)</label></div>
    </div>
    <%# 종류별 선택. 목록·이름은 통보 모듈이 정한 것을 그대로 받는다(routes/push.js
        clientEventTypes) — 화면에 따로 적으면 종류가 늘거나 이름이 바뀔 때 둘이 갈린다.
        전부 체크한 상태는 "고르지 않음"과 같게 저장한다(NULL) — 종류가 늘어나면 새 종류까지
        자동으로 받는다. 하나도 안 고르면 위 전체 스위치를 끈 것과 같다. %>
    <p class="page-sub" style="margin:2px 0 6px;">받고 싶은 종류만 고를 수 있습니다. 전체 스위치를 끄면 아래 선택과 무관하게 오지 않습니다.</p>
    <div class="row" id="eventTypeRow">
      <% (typeof eventTypes !== 'undefined' ? eventTypes : []).forEach(function (t) { %>
        <div class="field"><label class="checkline"><input type="checkbox" class="evt" value="<%= t.key %>" checked> <%= t.label %></label></div>
      <% }) %>
    <% } else { %>
      <div class="field"><label class="checkline"><input type="checkbox" id="notifyOrderEvents" checked> 오더 등록/수정 알림</label></div>
      <div class="field"><label class="checkline"><input type="checkbox" id="notifyDriverAssign" checked> 기사 배정 알림</label></div>
    <% } %>
    <% if (currentUser.role === 'admin') { %>
    <div class="field"><label class="checkline"><input type="checkbox" id="notifyAgentCall" checked> 상담원 호출 알림 (AI 챗봇)</label></div>
    <%# 장애 알림은 기본으로 켠다 — 켜야 의미가 있는 알림이고, 이게 없으면 연동이 멈춰도 아무도 모른다. %>
    <div class="field"><label class="checkline"><input type="checkbox" id="notifySystemAlert" checked> 시스템 장애 알림 (연동 오류 · 동기화 지연)</label></div>
    <div class="field"><label class="checkline"><input type="checkbox" id="notifyPlateMismatch" checked> 번호판 상이 알림 (접수 번호 ≠ 운행시작 사진)</label></div>
    <% } %>
  </div>

  <% if (currentUser.role === 'admin') { %>
  <div class="section-title small">상담원 호출 알림음 (이 브라우저)</div>
  <p class="page-sub" style="margin-top:-6px;">사이드바 배지가 뜰 때 이 브라우저 탭에서 재생되는 알림음입니다. 웹 푸시와는 별개로, 로그인해 있는 동안 어느 페이지에서나 적용됩니다. 이 브라우저에만 저장됩니다.</p>
  <div class="row">
    <div class="field"><label class="checkline"><input type="checkbox" id="agentSoundEnabled"> 알림음 켜기</label></div>
    <div class="field">
      <label>소리 종류</label>
      <select id="agentSoundTone">
        <option value="beep">비프음</option>
        <option value="chime">차임벨</option>
        <option value="urgent">긴급(3연타)</option>
      </select>
    </div>
    <div class="field" style="align-self:flex-end;">
      <button class="btn secondary small" type="button" id="agentSoundPreviewBtn">🔊 미리듣기</button>
    </div>
  </div>

  <div class="section-title small">브라우저 알림 (백그라운드에서도 표시)</div>
  <p class="page-sub" style="margin-top:-6px;">이 브라우저 탭이 백그라운드에 있거나 다른 창에 가려져 있어도, 상담원 호출이 오면 OS 알림창으로 띄웁니다.</p>
  <div class="row">
    <div class="field" id="browserNotifyPermRow" style="display:none;">
      <button class="btn small" type="button" id="browserNotifyPermBtn">🔔 브라우저 알림 허용하기</button>
    </div>
    <div class="field" id="browserNotifyToggleRow" style="display:none;">
      <label class="checkline"><input type="checkbox" id="browserNotifyEnabled"> 브라우저 알림 켜기</label>
    </div>
    <div class="field" id="browserNotifyDeniedRow" style="display:none;">
      <span class="page-sub" style="margin:0;">브라우저 설정에서 알림이 차단되어 있습니다. 주소창 왼쪽의 사이트 설정에서 알림을 허용해주세요.</span>
    </div>
  </div>
  <% } %>

  <% if (branches.length) { %>
  <div class="section-title small">지사 범위</div>
  <div class="field">
    <select id="branchScope">
      <option value="">전체 지사</option>
      <% branches.forEach(function(b){ %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
    </select>
  </div>
  <% } %>

  <div style="margin-top:18px;display:flex;gap:8px;">
    <button class="btn" id="pushSubscribeBtn">알림 켜기 / 설정 저장</button>
    <button class="btn secondary" id="pushUnsubscribeBtn">알림 끄기</button>
  </div>
</div>

<% if (currentUser.role === 'admin') { %>
<script>
(function () {
  var enabledEl = document.getElementById('agentSoundEnabled');
  var toneEl = document.getElementById('agentSoundTone');
  var previewBtn = document.getElementById('agentSoundPreviewBtn');
  if (!enabledEl || !window.AgentAlertSound) return;
  enabledEl.checked = window.AgentAlertSound.isEnabled();
  toneEl.value = window.AgentAlertSound.getTone();
  enabledEl.addEventListener('change', function () { window.AgentAlertSound.setEnabled(enabledEl.checked); });
  toneEl.addEventListener('change', function () { window.AgentAlertSound.setTone(toneEl.value); });
  previewBtn.addEventListener('click', function () { window.AgentAlertSound.play(toneEl.value); });
})();
(function () {
  var api = window.AgentBrowserNotify;
  var permRow = document.getElementById('browserNotifyPermRow');
  var permBtn = document.getElementById('browserNotifyPermBtn');
  var toggleRow = document.getElementById('browserNotifyToggleRow');
  var toggleEl = document.getElementById('browserNotifyEnabled');
  var deniedRow = document.getElementById('browserNotifyDeniedRow');
  if (!api || !permRow) return;

  function refresh() {
    var perm = api.permission();
    permRow.style.display = perm === 'default' ? '' : 'none';
    toggleRow.style.display = perm === 'granted' ? '' : 'none';
    deniedRow.style.display = perm === 'denied' ? '' : 'none';
    if (perm === 'granted') toggleEl.checked = api.isEnabled();
  }
  refresh();

  permBtn.addEventListener('click', function () {
    api.requestPermission().then(refresh);
  });
  toggleEl.addEventListener('change', function () { api.setEnabled(toggleEl.checked); });
})();
</script><% } %>
<script>
(async function () {
  var statusEl = document.getElementById('pushStatus');
  async function refreshStatus() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      statusEl.textContent = '이 브라우저는 푸시 알림을 지원하지 않습니다.';
      return;
    }
    // 구독 조회가 실패하면(서비스워커 등록 실패·비공개 모드 등) 여기서 예외가 나고, 위에서
    // 잡지 않으면 화면이 "확인 중..."에 영원히 멎는다 — 고장난 것으로 보인다.
    var sub = null;
    try {
      sub = await window.__push.getSubscription();
    } catch (e) {
      statusEl.textContent = '알림 구독 상태를 확인할 수 없습니다. 브라우저 설정에서 알림을 허용했는지 확인해주세요.';
      return;
    }
    if (!sub) { statusEl.textContent = '이 브라우저는 아직 알림을 받지 않습니다.'; return; }

    // 저장된 값을 되읽어 체크 상태를 맞춘다. 이게 없으면 화면은 늘 "전부 켜짐"으로 보이고,
    // 종류를 골라 저장해도 다시 들어오면 전부 켜진 것처럼 나온다 — 저장이 안 된 줄로 읽힌다.
    var saved = null;
    try {
      var res = await fetch('/push/status?endpoint=' + encodeURIComponent(sub.endpoint), { credentials: 'same-origin' });
      if (res.ok) saved = await res.json();
    } catch (e) { /* 상태를 못 읽어도 화면은 열려야 한다 */ }

    statusEl.textContent = (saved && saved.effective === false)
      ? '⚠️ 구독은 있지만 켜진 알림이 없어 실제로는 오지 않습니다.'
      : '✅ 이 브라우저는 알림을 받도록 설정되어 있습니다.';

    if (saved && saved.sub) {
      var oe = document.getElementById('notifyOrderEvents');
      if (oe) oe.checked = Number(saved.sub.notify_order_events) === 1;
      // event_types가 비어 있으면 전부 켜짐이다(고르지 않았다는 뜻 — routes/push.js 주석).
      var picked = String(saved.sub.event_types || '').split(',').map(function (v) { return v.trim(); }).filter(Boolean);
      document.querySelectorAll('#eventTypeRow .evt').forEach(function (el) {
        el.checked = picked.length === 0 || picked.indexOf(el.value) >= 0;
      });
    }
  }
  await refreshStatus();

  document.getElementById('pushSubscribeBtn').addEventListener('click', async function () {
    var notifyAgentCallEl = document.getElementById('notifyAgentCall');
    var notifyDriverAssignEl = document.getElementById('notifyDriverAssign');
    var notifySystemAlertEl = document.getElementById('notifySystemAlert');
    var notifyPlateMismatchEl = document.getElementById('notifyPlateMismatch');
    var prefs = {
      notify_order_events: document.getElementById('notifyOrderEvents').checked,
      // 고객 화면에는 이 체크박스가 없다(관리자용 지사 범위 알림) — 널 가드 없이 읽으면
      // 구독 버튼이 통째로 죽는다. 관리자 전용 셋과 같은 방식으로 다룬다.
      notify_driver_assign: notifyDriverAssignEl ? notifyDriverAssignEl.checked : true,
      notify_agent_call: notifyAgentCallEl ? notifyAgentCallEl.checked : true,
      notify_system_alert: notifySystemAlertEl ? notifySystemAlertEl.checked : true,
      notify_plate_mismatch: notifyPlateMismatchEl ? notifyPlateMismatchEl.checked : true,
    };
    var branchScope = document.getElementById('branchScope');
    if (branchScope) prefs.branch_id = branchScope.value || null;
    // 고른 종류를 함께 보낸다. 서버가 아는 종류만 남기고, 전부/아무것도는 NULL로 저장한다
    // (routes/push.js sanitizeEventTypes). 이 줄이 없으면 화면에서 골라도 저장되지 않는다.
    var evtEls = document.querySelectorAll('#eventTypeRow .evt');
    if (evtEls.length) {
      prefs.event_types = Array.prototype.filter.call(evtEls, function (el) { return el.checked; })
        .map(function (el) { return el.value; });
    }
    await window.__push.subscribe(prefs);
    await refreshStatus();
  });
  document.getElementById('pushUnsubscribeBtn').addEventListener('click', async function () {
    await window.__push.unsubscribe();
    await refreshStatus();
  });
})();
</script>
<%- include('partials/footer') %>
