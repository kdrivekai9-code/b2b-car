<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<%# 기사 화면은 휴대폰 전용이다. viewport-fit=cover는 아이폰 노치 아래 안전영역을 우리가
    직접 다루겠다는 선언이고, maximum-scale을 두지 않는 이유는 확대를 막으면 접근성이 깨져서다
    (기사 연령대가 넓다). %>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>기사 채팅</title>
<style>
  /* 한 손 조작이 전제다. 탭 목표는 최소 44px, 글씨는 16px 아래로 내리지 않는다 —
     iOS는 16px 미만 입력칸에 자동으로 확대를 걸어서 화면이 튄다. */
  :root{
    --bg:#f2f4f6; --card:#fff; --ink:#111; --muted:#666; --line:#e3e6ea;
    --me:#2f6fed; --me-ink:#fff; --accent:#c7a008;
    --safe-b: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark){
    :root{ --bg:#14171a; --card:#1d2126; --ink:#e9edf2; --muted:#9aa4b0; --line:#2a3038;
           --me:#4a86ff; --me-ink:#fff; --accent:#e0b93a; }
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    background:var(--bg); color:var(--ink);
    font:16px/1.55 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
    -webkit-text-size-adjust:100%;
    display:flex; flex-direction:column; height:100dvh;
  }
  header{
    background:var(--card); border-bottom:1px solid var(--line);
    padding:10px 14px calc(10px);
    padding-top:calc(10px + env(safe-area-inset-top, 0px));
  }
  .oid{font-size:13px;color:var(--muted)}
  .route{font-weight:600;margin-top:2px}
  .route .arrow{color:var(--muted);margin:0 5px}
  .veh{font-size:13px;color:var(--muted);margin-top:2px}

  /* 오더가 여럿이면 가로로 넘긴다 — 기사는 하루에 여러 건을 돈다. */
  .tabs{display:flex;gap:6px;overflow-x:auto;padding:8px 14px;background:var(--card);
        border-bottom:1px solid var(--line);scrollbar-width:none}
  .tabs::-webkit-scrollbar{display:none}
  .tab{flex:0 0 auto;padding:8px 12px;border:1px solid var(--line);border-radius:18px;
       background:var(--bg);color:var(--muted);font-size:13px;text-decoration:none;white-space:nowrap}
  .tab.on{background:var(--me);border-color:var(--me);color:var(--me-ink);font-weight:600}

  /* 할 일은 대화보다 위에 고정한다 — 스크롤로 밀려 올라가면 못 본다. */
  .tasks{margin:10px 14px 0;padding:12px 14px;background:var(--card);
         border:1px solid var(--accent);border-radius:10px}
  .tasks h2{margin:0 0 8px;font-size:14px}
  .tasks ul{margin:0;padding-left:18px}
  .tasks li{margin-bottom:5px}
  .tag{display:inline-block;margin-left:6px;padding:1px 7px;border-radius:10px;
       font-size:12px;background:var(--bg);color:var(--muted);border:1px solid var(--line)}
  .tag.need{color:var(--accent);border-color:var(--accent)}
  .memo{margin:10px 14px 0;padding:12px 14px;background:var(--card);
        border:1px solid var(--line);border-radius:10px;white-space:pre-wrap}
  .memo h2{margin:0 0 6px;font-size:14px;color:var(--muted)}

  .log{flex:1;overflow-y:auto;padding:12px 14px 4px;display:flex;flex-direction:column;gap:8px;
       -webkit-overflow-scrolling:touch}
  .bub{max-width:78%;padding:9px 12px;border-radius:14px;white-space:pre-wrap;word-break:break-word}
  .bub.them{align-self:flex-start;background:var(--card);border:1px solid var(--line);
            border-bottom-left-radius:4px}
  .bub.me{align-self:flex-end;background:var(--me);color:var(--me-ink);border-bottom-right-radius:4px}
  .who{display:block;font-size:11px;color:var(--muted);margin-bottom:2px}
  .bub.me .who{color:rgba(255,255,255,.8)}
  .empty{color:var(--muted);text-align:center;padding:24px 0;font-size:14px}

  /* 입력창은 화면 아래에 붙되 홈 인디케이터를 피한다. */
  form{display:flex;gap:8px;padding:10px 14px calc(10px + var(--safe-b));
       background:var(--card);border-top:1px solid var(--line)}
  textarea{
    flex:1;min-height:44px;max-height:120px;resize:none;
    padding:10px 12px;border:1px solid var(--line);border-radius:12px;
    font:inherit;background:var(--bg);color:var(--ink);
  }
  button{
    flex:0 0 auto;min-width:64px;min-height:44px;padding:0 16px;
    border:0;border-radius:12px;background:var(--me);color:var(--me-ink);
    font:inherit;font-weight:600;
  }
  button[disabled]{opacity:.5}
  .err{margin:8px 14px 0;padding:10px 12px;border-radius:8px;background:#fde8e8;color:#8a1f1f;font-size:14px}
  @media (prefers-color-scheme: dark){ .err{background:#3a1d1d;color:#f3b6b6} }
</style>
</head>
<body>
<header>
  <div class="oid" id="oid">불러오는 중…</div>
  <div class="route" id="route"></div>
  <div class="veh" id="veh"></div>
</header>

<nav class="tabs" id="tabs" hidden></nav>
<div class="err" id="err" hidden></div>
<section class="tasks" id="tasks" hidden></section>
<section class="memo" id="memo" hidden></section>

<div class="log" id="log"></div>

<form id="send">
  <textarea id="text" rows="1" placeholder="메시지를 입력하세요" enterkeyhint="send"></textarea>
  <button type="submit" id="btn">보내기</button>
</form>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var state = { orderId: null, sending: false };

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c];
    });
  }

  function showError(msg) {
    var el = $('err');
    if (!msg) { el.hidden = true; return; }
    el.textContent = msg; el.hidden = false;
  }

  function render(d) {
    if (!d.current) {
      $('oid').textContent = '진행 중인 오더가 없습니다';
      $('route').textContent = '';
      $('log').innerHTML = '<div class="empty">배차된 건이 생기면 여기에 표시됩니다.</div>';
      $('text').disabled = true; $('btn').disabled = true;
      return;
    }
    state.orderId = d.current.id;

    var cur = (d.orders || []).filter(function (o) { return o.current; })[0] || {};
    $('oid').textContent = d.current.oid + ' · ' + d.current.status;
    $('route').innerHTML = esc(cur.origin || '') + '<span class="arrow">→</span>' + esc(cur.destination || '');
    $('veh').textContent = [cur.vehicle, cur.reservedAt].filter(Boolean).join(' · ');

    // 오더가 하나뿐이면 탭을 그리지 않는다 — 고를 것이 없는데 자리만 차지한다.
    var tabs = $('tabs');
    if ((d.orders || []).length > 1) {
      tabs.innerHTML = d.orders.map(function (o) {
        return '<a class="tab' + (o.current ? ' on' : '') + '" href="/driver/chat?order=' + o.id + '">'
          + esc(o.oid) + '</a>';
      }).join('');
      tabs.hidden = false;
    } else { tabs.hidden = true; }

    // 할 일 — 청구 여부와 무관하게 전달한다. 지시가 안 닿으면 차가 빈 채로 간다.
    var tasks = d.current.tasks || [];
    if (tasks.length) {
      $('tasks').innerHTML = '<h2>이 건에서 해주실 일</h2><ul>' + tasks.map(function (t) {
        var amount = t.amount > 0 ? ' ' + t.amount.toLocaleString('ko-KR') + '원' : '';
        var opt = t.option ? ' (' + esc(t.option) + ')' : '';
        var tag = t.needsReceipt
          ? '<span class="tag need">영수증 필요</span>'
          : '<span class="tag">요금 포함</span>';
        return '<li>' + esc(t.label) + opt + amount + tag + '</li>';
      }).join('') + '</ul>';
      $('tasks').hidden = false;
    } else { $('tasks').hidden = true; }

    if (d.current.memo) {
      $('memo').innerHTML = '<h2>고객 요청사항</h2>' + esc(d.current.memo);
      $('memo').hidden = false;
    } else { $('memo').hidden = true; }

    var log = $('log');
    if (!(d.messages || []).length) {
      log.innerHTML = '<div class="empty">전달사항이나 문의를 남기면 담당자가 확인합니다.</div>';
    } else {
      log.innerHTML = d.messages.map(function (m) {
        var who = m.mine ? '' : '<span class="who">' + (m.sender === 'agent' ? '담당자' : '안내') + '</span>';
        return '<div class="bub ' + (m.mine ? 'me' : 'them') + '">' + who + esc(m.text) + '</div>';
      }).join('');
    }
    log.scrollTop = log.scrollHeight;
  }

  function load() {
    var q = new URLSearchParams(location.search);
    var url = '/driver/chat/data.json' + (q.get('order') ? '?order=' + encodeURIComponent(q.get('order')) : '');
    fetch(url, { headers: { 'X-Requested-With': 'fetch' } })
      .then(function (r) {
        if (r.status === 401) throw new Error('세션이 만료되었습니다. 콜마너 앱에서 다시 열어주세요.');
        if (!r.ok) throw new Error('불러오지 못했습니다. 잠시 후 다시 시도해주세요.');
        return r.json();
      })
      .then(function (d) { showError(''); render(d); })
      .catch(function (e) { showError(e.message); });
  }

  $('send').addEventListener('submit', function (e) {
    e.preventDefault();
    var text = $('text').value.trim();
    if (!text || state.sending || !state.orderId) return;
    state.sending = true; $('btn').disabled = true;
    fetch('/driver/chat/message', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'fetch' },
      body: JSON.stringify({ orderId: state.orderId, text: text }),
    })
      .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
      .then(function (out) {
        if (!out.ok) throw new Error(out.j.error || '보내지 못했습니다.');
        $('text').value = '';
        load();
      })
      .catch(function (e) { showError(e.message); })
      .then(function () { state.sending = false; $('btn').disabled = false; });
  });

  // 입력칸이 내용에 맞춰 늘어난다 — 여러 줄을 쓰는데 한 줄만 보이면 뭘 썼는지 모른다.
  $('text').addEventListener('input', function () {
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 120) + 'px';
  });

  load();
  // 상담원 답장을 보려면 다시 읽어야 한다. SSE는 서버리스에서 함수 시간 제한에 걸리므로
  // (설계도 「한계」 참고) 화면이 보일 때만 가볍게 polling한다.
  setInterval(function () { if (!document.hidden) load(); }, 15000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) load(); });
})();
</script>
</body>
</html>
