<%- include('../partials/header') %>
<div class="page-head-row">
  <div>
    <h1 class="page-title">카테고리 관리</h1>
    <p class="page-sub">지식 항목을 분류할 카테고리를 등록합니다. 카테고리를 선택해 질의응답 항목을 바로 추가할 수 있습니다.</p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/knowledge-base">목록으로</a>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error-msg"><%= error %></div>
<% } %>

<div class="card">
  <form method="POST" action="/knowledge-base/categories">
    <div class="field full"><label>새 카테고리명 *</label><input type="text" name="name" required placeholder="예: 픽업정책, 취소정책, 요금정책"></div>
    <button class="btn" type="submit">카테고리 추가</button>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
  <table>
    <thead><tr><th>카테고리명</th><th>등록된 항목 수</th><th>등록일시</th><th>관리</th></tr></thead>
    <tbody>
      <% if (categories.length === 0) { %><tr><td colspan="4" class="empty">등록된 카테고리가 없습니다.</td></tr><% } %>
      <% categories.forEach(function(c){ %>
        <tr>
          <td><span class="badge gray"><%= c.name %></span></td>
          <td><%= c.entry_count %></td>
          <td><%= c.created_at %></td>
          <td>
            <a class="btn small" href="/knowledge-base/new?category=<%= encodeURIComponent(c.name) %>">질의응답 추가</a>
            <form style="display:inline" method="POST" action="/knowledge-base/categories/<%= c.id %>/delete" onsubmit="return confirm('삭제하시겠습니까?');">
              <button class="btn small secondary" type="submit">삭제</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/footer') %>
