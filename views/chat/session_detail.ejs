<%- include('../partials/header') %>
<% const statusLabel = { bot: '봇 응대중', needs_agent: '상담원 호출', agent_active: '상담원 응대중', closed: '종료' }; %>
<% const statusBadge = { bot: 'gray', needs_agent: 'red', agent_active: 'blue', closed: 'dark' }; %>
<%
function formatChatTime(raw) {
  var m = String(raw || '').match(/(\d{1,2}):(\d{2})/);
  if (!m) return '';
  var h = Number(m[1]);
  var mm = m[2];
  var ampm = h < 12 ? '오전' : '오후';
  var h12 = h % 12 || 12;
  return ampm + ' ' + h12 + ':' + mm;
}
// 자동 발송된 초안인지 — chat_messages에는 발신 주체가 'agent' 하나뿐이라 서버가 붙이는
// 안내 문구로 판별한다(routes/chat.js AUTO_SEND_NOTICE와 같은 문장이어야 한다).
var AUTO_SENT_MARK = '상담원이 30초동안 응답이 없어 AI가 응답을 먼저 생성하였습니다.';
function isAutoSent(msg) {
  return msg && msg.sender === 'agent' && String(msg.message || '').indexOf(AUTO_SENT_MARK) !== -1;
}
function readStateText(msg) {
  if (!msg) return '';
  if (msg.sender === 'user') return msg.read_by_agent_at ? '읽음' : '미읽음';
  if (msg.sender === 'agent') return msg.read_by_user_at ? '읽음' : '미읽음';
  return '';
}
// DB에는 "질문 말풍선" 플래그가 없어, AI 챗봇 쪽 관례(질문 문구는 항상 "?"로 끝남)를
// 휴리스틱으로 써서 봇 질문 말풍선에도 같은 파란 배경(.ai-bot-question)을 준다.
function isQuestionBubble(msg) {
  return msg.sender === 'bot' && /\?\s*$/.test(String(msg.message || '').trim());
}
// 능동 통보에 딸린 사진(chat_messages.attachments_json). 고객 화면에는 썸네일+링크로 나가는데
// 상담원 화면에서만 안 보이면 "무엇이 이미 안내됐는지"를 알 수 없다 — 같은 형태로 보여준다.
// 컬럼이 없는 DB(마이그레이션 전)에서는 값이 없고, 그때는 본문에 링크가 글자로 들어 있다.
function parseAttachments(msg) {
  var raw = msg && msg.attachments_json;
  if (!raw) return [];
  if (typeof raw === 'object') return Array.isArray(raw) ? raw : [];
  try { var parsed = JSON.parse(raw); return Array.isArray(parsed) ? parsed : []; } catch (e) { return []; }
}
%>

<div class="page-head-row">
  <div>
    <h1 class="page-title">상담 #<%= session.id %> <span class="badge <%= statusBadge[session.status] || 'gray' %>"><%= statusLabel[session.status] || session.status %></span></h1>
    <p class="page-sub">
      <%# 카카오 세션은 아래 배지가 채널을 말해준다 — 역할까지 "(카카오)"로 적으면 중복이다.
          매핑된 거래처가 있으면 이름줄을 "거래처명(담당자)"로 보여준다. %>
      <%
        // 담당자명이 거래처명으로 시작하면(예: "서울모터스 채정식") 괄호 앞 회사명과 겹치므로 뗀다.
        function personOnly(group, user) {
          if (!user) return user;
          if (group && user.indexOf(group) === 0) {
            var rest = user.slice(group.length).replace(/^[\s·\-]+/, '').trim();
            return rest || user;
          }
          return user;
        }
        var _acct = (typeof mappedAccount !== 'undefined') ? mappedAccount : null;
        var mappedName = (session.channel === 'kakao' && _acct && (_acct.groupName || _acct.userName))
          ? ((_acct.groupName && _acct.userName)
            ? _acct.groupName + '(' + personOnly(_acct.groupName, _acct.userName) + ')'
            : (_acct.groupName || _acct.userName))
          : null;
      %>
      고객: <%= mappedName || session.user_name || '-' %><%= session.channel === 'kakao' ? '' : ' (' + (session.user_role || '-') + ')' %><%= session.user_phone ? ' · ' + session.user_phone : '' %>
      <%# 여기서 보내는 답장이 카카오 상담톡으로 나간다는 걸 입력 전에 알 수 있어야 한다. %>
      <% if (session.channel === 'kakao') { %><span class="badge amber">카카오 상담톡</span><% } %>
    </p>
    <%# 거래처·담당자는 위 이름줄에 이미 있으므로, 여기선 지사·자동접수만 보조로 밝힌다. %>
    <% if (typeof mappedAccount !== 'undefined' && mappedAccount) { %>
      <p class="page-sub mapped-account">
        <span class="badge green">매핑</span>
        <% if (mappedAccount.branchName) { %><%= mappedAccount.branchName %><% } %><% if (mappedAccount.autoRegister) { %> <span class="badge blue">자동접수</span><% } %>
      </p>
    <% } %>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/chat/sessions">← 목록으로</a>
    <a class="btn secondary" href="/orders/ai-intake">AI 접수 화면</a>
  </div>
</div>

<% if (error) { %><div class="error-msg" style="margin-bottom:10px;"><%= error %></div><% } %>
<% if (notice) { %><div class="success-msg" style="margin-bottom:10px;"><%= notice %></div><% } %>

<div class="chat-workspace-grid">
  <section class="card chat-workspace-chat">
    <div class="session-meta">
      <span>요청 기능: <b><%= session.requested_feature || '-' %></b></span>
      <span>담당 상담원: <b id="assignedAgentLabel"><%= session.agent_name || '미배정' %></b></span>
      <span>생성일시: <b><%= session.created_at %></b></span>
      <span>최근 업데이트: <b><%= session.updated_at %></b></span>
    </div>

    <div class="session-meta" style="margin-top:-4px;">
      <form method="POST" action="/chat/sessions/<%= session.id %>/assign-self" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <button class="btn small secondary" type="submit">내가 담당하기</button>
      </form>
      <form method="POST" action="/chat/sessions/<%= session.id %>/assign" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <label for="assign_agent_id" style="font-size:12px;color:var(--muted);">담당자 변경</label>
        <select id="assign_agent_id" name="agent_id" required>
          <option value="">상담원 선택</option>
          <% agents.forEach(function(a){ %>
            <option value="<%= a.id %>" <%= String(session.assigned_agent_id) === String(a.id) ? 'selected' : '' %>><%= a.name %></option>
          <% }) %>
        </select>
        <button class="btn small secondary" type="submit">지정</button>
      </form>
    </div>

    <div class="card chat-session-card" style="box-shadow:none;border-style:dashed;margin-bottom:0;">
      <div class="ai-chat-messages" id="sessionMessages">
        <% var senderLabel = { user: '고객', agent: '상담원', bot: 'AI', system: '시스템' }; %>
        <% var senderClass = { user: 'ai-user', agent: 'ai-agent' }; %>
        <% messages.forEach(function(m){ %>
          <div class="ai-chat-item <%= senderClass[m.sender] || 'ai-bot' %>" data-id="<%= m.id %>">
            <div class="ai-chat-bubble <%= senderClass[m.sender] || 'ai-bot' %><%= isQuestionBubble(m) ? ' ai-bot-question' : '' %>"><span class="bubble-label"><%= (senderLabel[m.sender] || m.sender) + (isAutoSent(m) ? ' · 자동 발송됨' : '') %></span><%= m.message %><% var atts = parseAttachments(m); if (atts.length) { %><div class="ai-chat-attachments"><% atts.forEach(function(a, i){ %><a class="ai-chat-attachment" href="<%= a.url %>" target="_blank" rel="noopener"><img src="<%= a.url %>" alt="<%= a.caption || ('첨부 사진 ' + (i + 1)) %>" onerror="this.style.display='none'"><span><%= a.caption || ('사진 ' + (i + 1)) %></span></a><% }) %></div><% } %></div>
            <div class="bubble-footer">
              <div class="bubble-time"><%= formatChatTime(m.created_at) %></div>
              <% if (readStateText(m)) { %>
                <div class="bubble-read <%= readStateText(m) === '미읽음' ? 'unread' : '' %>"><%= readStateText(m) %></div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <% if (session.status !== 'closed') { %>
    <div id="quickReplyPanel" class="card" style="display:none;margin-bottom:8px;padding:12px;max-height:260px;overflow-y:auto;">
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
        <input type="search" id="quickReplySearch" placeholder="문구 검색" style="flex:1;" aria-label="빠른 답변 검색">
        <a class="btn small secondary" href="/quick-replies">관리</a>
        <button class="btn small secondary" type="button" id="quickReplyClose">닫기</button>
      </div>
      <div id="quickReplyList"></div>
    </div>
    <form class="chat-reply-row" method="POST" action="/chat/sessions/<%= session.id %>/reply" id="agentReplyForm">
      <button class="btn secondary" type="button" id="quickReplyToggle" title="빠른 답변 (자주 쓰는 문구 넣기)" aria-label="빠른 답변 열기" style="flex:none;padding:0 12px;">⚡</button>
      <textarea name="text" id="agentReplyText" placeholder="상담원으로 답변을 입력하세요... (Enter 전송 / Shift+Enter 줄바꿈)" required></textarea>
      <button class="btn" type="submit" id="agentReplySendBtn">전송</button>
    </form>
    <div id="agentReplyError" class="chat-inline-error" style="display:none;"></div>
    <div style="margin-top:10px;display:flex;gap:8px;" id="sessionActionButtons">
      <form method="POST" action="/chat/sessions/<%= session.id %>/return-to-bot" id="returnToBotForm" style="<%= session.status === 'agent_active' ? '' : 'display:none;' %>">
        <button class="btn small secondary" type="submit">봇에게 되돌리기</button>
      </form>
      <form method="POST" action="/chat/sessions/<%= session.id %>/close" onsubmit="return confirm('이 상담을 종료하시겠습니까?');">
        <button class="btn small secondary" type="submit">상담 종료</button>
      </form>
    </div>
    <% } %>
  </section>

  <section class="card chat-workspace-order">
    <div class="chat-order-head">
      <h2>접수 마무리</h2>
      <p class="page-sub">접수 마무리 섹션은 상담관리 화면(카드 보기)으로 이동되었습니다.</p>
      <a class="btn" href="/chat/sessions?view=card">상담관리에서 접수하기</a>
    </div>
  </section>
</div>

<script>
(function () {
  var messagesEl = document.getElementById('sessionMessages');
  var lastId = <%- toScriptJson(messages.length ? messages[messages.length - 1].id : 0) %>;
  var labelBySender = { user: '고객', bot: 'AI', agent: '상담원', system: '시스템' };
  var classBySender = { user: 'ai-user', bot: 'ai-bot', agent: 'ai-agent', system: 'ai-bot' };
  var currentUserName = <%- toScriptJson(currentUser.name) %>;

  function formatChatTime(raw) {
    var m = String(raw || '').match(/(\d{1,2}):(\d{2})/);
    if (!m) return '';
    var h = Number(m[1]);
    var mm = m[2];
    var ampm = h < 12 ? '오전' : '오후';
    var h12 = h % 12 || 12;
    return ampm + ' ' + h12 + ':' + mm;
  }

  function readStateText(msg) {
    if (!msg) return '';
    if (msg.sender === 'user') return msg.read_by_agent_at ? '읽음' : '미읽음';
    if (msg.sender === 'agent') return msg.read_by_user_at ? '읽음' : '미읽음';
    return '';
  }

  // 서버가 자동 발송한 초안인지 — 붙여 보내는 안내 문구로 판별한다(서버의 AUTO_SEND_NOTICE와
  // 같은 문장이어야 한다). chat_messages에는 발신 주체가 'agent' 하나뿐이라 별도 플래그가 없다.
  var AUTO_SENT_MARK_JS = '상담원이 30초동안 응답이 없어 AI가 응답을 먼저 생성하였습니다.';
  function isAutoSentJs(msg) {
    return msg && msg.sender === 'agent' && String(msg.message || '').indexOf(AUTO_SENT_MARK_JS) !== -1;
  }

  function isQuestionBubble(m) {
    return m.sender === 'bot' && /\?\s*$/.test(String(m.message || '').trim());
  }

  // 서버 렌더(위 parseAttachments)와 같은 것을 실시간 수신 경로에서도 그린다.
  // innerHTML을 쓰지 않는다 — 사진 캡션·URL이 그대로 들어오는 자리다.
  function appendAttachments(bubble, m) {
    var raw = m && m.attachments_json;
    if (!raw) return;
    var list;
    try { list = typeof raw === 'object' ? raw : JSON.parse(raw); } catch (e) { return; }
    if (!Array.isArray(list) || !list.length) return;
    var wrap = document.createElement('div');
    wrap.className = 'ai-chat-attachments';
    list.forEach(function (a, i) {
      var url = a && a.url ? String(a.url) : '';
      if (!url) return;
      var link = document.createElement('a');
      link.className = 'ai-chat-attachment';
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener';
      var img = document.createElement('img');
      img.src = url;
      img.alt = (a && a.caption) ? String(a.caption) : ('첨부 사진 ' + (i + 1));
      img.addEventListener('error', function () { img.style.display = 'none'; });
      link.appendChild(img);
      var cap = document.createElement('span');
      cap.textContent = (a && a.caption) ? String(a.caption) : ('사진 ' + (i + 1));
      link.appendChild(cap);
      wrap.appendChild(link);
    });
    if (wrap.childNodes.length) bubble.appendChild(wrap);
  }

  function appendMessage(m) {
    if (!m || m.id <= lastId) return;
    var who = classBySender[m.sender] || 'ai-bot';
    var item = document.createElement('div');
    item.className = 'ai-chat-item ' + who;
    item.dataset.id = m.id;

    var bubble = document.createElement('div');
    bubble.className = 'ai-chat-bubble ' + who + (isQuestionBubble(m) ? ' ai-bot-question' : '');

    var labelSpan = document.createElement('span');
    labelSpan.className = 'bubble-label';
    labelSpan.textContent = (labelBySender[m.sender] || m.sender) + (isAutoSentJs(m) ? ' · 자동 발송됨' : '');
    bubble.appendChild(labelSpan);
    bubble.appendChild(document.createTextNode(m.message));
    appendAttachments(bubble, m);
    item.appendChild(bubble);

    var footer = document.createElement('div');
    footer.className = 'bubble-footer';

    var timeText = formatChatTime(m.created_at);
    if (timeText) {
      var timeDiv = document.createElement('div');
      timeDiv.className = 'bubble-time';
      timeDiv.textContent = timeText;
      footer.appendChild(timeDiv);
    }

    var readText = readStateText(m);
    if (readText) {
      var readDiv = document.createElement('div');
      readDiv.className = 'bubble-read' + (readText === '미읽음' ? ' unread' : '');
      readDiv.textContent = readText;
      footer.appendChild(readDiv);
    }

    if (footer.children.length) item.appendChild(footer);
    messagesEl.appendChild(item);
    lastId = m.id;
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function catchUp() {
    fetch('/chat/sessions/<%= session.id %>/poll?since=' + lastId)
      .then(function (res) { return res.json(); })
      .then(function (data) {
        var before = lastId;
        (data.messages || []).forEach(appendMessage);
        // 새 고객 발화가 따라잡혔으면 봇 초안도 함께 확인한다.
        if (lastId !== before) scheduleSuggestionFetch();
      })
      .catch(function () {});
  }

  // 실시간 스트림이 끊기거나 브로드캐스트가 유실돼도 고객 발화가 화면에서 누락되면 안 된다 —
  // 마지막으로 받은 id 이후만 주기적으로 확인한다(새 메시지가 없으면 빈 배열이라 비용이 거의 없다).
  setInterval(function () {
    if (document.hidden) return;
    catchUp();
    // 초안이 아직 없으면 같이 확인한다 — 재시도 타이머를 다 소진했어도 여기서 결국 잡힌다.
    if (!currentSuggestion) fetchSuggestion();
  }, 7000);
  document.addEventListener('visibilitychange', function () { if (!document.hidden) catchUp(); });

  function markBubblesRead(bubbleClass) {
    var spans = messagesEl.querySelectorAll('.ai-chat-item.' + bubbleClass + ' .bubble-read.unread');
    spans.forEach(function (span) {
      span.textContent = '읽음';
      span.classList.remove('unread');
    });
  }

  if (window.EventSource) {
    var es = new EventSource('/chat/sessions/<%= session.id %>/stream');
    es.onopen = catchUp;
    es.onmessage = function (e) {
      try {
        var payload = JSON.parse(e.data);
        if (payload && payload.type === 'read_receipt') {
          markBubblesRead(payload.reader === 'agent' ? 'ai-user' : 'ai-agent');
          return;
        }
        // type이 붙은 payload는 말풍선이 아니라 제어 신호다(예: 고객 창에 보내는
        // bot_handover_replay). 상담원 화면에서는 그릴 게 없으므로 흘려보낸다.
        if (payload && payload.type) return;
        appendMessage(payload);
        // 고객 메시지가 오면 봇 초안(채택 대기)이 만들어졌는지 확인한다. 초안은 메시지
        // 스트림으로 오지 않는다 — 스트림에 실으면 대화 말풍선으로 그려져 고객에게 보이는 것과
        // 같아지기 때문이다(서버에서도 chat_messages에 저장하지 않는다).
        if (payload && payload.sender === 'user') scheduleSuggestionFetch();
      } catch (err) { /* noop */ }
    };
  }

  // ---------------- 상담원 도우미: 답변 채택 대기 ----------------
  // 상담원이 입력창에 타이핑하는 중이라는 신호 — 이게 없으면 답을 쓰고 있는 사이에 서버가
  // 초안을 자동 발송해 같은 질문에 답이 두 번 나간다(카카오는 발송 취소가 안 된다).
  // 매 글자마다 보내지 않고 5초에 한 번으로 묶는다.
  var lastTypingSent = 0;
  (function () {
    var input = document.getElementById('agentReplyText');
    if (!input) return;
    input.addEventListener('input', function () {
      var now = Date.now();
      if (now - lastTypingSent < 5000) return;
      lastTypingSent = now;
      fetch('/chat/sessions/<%= session.id %>/typing', { method: 'POST' }).catch(function () {});
    });
  })();

  var suggestionEl = null;
  var currentSuggestion = null;

  // 초안은 고객 메시지보다 늦게 준비된다 — 접수 분류나 요금 계산이 들어가면 LLM·외부 API를
  // 거쳐 실측 3초까지 걸린다. 한 번만 조회하면 그 사이에 없을 때 다음 고객 메시지가 올 때까지
  // 영영 안 뜬다. 준비될 때까지 몇 번 더 확인한다.
  var SUGGESTION_RETRY_DELAYS = [800, 2000, 4000, 7000, 11000];
  var suggestionTimers = [];

  function scheduleSuggestionFetch() {
    suggestionTimers.forEach(clearTimeout);
    suggestionTimers = SUGGESTION_RETRY_DELAYS.map(function (delay) {
      return setTimeout(function () {
        if (currentSuggestion) return; // 이미 떠 있으면 더 두드리지 않는다(편집 중일 수 있다)
        fetchSuggestion();
      }, delay);
    });
  }

  function clearSuggestion() {
    if (suggestionEl && suggestionEl.parentNode) suggestionEl.parentNode.removeChild(suggestionEl);
    suggestionEl = null;
    currentSuggestion = null;
  }

  function fetchSuggestion() {
    fetch('/chat/sessions/<%= session.id %>/suggestion')
      .then(function (res) { return res.json(); })
      .then(function (data) {
        var s = data && data.suggestion;
        if (!s) { clearSuggestion(); return; }
        if (currentSuggestion && currentSuggestion.id === s.id) return; // 이미 떠 있음(편집 중일 수 있다)
        renderSuggestion(s);
      })
      .catch(function () {});
  }

  function decideSuggestion(action, textarea, buttons) {
    if (!currentSuggestion) return;
    buttons.forEach(function (b) { b.disabled = true; });
    var body = action === 'approve'
      ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text: textarea.value.trim() }) }
      : { method: 'POST', headers: { 'X-Requested-With': 'fetch' } };
    fetch('/chat/sessions/<%= session.id %>/suggestions/' + currentSuggestion.id + '/' + action, body)
      .then(function (res) { return res.json().then(function (d) { if (!res.ok) throw new Error(d.error || '처리 실패'); return d; }); })
      .then(function () { clearSuggestion(); catchUp(); })
      .catch(function (err) {
        setReplyError(err.message || '초안 처리에 실패했습니다.');
        buttons.forEach(function (b) { b.disabled = false; });
      });
  }

  // Next.js 상담 화면(src/app/chat/sessions/SessionViewer.js)과 같은 목록을 쓴다 —
  // 두 화면이 다른 라벨을 쓰면 어느 화면으로 보느냐에 따라 초안 성격이 달라 보인다.
  var SUGGESTION_KIND_LABEL = {
    intake: '접수 내용 파싱', faq: '지식베이스 답변', fare: '요금 계산', hours: '운영시간 안내',
    dispatch: '주문 조회', dispatch_action: '주문 변경·취소(봇이 이어서 실행)',
  };

  function renderSuggestion(s) {
    clearSuggestion();
    currentSuggestion = s;

    var item = document.createElement('div');
    item.className = 'ai-chat-item ai-agent';

    var bubble = document.createElement('div');
    bubble.className = 'ai-chat-bubble ai-agent';
    bubble.style.borderStyle = 'dashed';
    bubble.style.width = '100%';
    bubble.style.maxWidth = '100%';

    var label = document.createElement('span');
    label.className = 'bubble-label';
    label.textContent = 'AI 초안 · 채택 대기' + (SUGGESTION_KIND_LABEL[s.kind] ? ' (' + SUGGESTION_KIND_LABEL[s.kind] + ')' : '');
    bubble.appendChild(label);

    var textarea = document.createElement('textarea');
    textarea.value = s.text || '';
    textarea.rows = Math.min(10, Math.max(3, String(s.text || '').split('\n').length + 1));
    textarea.setAttribute('aria-label', 'AI 답변 초안 (수정 가능)');
    textarea.style.width = '100%';
    textarea.style.marginTop = '6px';
    textarea.style.fontSize = '13px';
    textarea.style.lineHeight = '1.6';
    textarea.style.resize = 'vertical';
    bubble.appendChild(textarea);

    var actions = document.createElement('div');
    actions.style.cssText = 'display:flex;gap:6px;margin-top:8px;justify-content:flex-end;';
    var dismissBtn = document.createElement('button');
    dismissBtn.type = 'button';
    dismissBtn.className = 'btn small secondary';
    dismissBtn.textContent = '무시';
    var approveBtn = document.createElement('button');
    approveBtn.type = 'button';
    approveBtn.className = 'btn small';
    approveBtn.textContent = '승인하고 전송';
    var buttons = [dismissBtn, approveBtn];
    dismissBtn.addEventListener('click', function () { decideSuggestion('dismiss', textarea, buttons); });
    approveBtn.addEventListener('click', function () { decideSuggestion('approve', textarea, buttons); });
    actions.appendChild(dismissBtn);
    actions.appendChild(approveBtn);
    bubble.appendChild(actions);

    item.appendChild(bubble);

    var footer = document.createElement('div');
    footer.className = 'bubble-footer';
    var note = document.createElement('div');
    note.className = 'bubble-time';
    note.textContent = '아직 고객에게 보내지 않았습니다';
    footer.appendChild(note);
    item.appendChild(footer);

    suggestionEl = item;
    messagesEl.appendChild(item);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  // 화면을 열었을 때 이미 대기 중인 초안이 있을 수 있다(상담원이 자리를 비운 사이 도착).
  fetchSuggestion();

  // ---------------- 빠른 답변(상용구) ----------------
  var quickReplyPanel = document.getElementById('quickReplyPanel');
  var quickReplyList = document.getElementById('quickReplyList');
  var quickReplySearch = document.getElementById('quickReplySearch');
  var quickReplies = null;

  function renderQuickReplies() {
    var q = (quickReplySearch.value || '').trim().toLowerCase();
    var items = (quickReplies || []).filter(function (r) {
      return !q || (r.title + ' ' + r.body).toLowerCase().indexOf(q) >= 0;
    });
    quickReplyList.innerHTML = '';

    if (!quickReplies || !quickReplies.length) {
      quickReplyList.innerHTML = '<div class="empty" style="padding:8px;">등록된 빠른 답변이 없습니다. <a href="/quick-replies">지금 등록하기</a></div>';
      return;
    }
    if (!items.length) {
      quickReplyList.innerHTML = '<div class="empty" style="padding:8px;">검색 결과가 없습니다.</div>';
      return;
    }

    var byCategory = {};
    items.forEach(function (r) { (byCategory[r.category] = byCategory[r.category] || []).push(r); });
    Object.keys(byCategory).forEach(function (category) {
      var group = document.createElement('div');
      group.style.marginBottom = '8px';
      var label = document.createElement('div');
      label.style.cssText = 'font-size:11px;color:var(--muted);margin:4px 0;';
      label.textContent = category;
      group.appendChild(label);
      var wrap = document.createElement('div');
      wrap.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;';
      byCategory[category].forEach(function (r) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn small secondary';
        btn.textContent = r.title;
        btn.title = r.body;
        btn.addEventListener('click', function () {
          // 쓰던 내용이 있으면 지우지 않고 뒤에 붙인다.
          var prev = replyText.value;
          replyText.value = prev.trim() ? prev.replace(/\s*$/, '\n') + r.body : r.body;
          quickReplyPanel.style.display = 'none';
          replyText.focus();
        });
        wrap.appendChild(btn);
      });
      group.appendChild(wrap);
      quickReplyList.appendChild(group);
    });
  }

  document.getElementById('quickReplyToggle').addEventListener('click', function () {
    var opening = quickReplyPanel.style.display === 'none';
    quickReplyPanel.style.display = opening ? '' : 'none';
    if (!opening) return;
    quickReplySearch.focus();
    if (quickReplies !== null) return renderQuickReplies();
    fetch('/quick-replies/data.json')
      .then(function (res) { return res.json(); })
      .then(function (data) { quickReplies = data.replies || []; renderQuickReplies(); })
      .catch(function () { quickReplies = []; renderQuickReplies(); });
  });
  document.getElementById('quickReplyClose').addEventListener('click', function () {
    quickReplyPanel.style.display = 'none';
  });
  quickReplySearch.addEventListener('input', renderQuickReplies);

  var replyForm = document.getElementById('agentReplyForm');
  var replyText = document.getElementById('agentReplyText');
  var replySendBtn = document.getElementById('agentReplySendBtn');
  var replyError = document.getElementById('agentReplyError');
  var assignedAgentLabel = document.getElementById('assignedAgentLabel');
  var returnToBotForm = document.getElementById('returnToBotForm');
  var isSendingReply = false;

  function setReplyError(text) {
    if (!text) { replyError.style.display = 'none'; replyError.textContent = ''; return; }
    replyError.textContent = text;
    replyError.style.display = '';
  }

  // "지금 답을 쓰고 있다"를 서버에 알린다 — 그동안 AI 초안 자동 발송을 건너뛴다(그게 없으면
  // 작성 중에 봇이 먼저 나가 같은 질문에 답이 두 번 간다. 카카오는 발송 취소가 안 된다).
  //
  // 타이핑마다 보내지 않고 최소 간격을 둔다. 서버는 마지막 시각만 쓰므로 더 자주 보낼 이유가
  // 없고, 긴 답을 쓰는 동안 요청이 수백 번 나가면 그게 더 문제다. 신호가 이 간격보다 오래
  // 끊기면 서버가 "작성을 포기한 것"으로 보고 초안을 보낸다(AGENT_TYPING_STALE_SECONDS).
  // Next.js 상담 화면(src/app/chat/sessions/SessionViewer.js notifyTyping)과 같은 간격을 쓴다 —
  // 두 화면이 다르게 굴면 어느 화면으로 응대했는지에 따라 결과가 갈린다.
  var TYPING_PING_INTERVAL_MS = 5000;
  var lastTypingPingAt = 0;
  function pingTyping() {
    var now = Date.now();
    if (now - lastTypingPingAt < TYPING_PING_INTERVAL_MS) return;
    lastTypingPingAt = now;
    // 실패는 삼킨다 — 신호가 못 갔다고 상담원 입력을 막을 이유가 없다(최악의 경우 예전처럼
    // 초안이 자동 발송될 뿐이다).
    fetch('/chat/sessions/<%= session.id %>/typing', {
      method: 'POST',
      headers: { Accept: 'application/json' },
    }).catch(function () {});
  }
  replyText.addEventListener('input', function () {
    // 빈 칸으로 지운 것은 작성 중이 아니다 — 지우고 손을 뗀 상담원 때문에 초안이 묶이면 안 된다.
    if (replyText.value.trim()) pingTyping();
  });

  function sendAgentReply() {
    var text = replyText.value.trim();
    if (!text || isSendingReply) return;
    isSendingReply = true;
    replySendBtn.disabled = true;
    setReplyError('');

    fetch('/chat/sessions/<%= session.id %>/reply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ text: text }),
    })
      .then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (data) {
          if (!res.ok) throw new Error(data.error || '메시지 전송에 실패했습니다. 잠시 후 다시 시도해주세요.');
          return data;
        });
      })
      .then(function (data) {
        if (data.message) appendMessage(data.message);
        if (assignedAgentLabel) assignedAgentLabel.textContent = currentUserName;
        if (returnToBotForm && data.status === 'agent_active') returnToBotForm.style.display = '';
        replyText.value = '';
      })
      .catch(function (err) {
        setReplyError((err && err.message) || '메시지 전송에 실패했습니다. 잠시 후 다시 시도해주세요.');
      })
      .finally(function () {
        isSendingReply = false;
        replySendBtn.disabled = false;
      });
  }

  if (replyForm) {
    replyForm.addEventListener('submit', function (e) {
      e.preventDefault();
      sendAgentReply();
    });
    replyText.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendAgentReply();
      }
    });
  }

})();
</script>

<%- include('../partials/footer') %>
