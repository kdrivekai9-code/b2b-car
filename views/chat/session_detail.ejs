<%- include('../partials/header') %>
<% const statusLabel = { bot: '봇 응대중', needs_agent: '상담원 호출', agent_active: '상담원 응대중', closed: '종료' }; %>
<% const statusBadge = { bot: 'gray', needs_agent: 'red', agent_active: 'blue', closed: 'dark' }; %>
<%
function formatChatTime(raw) {
  var m = String(raw || '').match(/(\d{1,2}):(\d{2})/);
  if (!m) return '';
  var h = Number(m[1]);
  var mm = m[2];
  var ampm = h < 12 ? '오전' : '오후';
  var h12 = h % 12 || 12;
  return ampm + ' ' + h12 + ':' + mm;
}
function readStateText(msg) {
  if (!msg) return '';
  if (msg.sender === 'user') return msg.read_by_agent_at ? '읽음' : '미읽음';
  if (msg.sender === 'agent') return msg.read_by_user_at ? '읽음' : '미읽음';
  return '';
}
// DB에는 "질문 말풍선" 플래그가 없어, AI 챗봇 쪽 관례(질문 문구는 항상 "?"로 끝남)를
// 휴리스틱으로 써서 봇 질문 말풍선에도 같은 파란 배경(.ai-bot-question)을 준다.
function isQuestionBubble(msg) {
  return msg.sender === 'bot' && /\?\s*$/.test(String(msg.message || '').trim());
}
%>

<div class="page-head-row">
  <div>
    <h1 class="page-title">상담 #<%= session.id %> <span class="badge <%= statusBadge[session.status] || 'gray' %>"><%= statusLabel[session.status] || session.status %></span></h1>
    <p class="page-sub">고객: <%= session.user_name || '-' %> (<%= session.user_role || '-' %>)<%= session.user_phone ? ' · ' + session.user_phone : '' %></p>
  </div>
  <div class="page-head-actions">
    <a class="btn secondary" href="/chat/sessions">← 목록으로</a>
    <a class="btn secondary" href="/orders/ai-intake">AI 접수 화면</a>
  </div>
</div>

<% if (error) { %><div class="error-msg" style="margin-bottom:10px;"><%= error %></div><% } %>
<% if (notice) { %><div class="success-msg" style="margin-bottom:10px;"><%= notice %></div><% } %>

<div class="chat-workspace-grid">
  <section class="card chat-workspace-chat">
    <div class="session-meta">
      <span>요청 기능: <b><%= session.requested_feature || '-' %></b></span>
      <span>담당 상담원: <b id="assignedAgentLabel"><%= session.agent_name || '미배정' %></b></span>
      <span>생성일시: <b><%= session.created_at %></b></span>
      <span>최근 업데이트: <b><%= session.updated_at %></b></span>
    </div>

    <div class="session-meta" style="margin-top:-4px;">
      <form method="POST" action="/chat/sessions/<%= session.id %>/assign-self" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <button class="btn small secondary" type="submit">내가 담당하기</button>
      </form>
      <form method="POST" action="/chat/sessions/<%= session.id %>/assign" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <label for="assign_agent_id" style="font-size:12px;color:var(--muted);">담당자 변경</label>
        <select id="assign_agent_id" name="agent_id" required>
          <option value="">상담원 선택</option>
          <% agents.forEach(function(a){ %>
            <option value="<%= a.id %>" <%= String(session.assigned_agent_id) === String(a.id) ? 'selected' : '' %>><%= a.name %></option>
          <% }) %>
        </select>
        <button class="btn small secondary" type="submit">지정</button>
      </form>
    </div>

    <div class="card chat-session-card" style="box-shadow:none;border-style:dashed;margin-bottom:0;">
      <div class="ai-chat-messages" id="sessionMessages">
        <% var senderLabel = { user: '고객', agent: '상담원', bot: 'AI', system: '시스템' }; %>
        <% var senderClass = { user: 'ai-user', agent: 'ai-agent' }; %>
        <% messages.forEach(function(m){ %>
          <div class="ai-chat-item <%= senderClass[m.sender] || 'ai-bot' %>" data-id="<%= m.id %>">
            <div class="ai-chat-bubble <%= senderClass[m.sender] || 'ai-bot' %><%= isQuestionBubble(m) ? ' ai-bot-question' : '' %>"><span class="bubble-label"><%= senderLabel[m.sender] || m.sender %></span><%= m.message %></div>
            <div class="bubble-footer">
              <div class="bubble-time"><%= formatChatTime(m.created_at) %></div>
              <% if (readStateText(m)) { %>
                <div class="bubble-read <%= readStateText(m) === '미읽음' ? 'unread' : '' %>"><%= readStateText(m) %></div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <% if (session.status !== 'closed') { %>
    <form class="chat-reply-row" method="POST" action="/chat/sessions/<%= session.id %>/reply" id="agentReplyForm">
      <textarea name="text" id="agentReplyText" placeholder="상담원으로 답변을 입력하세요... (Enter 전송 / Shift+Enter 줄바꿈)" required></textarea>
      <button class="btn" type="submit" id="agentReplySendBtn">전송</button>
    </form>
    <div id="agentReplyError" class="chat-inline-error" style="display:none;"></div>
    <div style="margin-top:10px;display:flex;gap:8px;" id="sessionActionButtons">
      <form method="POST" action="/chat/sessions/<%= session.id %>/return-to-bot" id="returnToBotForm" style="<%= session.status === 'agent_active' ? '' : 'display:none;' %>">
        <button class="btn small secondary" type="submit">봇에게 되돌리기</button>
      </form>
      <form method="POST" action="/chat/sessions/<%= session.id %>/close" onsubmit="return confirm('이 상담을 종료하시겠습니까?');">
        <button class="btn small secondary" type="submit">상담 종료</button>
      </form>
    </div>
    <% } %>
  </section>

  <section class="card chat-workspace-order">
    <div class="chat-order-head">
      <h2>접수 마무리</h2>
      <p class="page-sub">접수 마무리 섹션은 상담관리 화면(카드 보기)으로 이동되었습니다.</p>
      <a class="btn" href="/chat/sessions?view=card">상담관리에서 접수하기</a>
    </div>
  </section>
</div>

<script>
(function () {
  var messagesEl = document.getElementById('sessionMessages');
  var lastId = <%- toScriptJson(messages.length ? messages[messages.length - 1].id : 0) %>;
  var labelBySender = { user: '고객', bot: 'AI', agent: '상담원', system: '시스템' };
  var classBySender = { user: 'ai-user', bot: 'ai-bot', agent: 'ai-agent', system: 'ai-bot' };
  var currentUserName = <%- toScriptJson(currentUser.name) %>;

  function formatChatTime(raw) {
    var m = String(raw || '').match(/(\d{1,2}):(\d{2})/);
    if (!m) return '';
    var h = Number(m[1]);
    var mm = m[2];
    var ampm = h < 12 ? '오전' : '오후';
    var h12 = h % 12 || 12;
    return ampm + ' ' + h12 + ':' + mm;
  }

  function readStateText(msg) {
    if (!msg) return '';
    if (msg.sender === 'user') return msg.read_by_agent_at ? '읽음' : '미읽음';
    if (msg.sender === 'agent') return msg.read_by_user_at ? '읽음' : '미읽음';
    return '';
  }

  function isQuestionBubble(m) {
    return m.sender === 'bot' && /\?\s*$/.test(String(m.message || '').trim());
  }

  function appendMessage(m) {
    if (!m || m.id <= lastId) return;
    var who = classBySender[m.sender] || 'ai-bot';
    var item = document.createElement('div');
    item.className = 'ai-chat-item ' + who;
    item.dataset.id = m.id;

    var bubble = document.createElement('div');
    bubble.className = 'ai-chat-bubble ' + who + (isQuestionBubble(m) ? ' ai-bot-question' : '');

    var labelSpan = document.createElement('span');
    labelSpan.className = 'bubble-label';
    labelSpan.textContent = labelBySender[m.sender] || m.sender;
    bubble.appendChild(labelSpan);
    bubble.appendChild(document.createTextNode(m.message));
    item.appendChild(bubble);

    var footer = document.createElement('div');
    footer.className = 'bubble-footer';

    var timeText = formatChatTime(m.created_at);
    if (timeText) {
      var timeDiv = document.createElement('div');
      timeDiv.className = 'bubble-time';
      timeDiv.textContent = timeText;
      footer.appendChild(timeDiv);
    }

    var readText = readStateText(m);
    if (readText) {
      var readDiv = document.createElement('div');
      readDiv.className = 'bubble-read' + (readText === '미읽음' ? ' unread' : '');
      readDiv.textContent = readText;
      footer.appendChild(readDiv);
    }

    if (footer.children.length) item.appendChild(footer);
    messagesEl.appendChild(item);
    lastId = m.id;
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function catchUp() {
    fetch('/chat/sessions/<%= session.id %>/poll?since=' + lastId)
      .then(function (res) { return res.json(); })
      .then(function (data) { (data.messages || []).forEach(appendMessage); })
      .catch(function () {});
  }

  function markBubblesRead(bubbleClass) {
    var spans = messagesEl.querySelectorAll('.ai-chat-item.' + bubbleClass + ' .bubble-read.unread');
    spans.forEach(function (span) {
      span.textContent = '읽음';
      span.classList.remove('unread');
    });
  }

  if (window.EventSource) {
    var es = new EventSource('/chat/sessions/<%= session.id %>/stream');
    es.onopen = catchUp;
    es.onmessage = function (e) {
      try {
        var payload = JSON.parse(e.data);
        if (payload && payload.type === 'read_receipt') {
          markBubblesRead(payload.reader === 'agent' ? 'ai-user' : 'ai-agent');
          return;
        }
        appendMessage(payload);
      } catch (err) { /* noop */ }
    };
  }

  var replyForm = document.getElementById('agentReplyForm');
  var replyText = document.getElementById('agentReplyText');
  var replySendBtn = document.getElementById('agentReplySendBtn');
  var replyError = document.getElementById('agentReplyError');
  var assignedAgentLabel = document.getElementById('assignedAgentLabel');
  var returnToBotForm = document.getElementById('returnToBotForm');
  var isSendingReply = false;

  function setReplyError(text) {
    if (!text) { replyError.style.display = 'none'; replyError.textContent = ''; return; }
    replyError.textContent = text;
    replyError.style.display = '';
  }

  function sendAgentReply() {
    var text = replyText.value.trim();
    if (!text || isSendingReply) return;
    isSendingReply = true;
    replySendBtn.disabled = true;
    setReplyError('');

    fetch('/chat/sessions/<%= session.id %>/reply', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ text: text }),
    })
      .then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (data) {
          if (!res.ok) throw new Error(data.error || '메시지 전송에 실패했습니다. 잠시 후 다시 시도해주세요.');
          return data;
        });
      })
      .then(function (data) {
        if (data.message) appendMessage(data.message);
        if (assignedAgentLabel) assignedAgentLabel.textContent = currentUserName;
        if (returnToBotForm && data.status === 'agent_active') returnToBotForm.style.display = '';
        replyText.value = '';
      })
      .catch(function (err) {
        setReplyError((err && err.message) || '메시지 전송에 실패했습니다. 잠시 후 다시 시도해주세요.');
      })
      .finally(function () {
        isSendingReply = false;
        replySendBtn.disabled = false;
      });
  }

  if (replyForm) {
    replyForm.addEventListener('submit', function (e) {
      e.preventDefault();
      sendAgentReply();
    });
    replyText.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendAgentReply();
      }
    });
  }

})();
</script>

<%- include('../partials/footer') %>
