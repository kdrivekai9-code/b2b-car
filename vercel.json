{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{views,public}/**"
    }
  },
  "regions": [
    "icn1"
  ],
  "crons": [
    {
      "path": "/login",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/callmaner/sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/chat/cron/auto-send-suggestions",
      "schedule": "* * * * *"
    }
  ]
}